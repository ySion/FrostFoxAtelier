// Each timber axis is an independent two-vertex open polyline for Sweep.
struct game.BridgeAxes {
    Array<vector3> points;
    Array<uint> vertices;
    Array<uint> offsets;
};

void game.prepare_bridge_axes(game.BridgeAxes& axes, uint count) {
    axes.points.reserve(count * 2);
    axes.vertices.reserve(count * 2);
    axes.offsets.reserve(count + 1);
    axes.offsets.add(uint(0));
}

void game.add_bridge_axis(game.BridgeAxes& axes, vector3 a, vector3 b) {
    const uint start = axes.points.size();
    axes.points.add(a);
    axes.points.add(b);
    axes.vertices.add(start);
    axes.vertices.add(start + 1);
    axes.offsets.add(start + 2);
}

// Lift a 50 mm board perpendicular to this segment's slope so its lower face meets the deck.
void game.add_bridge_boards(game.BridgeAxes& boards, vector3 a, vector3 b, uint count) {
    const float length = b.x - a.x;
    const float slope = (b.y - a.y) / length;
    const float lift = 0.025f * math.sqrt(1.0f + slope * slope);
    const float pitch = length / float(count);
    for (uint i = 0; i < count; i += 1) {
        const float near = (float(i) + 0.02f) * pitch;
        const float far = (float(i) + 0.98f) * pitch;
        game.add_bridge_axis(boards, vector3(a.x + near, a.y + near * slope + lift, a.z),
                             vector3(a.x + far, a.y + far * slope + lift, a.z));
    }
}

[DESC = "用水平中心线站点构造直木桥。双边线与铺板跨过主跨及两端 1.5 米引板，连接固定高程的两岸。柱脚、扶手、逐跨斜撑、承梁和支桩仅布在主跨。"]
class game.FootbridgeLayout : procedural.Node {
    [Label = "Deck width (m)", Min = 0.6, Max = 4.0, LockMin, LockMax,
     DESC = "左右桥面边线间的总宽，单位米。铺板 Sweep 的截面宽度绑定同一参数。"]
    float width = 2.0f;

    [Label = "Deck rise (m)", Min = -0.5, Max = 1.5, LockMin, LockMax,
     DESC = "主跨从起点到终点的高差（米），起点在基准上方 1 米。两岸承板顶高固定为基准上方 1 米和 1.60 米，末端引板随高差变坡。"]
    float rise = 0.6f;

    void process(
        [In("P", Port = "stations", DESC = "主跨水平直线沿 +X 递增的有序点。用 Resample 按水平柱距布站，首尾是两端桥座；引板在站点之外生成。")] const Array<vector3>& stations,
        [Port, DESC = "左边线的有序纯点，Z 较小；沿 +X 依次经过起岸端点、全部主跨站点、对岸端点，接 RailPanel.rail_a。"] procedural.Geometry& left_edge,
        [Port, DESC = "与左边线逐站对应的右边线纯点，Z 较大，包含两处桥座折坡；接同一 RailPanel.rail_b，承板向下加厚 0.12 米。"] procedural.Geometry& right_edge,
        [Port, DESC = "每站左右各一个纯点，距板边 0.08 米、低于承板顶面 0.08 米。作为 Realize 的放置点，配底面为原点、高 1.08 米的竖柱原型。"] procedural.Geometry& post_feet,
        [Port, DESC = "左右扶手各一条二点开放折线，沿桥坡连接两端栏柱顶，供连续扶手 Sweep。"] procedural.Geometry& rail_axes,
        [Port, DESC = "每跨每侧一条二点开放折线，在相邻栏柱高出桥面 0.16 和 0.80 米处相接，逐跨交替朝向；供斜撑 Sweep。"] procedural.Geometry& brace_axes,
        [Port, DESC = "沿各段局部坡向 +X 的二点开放短线，两端引板各 8 块、主跨 30 块。矩形 Sweep 的 width 绑定桥宽、height 设 0.05 米、up 为 +Y。"] procedural.Geometry& plank_axes,
        [Port, DESC = "距主跨首尾各 2.5% 跨长的横向承梁轴，每根为沿 +Z 的二点开放折线；矩形 Sweep 高 0.16 米可托住 0.12 米厚承板。"] procedural.Geometry& bearing_axes,
        [Port, DESC = "四根支桩各一条竖直二点开放折线，从基线下 0.30 米到端部承梁底面；矩形 Sweep 可取 0.22 米方截面。"] procedural.Geometry& pile_axes) {
        const uint n = stations.size();
        // The two independent braces consume four vertices per main-span bay.
        if (n < 2 || n > 1073741824) { fail("FootbridgeLayout requires at least two stations within the geometry vertex limit."); }
        const float w = self.width;
        const float rise = self.rise;
        if (!(w >= 0.6f && w <= 4.0f && rise >= -0.5f && rise <= 1.5f)) {
            fail("FootbridgeLayout requires width in [0.6, 4] m and rise in [-0.5, 1.5] m.");
        }
        const vector3 start = stations[0];
        const vector3 end = stations[n - 1];
        const float length = end.x - start.x;
        if (!(math.is_finite(start) && math.is_finite(length) && length > 0.0f)) {
            fail("FootbridgeLayout requires a finite span along +X.");
        }
        for (uint i = 1; i < n; i += 1) {
            const vector3 p = stations[i];
            if (!(math.is_finite(p) && p.x > stations[i - 1].x && p.y == start.y && p.z == start.z)) {
                fail("FootbridgeLayout stations must advance along +X on a single horizontal centreline.");
            }
        }

        const float base_y = start.y + 1.0f;
        const vector3 near_seat = vector3(start.x, base_y, start.z);
        const vector3 far_seat = vector3(end.x, base_y + rise, start.z);
        const vector3 near_bank = vector3(start.x - 1.5f, base_y, start.z);
        const vector3 far_bank = vector3(end.x + 1.5f, start.y + 1.60f, start.z);
        if (!(near_bank.x < near_seat.x && far_seat.x < far_bank.x)) {
            fail("FootbridgeLayout approach spans must remain distinct at the station coordinates.");
        }
        const float half_w = w * 0.5f;
        const vector3 across = vector3(0.0f, 0.0f, half_w);
        const float guard_z = half_w - 0.08f;
        Array<vector3> left;
        Array<vector3> right;
        left.reserve(n + 2);
        right.reserve(n + 2);
        left.add(near_bank - across);
        right.add(near_bank + across);
        Array<vector3> post_origins;
        game.BridgeAxes rails;
        game.BridgeAxes braces;
        post_origins.reserve(n * 2);
        game.prepare_bridge_axes(rails, 2);
        game.prepare_bridge_axes(braces, (n - 1) * 2);
        vector3 previous = near_seat;
        for (uint i = 0; i < n; i += 1) {
            const float x = stations[i].x;
            const float y = base_y + rise * ((x - start.x) / length);
            const vector3 station = vector3(x, y, start.z);
            left.add(station - across);
            right.add(station + across);
            for (uint side = 0; side < 2; side += 1) {
                const float z = side == 0 ? start.z - guard_z : start.z + guard_z;
                post_origins.add(vector3(x, y - 0.08f, z));
                if (i > 0) {
                    const bool ascending = i % 2 == 1;
                    const float from_y = previous.y + (ascending ? 0.16f : 0.80f);
                    const float to_y = y + (ascending ? 0.80f : 0.16f);
                    game.add_bridge_axis(braces, vector3(previous.x, from_y, z), vector3(x, to_y, z));
                }
                if (i == n - 1) {
                    game.add_bridge_axis(rails, vector3(start.x, base_y + 1.0f, z), vector3(x, y + 1.0f, z));
                }
            }
            previous = station;
        }
        left.add(far_bank - across);
        right.add(far_bank + across);
        self.emit_points(left, 0);
        self.emit_points(right, 1);
        self.emit_points(post_origins, 2);
        self.emit_polylines(rails.points, rails.vertices, rails.offsets, 3);
        self.emit_polylines(braces.points, braces.vertices, braces.offsets, 4);

        const uint main_boards = 30;
        const uint approach_boards = 8;
        game.BridgeAxes boards;
        game.prepare_bridge_axes(boards, main_boards + 2 * approach_boards);
        game.add_bridge_boards(boards, near_bank, near_seat, approach_boards);
        game.add_bridge_boards(boards, near_seat, far_seat, main_boards);
        game.add_bridge_boards(boards, far_seat, far_bank, approach_boards);
        self.emit_polylines(boards.points, boards.vertices, boards.offsets, 5);

        game.BridgeAxes bearings;
        game.BridgeAxes piles;
        game.prepare_bridge_axes(bearings, 2);
        game.prepare_bridge_axes(piles, 4);
        for (uint i = 0; i < 2; i += 1) {
            const float t = i == 0 ? 0.025f : 0.975f;
            const float x = start.x + t * length;
            const float deck_y = base_y + t * rise;
            const float bearing_y = deck_y - 0.20f;
            game.add_bridge_axis(bearings, vector3(x, bearing_y, start.z - half_w),
                                 vector3(x, bearing_y, start.z + half_w));
            for (uint side = 0; side < 2; side += 1) {
                const float inset = half_w - 0.16f;
                const float z = side == 0 ? start.z - inset : start.z + inset;
                game.add_bridge_axis(piles, vector3(x, start.y - 0.30f, z), vector3(x, deck_y - 0.28f, z));
            }
        }
        self.emit_polylines(bearings.points, bearings.vertices, bearings.offsets, 6);
        self.emit_polylines(piles.points, piles.vertices, piles.offsets, 7);
    }
}
