[DESC = "将 Resample 已排匀的柱位放到基座上。校验柱脚净距，局部 +Z 沿导线切向，输出原导线的绝对桩号。"]
class game.BalusterFeet : procedural.Node {
    void process(
        [In("P", Port = "stations", DESC = "接保留两端的 fit_spacing Resample。每一站放一根栏柱。")] const Array<vector3>& P,
        [In("arclength", Port = "stations")] const Array<float>& s,
        [In("tangent", Port = "stations")] const Array<vector3>& tangents,
        [In("arclength", Port = "span", DESC = "接布柱用的 SliceCurve。第一站的源线里程给出起点留量。")] const Array<float>& span,
        [Port, DESC = "Realize 的柱脚放置点。局部 +Z 顺着曲线、+Y 竖直，arclength 从完整导线的起点量起。"] procedural.Geometry& feet) {
        const uint n = P.size();
        if (n < 2 || span.size() < 2 || s[0] != 0.0f || !math.is_finite(span[0])) {
            fail("BalusterFeet needs an open post span and stations measured from its start.");
        }
        Array<vector3> origins;
        Array<quaternion> frames;
        Array<float> marks;
        const vector3 up = vector3(0.0f, 1.0f, 0.0f);
        for (uint i = 0; i < n; i += 1) {
            if (!math.is_finite(s[i]) || (i > 0 && s[i] - s[i - 1] < 0.33f)) {
                fail("BalusterFeet needs finite stations with room for a 0.33 m foot.");
            }
            if (!math.is_finite(tangents[i]) || math.abs(tangents[i].y) > 0.0001f ||
                math.abs(math.dot(tangents[i], tangents[i]) - 1.0f) > 0.001f) {
                fail("BalusterFeet requires horizontal unit tangents.");
            }
            origins.add(P[i] + up * 1.22f);
            frames.add(procedural.align_to_normal(tangents[i], up));
            marks.add(span[0] + s[i]);
        }
        self.emit_points(origins, 0);
        self.set_quat("orient", procedural.Layer::point, frames, 0);
        self.set_float("arclength", procedural.Layer::point, marks, 0);
    }
};

struct game.StonePaths {
    Array<vector3> p;
    Array<uint> corners;
    Array<uint> offsets;
};

void game.stone_point(game.StonePaths& path, vector3 p) {
    path.corners.add(path.p.size());
    path.p.add(p);
}

void game.stone_break(game.StonePaths& path) {
    path.offsets.add(path.corners.size());
}

struct game.StoneCuts {
    Array<vector2> intervals;
    Array<float> elevations;
};

void game.ashlar_course(game.StoneCuts& cuts, float length, uint blocks, bool stagger, float height, float joint) {
    const uint pieces = stagger ? blocks + 1 : blocks;
    const float phase = stagger ? 0.5f : 0.0f;
    for (uint j = 0; j < pieces; j += 1) {
        const float start = j == 0 ? 0.0f : length * ((float(j) - phase) / float(blocks)) + joint * 0.5f;
        const float end = j + 1 == pieces ? length : length * ((float(j + 1) - phase) / float(blocks)) - joint * 0.5f;
        cuts.intervals.add(vector2(start, end));
        cuts.elevations.add(height);
    }
}

void game.lift_stones(game.StonePaths& paths, const Array<vector3>& points, const Array<uint>& offsets,
                      const Array<float>& heights, uint first, uint end) {
    paths.offsets.add(uint(0));
    for (uint i = first; i < end; i += 1) {
        const vector3 lift = vector3(0.0f, heights[i], 0.0f);
        for (uint v = offsets[i]; v < offsets[i + 1]; v += 1) {
            if (math.abs(points[v].y - points[0].y) > 0.0001f) { fail("Stone courses require a horizontal guide."); }
            game.stone_point(paths, points[v] + lift);
        }
        game.stone_break(paths);
    }
}

[DESC = "在同一水平导线上排四皮错缝墙石、压顶石和灰芯。石缝定下每块的起止桩号，公共弧长截段保留切口之间的原弯道。"]
class game.BalustradeCourses : procedural.Node {
    void process(
        [Port, DESC = "一条有向水平开放折线。墙石、压顶和灰芯从这条原线截取。"] const procedural.Geometry& guide,
        [In("arclength", Port = "guide_end", DESC = "接同一导线的 SampleCurve，从末端量 0 米，提供全长。")] const Array<float>& s,
        [Port, DESC = "四皮石墙，每块一条开放折线，交替半块错缝，竖缝宽 0.016 米。接墙石 Sweep.backbone。"] procedural.Geometry& courses,
        [Port, DESC = "一皮压顶石，每块一条弧线，竖缝宽 0.012 米。接压顶石 Sweep.backbone。"] procedural.Geometry& coping,
        [Port, DESC = "连续灰芯轴线，首尾各内退 0.018 米。"] procedural.Geometry& bedding) {
        if (s.size() != 1) { fail("BalustradeCourses needs the end station of a single guide."); }
        const float length = s[0];
        if (!math.is_finite(length) || length < 0.77f || length / 0.64f >= 16777216.0f) {
            fail("Arc length is outside the stone course range.");
        }
        const uint blocks = uint(math.max(1.0f, math.floor(length / 0.64f + 0.5f)));
        const uint caps = uint(math.max(1.0f, math.floor(length / 0.96f + 0.5f)));
        game.StoneCuts cuts;
        for (uint row = 0; row < 4; row += 1) {
            game.ashlar_course(cuts, length, blocks, row % 2 == 1, (float(row) + 0.5f) * 0.26f, 0.016f);
        }
        const uint wall_end = cuts.intervals.size();
        game.ashlar_course(cuts, length, caps, false, 1.13f, 0.012f);
        const uint sill_end = cuts.intervals.size();
        cuts.intervals.add(vector2(0.018f, length - 0.018f));
        cuts.elevations.add(0.6025f);
        Array<vector3> points;
        Array<uint> offsets;
        self.read_curve_slices(guide, 0, cuts.intervals, points, offsets);

        game.StonePaths wall;
        game.StonePaths sill;
        game.StonePaths core;
        game.lift_stones(wall, points, offsets, cuts.elevations, 0, wall_end);
        game.lift_stones(sill, points, offsets, cuts.elevations, wall_end, sill_end);
        game.lift_stones(core, points, offsets, cuts.elevations, sill_end, sill_end + 1);
        self.emit_polylines(wall.p, wall.corners, wall.offsets, 0);
        self.emit_polylines(sill.p, sill.corners, sill.offsets, 1);
        self.emit_polylines(core.p, core.corners, core.offsets, 2);
    }
};

void game.turning_station(game.StonePaths& line, Array<float>& radii, float y, float radius) {
    game.stone_point(line, vector3(0.0f, y, 0.0f));
    radii.add(radius);
}

void game.eased_section(game.StonePaths& section, float width, float height, float lower, float upper) {
    const float w = width * 0.5f;
    const float h = height * 0.5f;
    section.offsets.add(uint(0));
    game.stone_point(section, vector3(-w + lower, -h, 0.0f));
    game.stone_point(section, vector3( w - lower, -h, 0.0f));
    game.stone_point(section, vector3( w, -h + lower, 0.0f));
    game.stone_point(section, vector3( w,  h - upper, 0.0f));
    game.stone_point(section, vector3( w - upper, h, 0.0f));
    game.stone_point(section, vector3(-w + upper, h, 0.0f));
    game.stone_point(section, vector3(-w, h - upper, 0.0f));
    game.stone_point(section, vector3(-w, -h + lower, 0.0f));
    game.stone_break(section);
}

[DESC = "本例的石工样板：栏柱的车削母线尺寸和三个局部 XY 闭合截面，交给 Sweep 生成几何。"]
class game.BalustradeProfiles : procedural.Node {
    void process(
        [Port, DESC = "局部竖直开放轴线，point float shaft_scale 为逐站半径与 1 米的比值。接 tube Sweep.backbone，radius=1、scale_attribute=shaft_scale。"] procedural.Geometry& spindle_axis,
        [Port, DESC = "墙石的 XY 倒棱截面，宽 0.54 米，高 0.248 米。接 custom Sweep.cross_section。"] procedural.Geometry& ashlar,
        [Port, DESC = "基座压顶石的 XY 截面，宽 0.66 米，高 0.18 米。"] procedural.Geometry& coping,
        [Port, DESC = "连续扶手的 XY 截面，底窄顶冠略收，宽 0.52 米，高 0.18 米。"] procedural.Geometry& handrail) {
        game.StonePaths turning;
        Array<float> radius;
        turning.offsets.add(uint(0));
        game.turning_station(turning, radius, 0.100f, 0.130f);
        game.turning_station(turning, radius, 0.114f, 0.147f);
        game.turning_station(turning, radius, 0.132f, 0.150f);
        game.turning_station(turning, radius, 0.148f, 0.138f);
        game.turning_station(turning, radius, 0.161f, 0.105f);
        game.turning_station(turning, radius, 0.183f, 0.094f);
        game.turning_station(turning, radius, 0.208f, 0.087f);
        game.turning_station(turning, radius, 0.230f, 0.092f);
        game.turning_station(turning, radius, 0.254f, 0.106f);
        game.turning_station(turning, radius, 0.289f, 0.128f);
        game.turning_station(turning, radius, 0.326f, 0.145f);
        game.turning_station(turning, radius, 0.365f, 0.155f);
        game.turning_station(turning, radius, 0.406f, 0.160f);
        game.turning_station(turning, radius, 0.444f, 0.157f);
        game.turning_station(turning, radius, 0.492f, 0.147f);
        game.turning_station(turning, radius, 0.542f, 0.132f);
        game.turning_station(turning, radius, 0.592f, 0.112f);
        game.turning_station(turning, radius, 0.641f, 0.095f);
        game.turning_station(turning, radius, 0.687f, 0.081f);
        game.turning_station(turning, radius, 0.721f, 0.076f);
        game.turning_station(turning, radius, 0.740f, 0.081f);
        game.turning_station(turning, radius, 0.752f, 0.104f);
        game.turning_station(turning, radius, 0.763f, 0.119f);
        game.turning_station(turning, radius, 0.779f, 0.122f);
        game.turning_station(turning, radius, 0.790f, 0.115f);
        game.turning_station(turning, radius, 0.802f, 0.094f);
        game.turning_station(turning, radius, 0.822f, 0.099f);
        game.turning_station(turning, radius, 0.840f, 0.128f);
        game.stone_break(turning);
        self.emit_polylines(turning.p, turning.corners, turning.offsets, 0);
        self.set_float("shaft_scale", procedural.Layer::point, radius, 0);

        game.StonePaths block_section;
        game.StonePaths sill_section;
        game.eased_section(block_section, 0.54f, 0.248f, 0.012f, 0.012f);
        game.eased_section(sill_section, 0.66f, 0.18f, 0.034f, 0.018f);
        self.emit_polygons(block_section.p, block_section.corners, block_section.offsets, 1);
        self.emit_polygons(sill_section.p, sill_section.corners, sill_section.offsets, 2);

        game.StonePaths crown;
        crown.offsets.add(uint(0));
        game.stone_point(crown, vector3(-0.207f, -0.090f, 0.0f));
        game.stone_point(crown, vector3(0.207f, -0.090f, 0.0f));
        game.stone_point(crown, vector3(0.256f, -0.045f, 0.0f));
        game.stone_point(crown, vector3(0.260f, 0.037f, 0.0f));
        game.stone_point(crown, vector3(0.238f, 0.072f, 0.0f));
        game.stone_point(crown, vector3(0.170f, 0.090f, 0.0f));
        game.stone_point(crown, vector3(-0.170f, 0.090f, 0.0f));
        game.stone_point(crown, vector3(-0.238f, 0.072f, 0.0f));
        game.stone_point(crown, vector3(-0.260f, 0.037f, 0.0f));
        game.stone_point(crown, vector3(-0.256f, -0.045f, 0.0f));
        game.stone_break(crown);
        self.emit_polygons(crown.p, crown.corners, crown.offsets, 3);
    }
};
