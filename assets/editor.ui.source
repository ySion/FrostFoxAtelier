double choose(bool condition, double yes, double no) {
    if (condition) { return yes; }
    return no;
}
double shelf_expanded_height() { return 56.0d; }

double rail_button_length(double extent) {
    if (extent < 108.0d) { return extent / 3.0d; }
    return 36.0d;
}
double rail_button_thickness(double extent) {
    if (extent < 4.0d / 3.0d) { return 0.0d; }
    return extent - 4.0d / 3.0d;
}
double rail_button_width(bool vertical, double width, double height) {
    return choose(vertical, rail_button_length(width), rail_button_thickness(width));
}
double rail_button_height(bool vertical, double width, double height) {
    return choose(vertical, rail_button_thickness(height), rail_button_length(height));
}

ui Position(in bool matches, in EditBinding position, in EditBinding rotation, in EditBinding scale,
            in bool show_position, in bool show_rotation, in bool show_scale,
            in TooltipBinding position_help, in TooltipBinding rotation_help, in TooltipBinding scale_help) {
    state bool expanded = true;
    Foldout section {
        text: "Scene root content";
        height: 24;
        classes: "section";
        selected: state.expanded;
        collapsed: !input.matches;
        on activate { state.expanded = event.checked; }
    }
    Column contents {
        gap: 5;
        classes: "section-body";
        collapsed: !state.expanded || !input.matches;
        NumberRow position {
            text: "Position (m)";
            tooltip: input.position_help;
            edit: input.position;
            collapsed: !input.show_position;
        }
        NumberRow rotation { text: "Rotation (°)"; edit: input.rotation; tooltip: input.rotation_help; collapsed: !input.show_rotation; }
        NumberRow scale { text: "Scale"; edit: input.scale; tooltip: input.scale_help; collapsed: !input.show_scale; }
    }
}

ui QueryRow(in TextEditBinding edit, in double label_width, in double gap, in bool caption) {  // Slint, QML, React
    Row row {
        single_line: true;
        align_center: true;
        gap: input.gap;
        Text label {
            text: "Filter";
            width: input.label_width;
            single_line: true;
            caption: input.caption;
            classes: "field-label";
        }
        TextField field { edit: input.edit; }
    }
}

ui NumericProperty(in Text title, in EditBinding edit, in bool swatch, in double r, in double g, in double b, in ActionBinding pick) {
    // Houdini colour tuples end with a live swatch of the current value; clicking it opens the colour editor.
    Row row { align_center: true; gap: 4;
        Column fields { expand_width: true; NumberRow number { text: input.title; edit: input.edit; } }
        Button swatch { text: ""; action: input.pick; width: 23; height: 21; collapsed: !input.swatch; red: input.r; green: input.g; blue: input.b; classes: "color-swatch parameter-swatch"; }
    }
}

ui BooleanProperty(in Text title, in bool checked, in bool enabled, in ActionBinding change) {
    ParameterRow row { text: "";
        Checkbox toggle { text: input.title; selected: input.checked; enabled: input.enabled; action: input.change; height: 26.667; content_width: 0; }
    }
}

ui EnumProperty(in Text title, in Text choice, in bool enabled, in Key target) {
    // Houdini menu buttons hug their label (e.g. "Scale Rot Trans") instead of
    // spanning the row; a minimum keeps short choices clickable.
    ParameterRow row { text: input.title;
        Combo choice { text: input.choice; context: input.target; enabled: input.enabled; height: 26.667; content_width: 0; min_width: 96;
            classes: "parameter-menu"; }
    }
}

ui PropertyRow(in Text title, in EditBinding edit, in bool boolean, in bool checked, in bool enabled,
               in ActionBinding change, in bool enumeration, in Text choice, in Key target,
               in bool swatch, in double r, in double g, in double b,
               in bool override_available, in bool overridden, in ActionBinding inherit, in TooltipBinding help, in ActionBinding pick) {
    Row row { gap: 3; tooltip: input.help;
        Column override_area { collapsed: !input.override_available; width: 24;
            Checkbox override { text: ""; selected: input.overridden; action: input.inherit; width: 24; height: 23; }
        }
        Column value { expand_width: true;
        NumericProperty numeric { mounted: !input.boolean && !input.enumeration; title: input.title; edit: input.edit;
            swatch: input.swatch; r: input.r; g: input.g; b: input.b; pick: input.pick; }
        BooleanProperty boolean { mounted: input.boolean; title: input.title; checked: input.checked; enabled: input.enabled; change: input.change; }
        EnumProperty enumeration { mounted: input.enumeration; title: input.title; choice: input.choice; enabled: input.enabled; target: input.target; }
        }
    }
}

ui PropertyGroup(in Text title, in double icon, in Items<PropertyRow> properties) {
    state bool expanded = true;
    Column component {
        Foldout title { text: input.title; selected: state.expanded; height: 24; classes: "section";
            on activate { state.expanded = event.checked; }
        }
        Column properties { gap: 5; collapsed: !state.expanded; classes: "section-body"; Repeat rows { items: input.properties; } }
    }
}

ui EntityRow(in Text title, in bool enabled, in bool selected, in double icon,
            in TreeRowBinding row, in Text style, in bool draggable, in Key menu) {
    TreeItem row {
        draggable: input.draggable;
        context: input.menu;
        text: input.title;
        enabled: input.enabled;
        selected: input.selected;
        icon: input.icon;
        row: input.row;
        classes: input.style;
    }
}

ui SceneTree(in Items<EntityRow> entities, in double rows, in TextEditBinding filter,
             in bool world_selected, in TreeRowBinding world_row, in double world_icon,
             in ActionBinding back, in ActionBinding forward, in double back_icon, in double forward_icon, in double path_icon,
             in Text world_style) {
    PanePath path { title: "World"; back: input.back; forward: input.forward; back_icon: input.back_icon; forward_icon: input.forward_icon; path_icon: input.path_icon; }
    Tree tree {
        expand_height: true;
        rows: input.rows;
        TreeItem world {
            text: "World";
            icon: input.world_icon;
            selected: input.world_selected;
            row: input.world_row;
            classes: input.world_style;
        }
        Repeat rows { items: input.entities; }
    }
    Column filter_area {
        padding_left: 6;
        padding_top: 3;
        padding_right: 4;
        padding_bottom: 3;
        QueryRow query { edit: input.filter; label_width: 36; gap: 6; caption: false; }
    }
}

ui ShelfTool(in Text title, in double icon, in ActionBinding action) {
    Button tool {
        text: input.title;
        icon: input.icon;
        action: input.action;
        classes: "shelf-tool";
        width: 64;
        expand_height: true;
    }
}

ui ToolShelf(in bool collapsed, in bool create_selected,
             in Items<ShelfTool> create_tools, in Items<ShelfTool> view_tools,
             in ActionBinding toggle, in ActionBinding create, in ActionBinding view,
             in double rail_width, in double closed_height, in double arrow_height,
             in double up_icon, in double down_icon) {
    Row shelf {
        classes: "tool-shelf";
        height: choose(input.collapsed, input.closed_height, shelf_expanded_height());
        ToggleButton stow {
            classes: "bar-stow";
            expand_width: input.collapsed;
            min_width: input.rail_width;
            expand_height: true;
            padding_bottom: choose(input.collapsed, 0.0d, shelf_expanded_height() - input.arrow_height);
            icon: choose(input.collapsed, input.down_icon, input.up_icon);
            selected: input.collapsed;
            action: input.toggle;
        }
        Column contents {
            expand_height: true;
            collapsed: input.collapsed;
            Row tabs {
                classes: "section-tabs shelf-tabs";
                content_height: 18;
                padding_bottom: 2.0d / 3.0d;
                wrap: true;
                ChoiceButton create {
                    text: "Create";
                    classes: "section-tab shelf-tab";
                    height: 17.0d + 1.0d / 3.0d;
                    selected: input.create_selected;
                    selection_group: node.tabs;
                    action: input.create;
                }
                ChoiceButton view {
                    text: "View";
                    classes: "section-tab joined shelf-tab";
                    height: 17.0d + 1.0d / 3.0d;
                    selected: !input.create_selected;
                    selection_group: node.tabs;
                    action: input.view;
                }
            }
            Column body {
                expand_height: true;
                padding_left: 2;
                padding_right: 2;
                padding_top: 1;
                padding_bottom: 1;
                Row create_tools {
                    expand_height: true;
                    collapsed: !input.create_selected;
                    Repeat buttons { items: input.create_tools; }
                }
                Row view_tools {
                    expand_height: true;
                    collapsed: input.create_selected;
                    Repeat view_buttons { items: input.view_tools; }
                }
            }
        }
    }
}

ui PanePath(in Text title, in ActionBinding back, in ActionBinding forward,
            in double back_icon, in double forward_icon, in double path_icon) {
    Row bar {
        classes: "path-bar";
        align_center: true;
        gap: 2;
        height: 32;
        padding_left: 4;
        padding_top: 4;
        padding_right: 4;
        padding_bottom: 4;
        Button back { icon: input.back_icon; action: input.back; width: 22; height: 24; classes: "path-navigation"; }
        Button forward { icon: input.forward_icon; action: input.forward; width: 22; height: 24; classes: "path-navigation"; }
        Combo path { text: input.title; icon: input.path_icon; expand_width: true; min_width: 32; height: 24; classes: "pane-path"; }
    }
}

ui EntityStructure(in Text title, in Items<EntityRow> objects, in double rows, in TextEditBinding filter, in bool has_entity,
                  in bool editable, in Key add_component, in ActionBinding remove, in double remove_icon) {
    Row toolbar {
        height: 32; align_center: true; gap: 4; padding_left: 6; padding_right: 4; classes: "object-header";
        Text title { text: input.title; expand_width: true; single_line: true; }
        Combo add { text: "Add Component"; context: input.add_component; enabled: input.editable; height: 24; content_width: 0; classes: "parameter-menu"; }
        Button remove { icon: input.remove_icon; action: input.remove; width: 24; height: 24; classes: "browser-icon"; }
    }
    Tree tree { expand_height: true; rows: input.rows; Repeat rows { items: input.objects; } }
    Text empty { text: "Select an Entity in Scene Tree."; collapsed: input.has_entity; single_line: true; caption: true; classes: "empty-state"; }
    Column filter_area { padding_left: 6; padding_right: 4; padding_top: 3; padding_bottom: 3;
        QueryRow query { edit: input.filter; label_width: 36; gap: 6; caption: false; }
    }
}

ui Parameters(in Text type_name, in TextEditBinding name,
              in ActionBinding back, in ActionBinding forward,
              in double back_icon, in double forward_icon, in double path_icon,
              in bool has_selection, in Items<PropertyGroup> groups, in bool matches,
              in EditBinding position, in TextEditBinding filter, in bool empty,
              in double type_icon, in double search_icon, in bool search_visible, in ActionBinding search,
              in EditBinding rotation, in EditBinding scale, in bool show_position, in bool show_rotation, in bool show_scale,
              in bool by_category, in ActionBinding components, in ActionBinding categories,
              in TooltipBinding position_help, in TooltipBinding rotation_help, in TooltipBinding scale_help,
              in TooltipBinding type_help) {
    Column pane {
        classes: "parameter-pane"; panel: true; expand_height: true;
        PanePath path { title: "World"; back: input.back; forward: input.forward;
            back_icon: input.back_icon; forward_icon: input.forward_icon; path_icon: input.path_icon;
        }
        // Houdini's parameter header: type, name, grouping tabs and search on one line.
        Row header {
            classes: "object-header"; height: 32; gap: 4; align_center: true; padding_left: 6; padding_right: 4;
            Text type { text: input.type_name; icon: input.type_icon; content_width: 0; single_line: true; classes: "object-type"; tooltip: input.type_help; }
            TextField name { edit: input.name; context: input.name; min_width: 32; classes: "object-name"; }
            Row grouping { gap: 0; align_center: true; content_width: 0; collapsed: !input.has_selection;
                ChoiceButton components { text: "Object"; action: input.components; selected: !input.by_category; selection_group: node.grouping; height: 22; classes: "section-tab header-tab"; }
                ChoiceButton categories { text: "Category"; action: input.categories; selected: input.by_category; selection_group: node.grouping; height: 22; classes: "section-tab header-tab joined"; }
            }
            ToggleButton search_toggle { icon: input.search_icon; width: 24; height: 24; selected: input.search_visible; action: input.search; classes: "parameter-tool"; }
        }
        Column search { classes: "parameter-search"; collapsed: !input.has_selection || !input.search_visible;
            QueryRow query { edit: input.filter; label_width: 48; gap: 4; caption: true; }
        }
        Text no_selection { text: "Select an object to inspect its properties."; classes: "empty-state";
            caption: true; single_line: true; collapsed: input.has_selection;
        }
        List scroll {
            classes: "parameter-list"; expand_height: true; gap: 1;
            collapsed: !input.has_selection;
            Column transform { collapsed: !input.matches;
                Position position { mounted: input.matches; matches: input.matches; position: input.position;
                    rotation: input.rotation; scale: input.scale; show_position: input.show_position;
                    show_rotation: input.show_rotation; show_scale: input.show_scale;
                    position_help: input.position_help; rotation_help: input.rotation_help; scale_help: input.scale_help; }
            }
            Column properties { gap: 1; Repeat groups { items: input.groups; } }
            Text empty { text: "No matching parameters"; classes: "empty-state"; single_line: true; caption: true; collapsed: !input.empty; }
        }
    }
}

ui ResourceProperty(in Text title, in Text value) {
    ParameterRow row { text: input.title;
        Row value_area { height: 23; expand_width: true; align_center: true;
            Text value { text: input.value; expand_width: true; single_line: true; classes: "resource-value"; }
        }
    }
}
ui WorldPanel(in Text selected_volume, in Items<PropertyGroup> volume,
              in Items<PropertyGroup> propagation, in Items<ResourceProperty> actual, in Text configured,
              in Items<PropertyGroup> lighting, in Items<PropertyGroup> effects, in Items<PropertyGroup> diagnostics,
              in bool editable, in TableBinding performance, in Text performance_status, in Text performance_resources) {
    state double page = 0.0d;
    state bool show_actual = true;
    Column pane { expand_height: true; panel: true; classes: "parameter-pane";
        Row tabs { height: 26.667; padding_bottom: 0.667; classes: "section-tabs";
            ChoiceButton lighting_tab { text: "Lighting"; height: 26; selected: state.page == 0.0d; selection_group: node.tabs; classes: "section-tab"; on activate { state.page = 0.0d; } }
            ChoiceButton ddgi_tab { text: "DDGI"; height: 26; selected: state.page == 1.0d; selection_group: node.tabs; classes: "section-tab joined"; on activate { state.page = 1.0d; } }
            ChoiceButton effects_tab { text: "Effects"; height: 26; selected: state.page == 2.0d; selection_group: node.tabs; classes: "section-tab joined"; on activate { state.page = 2.0d; } }
            ChoiceButton diagnostics_tab { text: "Diagnostics"; height: 26; selected: state.page == 3.0d; selection_group: node.tabs; classes: "section-tab joined"; on activate { state.page = 3.0d; } }
            ChoiceButton performance_tab { text: "Performance"; height: 26; selected: state.page == 4.0d; selection_group: node.tabs; classes: "section-tab joined"; on activate { state.page = 4.0d; } }
        }
        Row header { height: 28; align_center: true; gap: 5; padding_left: 6; padding_right: 6; collapsed: state.page != 1.0d && state.page != 3.0d;
            Combo slot { text: input.selected_volume; height: 26.667; min_width: 100; classes: "parameter-menu"; }
            Column space { expand_width: true; }
            Combo setup { text: "Coverage"; enabled: input.editable; height: 26.667; content_width: 0; min_width: 88; classes: "parameter-menu"; collapsed: state.page != 1.0d; }
        }
        List scroll { expand_height: true; gap: 1; collapsed: state.page == 4.0d; classes: "parameter-list";
            Column lighting { gap: 1; collapsed: state.page != 0.0d; Repeat lighting_settings { items: input.lighting; } }
            Column ddgi { gap: 1; collapsed: state.page != 1.0d; Repeat volume { items: input.volume; } Repeat propagation { items: input.propagation; } }
            Column effects { gap: 1; collapsed: state.page != 2.0d; Repeat effect_settings { items: input.effects; } }
            Column diagnostics { gap: 1; collapsed: state.page != 3.0d;
                Repeat diagnostic_settings { items: input.diagnostics; }
                Foldout actual_title { text: "Current layout (CPU)"; selected: state.show_actual; height: 24; classes: "section";
                    on activate { state.show_actual = event.checked; }
                }
                Column actual { gap: 1; collapsed: !state.show_actual; classes: "section-body"; Repeat rows { items: input.actual; } }
            }
        }
        Column performance { expand_height: true; collapsed: state.page != 4.0d;
            Row performance_header { height: 26; padding_left: 6; align_center: true;
                Text performance_status { text: input.performance_status; single_line: true; expand_width: true; }
            }
            Table performance_table { model: input.performance; expand_height: true; view: "details";
                row_height: 23; header_height: 25; classes: "asset-table";
            }
            Row performance_memory { height: 24; padding_left: 6; align_center: true;
                Text performance_resources { text: input.performance_resources; single_line: true; expand_width: true; }
            }
            Row performance_note { height: 24; padding_left: 6; align_center: true;
                Text performance_scope { text: "Scene Lit GPU only · subpasses included in parents"; single_line: true; expand_width: true; }
            }
        }
        Row footer { height: 23; padding_left: 6; align_center: true; collapsed: state.page != 1.0d && state.page != 3.0d;
            Text count { text: input.configured; single_line: true; expand_width: true; }
        }
    }
}

ui ResourceParameters(in Text kind, in Text name, in double icon, in Items<ResourceProperty> properties) {
    Column pane { expand_height: true; panel: true; classes: "parameter-pane";
        Row header { height: 32; align_center: true; gap: 4; padding_left: 6; classes: "object-header";
            Text icon { icon: input.icon; width: 22; height: 24; }
            Text kind { text: input.kind; single_line: true; }
            Text name { text: input.name; expand_width: true; single_line: true; }
        }
        List properties { expand_height: true; gap: 5; classes: "parameter-list section-body";
            Repeat rows { items: input.properties; }
        }
    }
}
ui MaterialParameters(in Text name, in bool dirty, in Items<PropertyGroup> groups, in bool search_visible,
                      in TextEditBinding query, in ActionBinding search, in double search_icon) {
    Column pane { expand_height: true; panel: true; classes: "parameter-pane";
        Row header { height: 32; align_center: true; gap: 4; padding_left: 6; padding_right: 4; classes: "object-header";
            Text kind { text: "Material"; single_line: true; }
            Text name { text: input.name; expand_width: true; single_line: true; }
            Column dirty_area { collapsed: !input.dirty; width: 16; Text dirty { text: "*"; single_line: true; } }
            ToggleButton search { icon: input.search_icon; selected: input.search_visible; action: input.search; width: 24; height: 24; classes: "parameter-tool"; }
        }
        Row filter { collapsed: !input.search_visible; height: 26; TextField query_field { edit: input.query; expand_width: true; } }
        List properties { expand_height: true; gap: 1; classes: "parameter-list";
            Repeat groups { items: input.groups; }
        }
    }
}
ui AssetBrowserShell(in Items<EntityRow> directories, in double directory_rows, in TextEditBinding query,
                     in Text path, in Text status,
                     in ActionBinding back, in ActionBinding up, in ActionBinding clear,
                     in bool filter_selected, in double view_icon,
                     in double back_icon, in double up_icon, in double search_icon,
                     in double clear_icon, in double filter_icon, in double more_icon,
                     in double directory_width, in double directory_limit) {
    Row toolbar {
        classes: "browser-toolbar";
        height: 32;
        gap: 2;
        wrap: false;
        align_center: true;
        padding_left: 4;
        padding_right: 4;
        Button back {
            icon: input.back_icon;
            action: input.back;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Button up {
            icon: input.up_icon;
            action: input.up;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Combo path {
            text: input.path;
            context: node.path;
            expand_width: true;
            min_width: 32;
            classes: "browser-path";
        }
        Row search_area {
            expand_width: true;
            min_width: 44;
            classes: "browser-search";
            Text search_icon {
                icon: input.search_icon;
                width: 18;
                height: 23;
                classes: "browser-search-icon";
            }
            TextField query {
                edit: input.query;
                min_width: 8;
                classes: "browser-search-input";
            }
            Button clear {
                icon: input.clear_icon;
                action: input.clear;
                width: 18;
                classes: "browser-tool browser-icon";
            }
        }
        Combo filter {
            icon: input.filter_icon;
            selected: input.filter_selected;
            context: node.filter;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Combo view {
            icon: input.view_icon;
            context: node.view;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Combo actions {
            icon: input.more_icon;
            context: node.actions;
            width: 23;
            classes: "browser-tool browser-icon";
        }
    }
    Row body {
        gap: 0;
        wrap: false;
        expand_height: true;
        Tree tree {
            classes: "browser-directories";
            shrink_width: input.directory_width;
            min_width: 96;
            expand_height: true;
            rows: input.directory_rows;
            Repeat directories { items: input.directories; }
        }
        Splitter divider {
            width: 5; expand_height: true; vertical: false;
            value: input.directory_width; minimum: 96; maximum: input.directory_limit; step: 1;
            classes: "dock-divider vertical browser-divider";
        }
        Column content {
            min_width: 64;
            expand_height: true;
        }
    }
    Text status {
        text: input.status;
        height: 20;
        padding_left: 6;
        padding_right: 6;
        caption: true;
        classes: "browser-status";
    }
}

ui AssetResults(in TableBinding model, in ActionBinding open, in Key context, in Text view, in Text empty) {
    Table results {
        model: input.model;
        action: input.open;
        context: input.context;
        view: input.view;
        empty_text: input.empty;
        row_height: 23;
        header_height: 25;
        tile_width: 90;
        tile_height: 66;
        item_gap: 2;
        classes: "asset-table";
        expand_height: true;
        min_width: 64;
        padding_left: 0;
    }
}

ui MenuTitle(in Text title, in bool selected, in Key target) {
    Button title { text: input.title; selected: input.selected; context: input.target; content_width: 38; expand_height: true; classes: "menubar-item"; }
}
ui EditorShell(in bool menu_collapsed, in Items<MenuTitle> menus, in Text status,
               in ActionBinding toggle, in double rail_width, in double closed_height, in double arrow_height,
               in double up_icon, in double down_icon, in Text facts, in bool play_diverged, in ActionBinding restart_play) {
    Column root {
        expand_height: true;
        Row menubar {
            classes: "menubar";
            height: choose(input.menu_collapsed, input.closed_height, 32.0d);
            ToggleButton stow {
                classes: "bar-stow"; expand_width: input.menu_collapsed; min_width: input.rail_width;
                expand_height: true; padding_bottom: choose(input.menu_collapsed, 0.0d, 32.0d - input.arrow_height);
                icon: choose(input.menu_collapsed, input.down_icon, input.up_icon);
                selected: input.menu_collapsed; action: input.toggle;
            }
            Row menu_body {
                expand_height: true; padding_top: 1; padding_bottom: 1; collapsed: input.menu_collapsed;
                Repeat titles { items: input.menus; }
            }
        }
        Column shelf_slot { }
        Column workspace { expand_height: true; }
        Row footer {
            height: 23; padding_left: 8; padding_right: 8; align_center: true; gap: 18; classes: "status-bar";
            Text status { text: input.status; single_line: true; caption: true; content_width: 0; classes: "status-text"; }
            Button restart { text: "Restart Play"; action: input.restart_play; collapsed: !input.play_diverged; height: 19; content_width: 0; min_width: 88; }
            Column spacer { expand_width: true; height: 1; }
            Text facts { text: input.facts; single_line: true; caption: true; content_width: 0; classes: "status-text status-facts"; }
        }
    }
}
// Houdini rail cells are 32 DIP squares; a hairline groups selection apart
// from the handle tools (measured: #4d4d4d over #3a3a3a, 8 DIP breathing room).
ui ViewportMode(in ActionBinding choose, in double icon, in bool selected, in Key group, in Text style) {
    // Selection-group buttons stay direct children of the rail; the group gap is
    // drawn as a top border on the first handle tool instead of a wrapper.
    ChoiceButton mode { icon: input.icon; action: input.choose; selected: input.selected;
        selection_group: input.group; width: 32; height: 32; classes: input.style; }
}
// One toggle of Houdini's right-hand display bar.
ui DisplayToggle(in ActionBinding toggle, in double icon, in bool selected, in Text style) {
    ToggleButton toggle { icon: input.icon; action: input.toggle; selected: input.selected; width: 28; height: 28; classes: input.style; }
}
// One segment of a Blender header button group (shading, selection mode).
ui HeaderChoice(in ActionBinding choose, in double icon, in bool selected, in Key group, in Text style) {
    ChoiceButton choice { icon: input.icon; action: input.choose; selected: input.selected;
        selection_group: input.group; width: 26; height: 22; classes: input.style; }
}
// Scene view: Blender's semantic header (interaction mode, View/Select/Add/Object,
// pivot, snapping, overlays and shading as grouped widgets) over Houdini's tool
// rail and operation band; passive and interactive annotations float over the scene.
ui SceneViewport(in ActionBinding back, in ActionBinding forward,
                 in double back_icon, in double forward_icon, in double path_icon,
                 in double display_icon, in double guides_icon, in bool display_open, in bool guides_open,
                 in Items<ViewportMode> modes, in double pivot_icon, in bool pivot_open,
                 in Text mode_name, in double mode_icon, in Text basis, in Text pivot_name,
                 in ActionBinding snap, in double snap_icon, in bool snapping, in Text grid_step, in bool snap_open,
                 in bool surface, in ActionBinding surface_toggle, in Text view_name, in bool view_open,
                 in ActionBinding collapse_toggle, in bool collapsed, in double up_icon, in double down_icon,
                 in Text readout, in bool modal, in ActionBinding rail_snap, in Text tool_hint, in Text tool_hint_style,
                 in bool cavity_open, in bool show_fps, in Text fps, in bool camera_flying,
                 in Items<HeaderChoice> shading, in Items<HeaderChoice> select_modes,
                 in bool view_menu_open, in bool select_menu_open, in bool add_menu_open, in bool object_menu_open,
                 in bool actions_open, in bool compact, in Items<DisplayToggle> display_toggles,
                 in double basis_icon, in bool basis_open) {
    Column pane {
        expand_height: true;
        Row navigation {
            height: 32; gap: 2; padding_left: 4; padding_top: 3; padding_right: 4; padding_bottom: 3;
            align_center: true; classes: "path-bar";
            Button back { icon: input.back_icon; action: input.back; width: 22; height: 24; classes: "path-navigation"; }
            Button forward { icon: input.forward_icon; action: input.forward; width: 22; height: 24; classes: "path-navigation"; }
            Combo path { text: "World"; icon: input.path_icon; min_width: 32; shrink_width: 132; height: 24; classes: "pane-path"; }
            Column lead_gap { width: 4; height: 1; }
            Combo actions { icon: input.mode_icon; selected: input.actions_open; width: 34; height: 24; classes: "icon-menu viewport-header-icon"; }
            Combo view_menu { collapsed: input.compact; text: "View"; selected: input.view_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Combo select_menu { collapsed: input.compact; text: "Select"; selected: input.select_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Combo add_menu { collapsed: input.compact; text: "Add"; selected: input.add_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Combo object_menu { collapsed: input.compact; text: "Object"; selected: input.object_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Column header_gap { expand_width: true; height: 1; }
            Combo pivot { icon: input.pivot_icon; selected: input.pivot_open; width: 34; height: 24; classes: "icon-menu viewport-header-icon"; }
            ToggleButton snapping { icon: input.snap_icon; action: input.snap; selected: input.snapping; width: 26; height: 24; classes: "viewport-header-toggle"; }
            Combo step { text: input.grid_step; selected: input.snap_open; content_width: 0; height: 24; classes: "viewport-header-step"; }
            Column overlay_gap { width: 6; height: 1; }
            Combo guides { icon: input.guides_icon; selected: input.guides_open; width: 34; height: 24; classes: "icon-menu viewport-header-icon"; }
            Combo cavity { collapsed: input.compact; text: "Cavity"; content_width: 0; height: 24; selected: input.cavity_open; classes: "viewport-header-step"; }
            Column shading_gap { width: 4; height: 1; }
            Row shading_modes { gap: 0; align_center: true; content_width: 0; classes: "viewport-segment";
                Repeat shading { items: input.shading; }
            }
            Combo display { icon: input.display_icon; selected: input.display_open; width: 16; height: 24; classes: "viewport-header-more"; }
        }
        Row options { height: choose(input.collapsed, 12.0d, 28.0d); wrap: false; classes: "viewport-options";
            ToggleButton stow { action: input.collapse_toggle; icon: choose(input.collapsed, input.down_icon, input.up_icon);
                selected: input.collapsed; min_width: 12; expand_width: input.collapsed; expand_height: true;
                padding_bottom: choose(input.collapsed, 0.0d, 16.0d); classes: "bar-stow"; }
            Text readout { text: input.readout; collapsed: input.collapsed || !input.modal; expand_width: true; expand_height: true;
                padding_left: 10; classes: "viewport-readout"; }
            Row settings { collapsed: input.collapsed || input.modal; expand_width: true; expand_height: true; align_center: true; gap: 6;
                padding_left: 4; padding_right: 6;
                Row selection_modes { gap: 0; align_center: true; content_width: 0; classes: "viewport-segment";
                    Repeat select_modes { items: input.select_modes; }
                }
                Column divider { width: 1; height: 18; classes: "viewport-option-divider"; }
                Combo basis { text: input.basis; icon: input.basis_icon; selected: input.basis_open; content_width: 0; height: 22; classes: "viewport-option-menu"; }
                Text pivot_label { text: input.pivot_name; content_width: 0; single_line: true; classes: "viewport-option-label"; }
                Column divider2 { width: 1; height: 18; classes: "viewport-option-divider"; }
                Checkbox surface { text: "Surface Cursor"; action: input.surface_toggle; selected: input.surface; content_width: 0; height: 22; classes: "viewport-option-check"; }
            }
        }
        Row content { expand_height: true;
            Column edit_tools { width: 38; expand_height: true; gap: 2; padding_top: 6; padding_left: 3; classes: "viewport-rail";
                Repeat modes { items: input.modes; }
                Column snap_separator { height: 1; classes: "viewport-rail-separator"; }
                Column snap_spacing { height: 6; }
                // Houdini keeps snapping beside the handles; here it shares the header toggle.
                ToggleButton rail_snap { icon: input.snap_icon; action: input.rail_snap; selected: input.snapping;
                    width: 32; height: 32; classes: "viewport-mode"; }
            }
            Overlay scene { expand_width: true; expand_height: true;
                Viewport viewport { expand_width: true; expand_height: true; }
                // Houdini closes the scene with a recessed bevel; drawn over the
                // edge so the viewport rectangle and its hit area stay unchanged.
                Column frame { expand_width: true; expand_height: true; enabled: false; classes: "viewport-frame"; }
                Text mode { text: input.mode_name; icon: input.mode_icon; enabled: false;
                    out_of_flow: true; offset_x: 12; offset_y: 10; width: 200; height: 26; classes: "viewport-mode-label"; }
                Text fps { text: input.fps; collapsed: !input.show_fps; enabled: false; single_line: true;
                    out_of_flow: true; offset_x: 12; offset_y: 40; width: 220; classes: "viewport-fps"; }
                Text fly_reticle { text: "+"; collapsed: !input.camera_flying; enabled: false;
                    out_of_flow: true; anchor_x: 0.5; anchor_y: 0.5; pivot_x: 0.5; pivot_y: 0.5;
                    width: 20; height: 20; classes: "viewport-fly-reticle"; }
                // Houdini prints the active tool's mouse bindings on the scene's lower edge.
                Text tool_hint { text: input.tool_hint; enabled: false; out_of_flow: true; anchor_y: 1; pivot_y: 1;
                    offset_x: 12; offset_y: -8; width: 640; height: 20; classes: input.tool_hint_style; }
                Combo camera { text: input.view_name; selected: input.view_open; content_width: 0; height: 22;
                    out_of_flow: true; anchor_x: 1; pivot_x: 1; offset_x: -10; offset_y: 12; classes: "viewport-view-menu"; }
            }
            // Houdini's display bar: view-only toggles mirrored by the header, Guides and the Z pie.
            Column display_bar { width: 34; expand_height: true; gap: 2; padding_top: 6; padding_left: 3; classes: "viewport-rail viewport-display-bar";
                Repeat display_toggles { items: input.display_toggles; }
            }
        }
    }
}
ui PaneTab(in Text title, in bool selected, in Text style, in Key target, in double close_icon) {
    Row group {
        classes: "dock-tab-group"; selected: input.selected; flex_width: 44; expand_height: true; wrap: false;
        Tab title { text: input.title; selected: input.selected; context: input.target; classes: input.style; grow_width: 12; expand_height: true; }
        Button close { icon: input.close_icon; selected: input.selected; width: 20; expand_height: true; classes: "dock-close"; }
    }
}
ui PaneSlot(in bool panel) { Column content { expand_height: true; panel: input.panel; } }
ui PaneTabs(in Items<PaneTab> tabs, in Items<PaneSlot> contents, in bool active,
            in double maximize_icon, in double plus_icon, in double down_icon) {
    Row strip {
        height: 22; wrap: false; classes: "dock-tabs";
        Row tabs { flex_width: 0; expand_height: true; wrap: false; Repeat tab_items { items: input.tabs; } }
        Combo add { icon: input.plus_icon; width: 24; height: 22; context: node.add; classes: "dock-add"; }
        Column gap { height: 22; }
        Button maximize { icon: input.maximize_icon; width: 22; height: 22; enabled: input.active; classes: "dock-tool"; }
        Combo menu { icon: input.down_icon; width: 22; height: 22; context: node.menu; classes: "dock-menu"; }
    }
    Repeat contents { items: input.contents; }
    Text empty {
        text: "Open a view from the pane menu."; caption: true; expand_height: true;
        padding_left: 12; padding_top: 12; padding_right: 12; padding_bottom: 12; collapsed: input.active;
    }
}
ui PaneDivider(in double x, in double y, in double width, in double height, in bool vertical,
               in double value, in double minimum, in double maximum, in double step,
               in double first_icon, in double second_icon, in double grip_icon,
               in bool first_hidden, in bool second_hidden, in Text divider_style, in Text grip_style) {
    Overlay rail {
        width: input.width; height: input.height; out_of_flow: true; offset_x: input.x; offset_y: input.y;
        Splitter track {
            expand_height: true; value: input.value; minimum: input.minimum; maximum: input.maximum;
            step: input.step; vertical: input.vertical; classes: input.divider_style;
        }
        Button first {
            width: rail_button_width(input.vertical, input.width, input.height);
            height: rail_button_height(input.vertical, input.width, input.height);
            out_of_flow: true; anchor_x: 0.5d; anchor_y: 0.5d; pivot_x: 0.5d; pivot_y: 0.5d;
            offset_x: -choose(input.vertical, rail_button_length(input.width), 0.0d);
            offset_y: -choose(input.vertical, 0.0d, rail_button_length(input.height));
            icon: input.first_icon; selected: input.first_hidden; classes: "dock-collapse";
        }
        Splitter grip {
            width: rail_button_width(input.vertical, input.width, input.height);
            height: rail_button_height(input.vertical, input.width, input.height);
            out_of_flow: true; anchor_x: 0.5d; anchor_y: 0.5d; pivot_x: 0.5d; pivot_y: 0.5d;
            value: input.value; minimum: input.minimum; maximum: input.maximum; step: input.step;
            vertical: input.vertical; click_action: true; icon: input.grip_icon; classes: input.grip_style;
        }
        Button second {
            width: rail_button_width(input.vertical, input.width, input.height);
            height: rail_button_height(input.vertical, input.width, input.height);
            out_of_flow: true; anchor_x: 0.5d; anchor_y: 0.5d; pivot_x: 0.5d; pivot_y: 0.5d;
            offset_x: choose(input.vertical, rail_button_length(input.width), 0.0d);
            offset_y: choose(input.vertical, 0.0d, rail_button_length(input.height));
            icon: input.second_icon; selected: input.second_hidden; classes: "dock-collapse";
        }
    }
}
ui DockPane(in double width, in double height, in double x, in double y, in bool split,
            in Items<PaneTab> tabs, in Items<PaneSlot> contents, in bool active, in double maximize_icon,
            in double plus_icon, in double down_icon,
            in double divider_x, in double divider_y, in double divider_width, in double divider_height,
            in bool vertical, in double value, in double minimum, in double maximum, in double step,
            in double first_icon, in double second_icon, in double grip_icon,
            in bool first_hidden, in bool second_hidden, in Text divider_style, in Text grip_style) {
    Column pane {
        width: input.width; height: input.height; out_of_flow: true; offset_x: input.x; offset_y: input.y; classes: "dock-pane";
        PaneTabs tabs {
            mounted: !input.split; tabs: input.tabs; contents: input.contents; active: input.active;
            maximize_icon: input.maximize_icon; plus_icon: input.plus_icon; down_icon: input.down_icon;
        }
        PaneDivider divider {
            mounted: input.split; x: input.divider_x; y: input.divider_y; width: input.divider_width; height: input.divider_height;
            vertical: input.vertical; value: input.value; minimum: input.minimum; maximum: input.maximum; step: input.step;
            first_icon: input.first_icon; second_icon: input.second_icon; grip_icon: input.grip_icon;
            first_hidden: input.first_hidden; second_hidden: input.second_hidden;
            divider_style: input.divider_style; grip_style: input.grip_style;
        }
    }
}
ui DockWorkspace(in Items<DockPane> panes) { Repeat panes { items: input.panes; } }
// Inline rename (Houdini Tree View / Blender Outliner): a field laid over the row being renamed.
ui InlineRename(in TextEditBinding name, in double x, in double y, in double width, in double height) {
    TextField field { edit: input.name; out_of_flow: true; offset_x: input.x; offset_y: input.y; width: input.width; height: input.height; classes: "inline-rename"; }
}
ui DockPreview(in bool visible, in double x, in double y, in double width, in double height) {
    Column preview { collapsed: !input.visible; enabled: false; out_of_flow: true; offset_x: input.x; offset_y: input.y; width: input.width; height: input.height; classes: "dock-preview"; }
}
ui PopupEntry(in Text title, in Text shortcut, in bool enabled, in bool selected,
              in bool branch, in bool separator, in Text behavior, in Key group,
              in double icon, in double arrow_icon, in Text shortcut_style, in Text heading, in bool has_heading) {
    Column entry {
        Overlay separator {
            height: 14; collapsed: !input.separator; enabled: false;
            Column line { height: 2.0d / 3.0d; out_of_flow: true; anchor_y: 0.5d; pivot_y: 0.5d; enabled: false; classes: "menu-separator"; }
        }
        Text heading { text: input.heading; collapsed: !input.has_heading; enabled: false; single_line: true; caption: true; classes: "menu-heading"; }
        Column row {
            content_height: 25.0d + 1.0d / 3.0d;
            MenuItem item {
                text: input.title; enabled: input.enabled; selected: input.selected; icon: input.icon;
                menu_branch: input.branch; menu_behavior: input.behavior; radio_group: input.group;
                content_height: 25.0d + 1.0d / 3.0d;
            }
            Text shortcut {
                text: input.shortcut; icon: input.arrow_icon; enabled: false; classes: input.shortcut_style;
                content_width: choose(input.branch, 12.0d, 0.0d); expand_height: true;
                out_of_flow: true; anchor_x: 1; pivot_x: 1; offset_x: -10;
            }
        }
    }
}
ui PopupMenu(in Items<PopupEntry> entries) {
    Popup menu {
        width: 280; out_of_flow: true; classes: "menu";
        padding_left: 2.0d / 3.0d; padding_top: 2.0d / 3.0d; padding_right: 2.0d / 3.0d; padding_bottom: 2.0d / 3.0d;
        Repeat entries { items: input.entries; }
    }
}

ui PieEntry(in Text title, in bool enabled, in bool selected, in double x, in double y, in Key group, in Text behavior) {
    MenuItem item {
        text: input.title; enabled: input.enabled; selected: input.selected;
        menu_behavior: input.behavior; radio_group: input.group;
        out_of_flow: true; offset_x: input.x; offset_y: input.y; pivot_x: 0.5d; pivot_y: 0.5d;
        width: 112; height: 28; classes: "pie-item";
    }
}
ui ViewportPie(in double x, in double y, in Text title, in Items<PieEntry> entries) {
    Popup menu {
        width: 360; height: 208; out_of_flow: true; offset_x: input.x; offset_y: input.y; classes: "pie-menu";
        Text hub {
            text: input.title; enabled: false; single_line: true; width: 64;
            out_of_flow: true; anchor_x: 0.5d; anchor_y: 0.5d; pivot_x: 0.5d; pivot_y: 0.5d; classes: "pie-hub";
        }
        Repeat entries { items: input.entries; }
    }
}
ui ColorEditor(in double x, in double y, in double r, in double g, in double b, in double r0, in double g0, in double b0,
                in EditBinding rgb, in EditBinding hsv, in TextEditBinding hex, in ActionBinding revert, in ActionBinding done) {
    // Houdini colour editor in this editor's vocabulary: new/original preview, RGB and
    // HSV slider rows editing the same value, hex entry; one history entry per session.
    Popup editor {
        width: 420; out_of_flow: true; offset_x: input.x; offset_y: input.y; classes: "color-editor";
        padding_left: 8; padding_top: 8; padding_right: 8; padding_bottom: 8;
        Row preview { height: 40; gap: 1;
            Column current { expand_width: true; expand_height: true; red: input.r; green: input.g; blue: input.b; classes: "color-swatch"; }
            Button original { text: ""; action: input.revert; expand_width: true; expand_height: true; red: input.r0; green: input.g0; blue: input.b0; classes: "color-swatch color-original"; }
        }
        Column fields { gap: 5; padding_top: 8;
            NumberRow rgb { text: "RGB"; edit: input.rgb; }
            NumberRow hsv { text: "HSV"; edit: input.hsv; }
            Row hex_row { gap: 4; align_center: true;
                Text hex_label { text: "Hex"; width: 160; single_line: true; classes: "parameter-label"; }
                TextField hex { edit: input.hex; shrink_width: 96; }
            }
        }
        Row actions { height: 30; padding_top: 6; gap: 4;
            Column spacer { expand_width: true; height: 1; }
            Button done { text: "Done"; action: input.done; height: 24; content_width: 0; min_width: 72; }
        }
    }
}
ui WorkbenchRgb(in EditBinding color) { NumberRow color { text: "Color"; edit: input.color; } }
ui WorkbenchChannels(in EditBinding red, in EditBinding green, in EditBinding blue) {
    NumberRow red { text: "Red"; edit: input.red; }
    NumberRow green { text: "Green"; edit: input.green; }
    NumberRow blue { text: "Blue"; edit: input.blue; }
}
ui Controls(in TextEditBinding name, in bool name_modified, in bool disabled, in bool long_labels,
            in bool expanded, in bool general, in bool rgb_selected, in bool color_expanded,
            in bool enabled, in bool enabled_modified, in Text mode, in bool mode_modified,
            in EditBinding position, in EditBinding exposure, in EditBinding vector4,
            in EditBinding color, in EditBinding red, in EditBinding green, in EditBinding blue,
            in double r, in double g, in double b, in bool can_reset, in Text history, in Text position_title, in Text exposure_title) {
    Row header {
        classes: "object-header"; height: 32; gap: 4; align_center: true; padding_left: 6; padding_right: 4;
        Text type { text: "Sample"; content_width: 0; single_line: true; classes: "object-type"; }
        TextField name { edit: input.name; context: input.name; modified: input.name_modified; min_width: 32; classes: "object-name"; }
    }
    Column pages {
        expand_height: true;
        Row tabs {
            height: 26.667; padding_bottom: 0.667; classes: "section-tabs";
            ChoiceButton general { text: "Parameters"; selected: input.general; selection_group: node.tabs; height: 26; classes: "section-tab"; }
            ChoiceButton appearance { text: "Appearance"; selected: !input.general; selection_group: node.tabs; height: 26; classes: "section-tab joined"; }
        }
        List scroll {
            expand_height: true; gap: 1; classes: "parameter-list";
            Column general_body {
                gap: 1; collapsed: !input.general;
                Column options {
                    gap: 5; classes: "section-body";
                    Checkbox disable { text: "Disable sample fields"; selected: input.disabled; height: 24; expand_width: true; }
                    Checkbox long_labels { text: "Show long labels"; selected: input.long_labels; height: 24; expand_width: true; }
                }
                Foldout fold { text: "Transform and display"; selected: input.expanded; height: 24; classes: "section"; }
                Column body {
                    gap: 5; collapsed: !input.expanded; enabled: !input.disabled; classes: "section-body";
                    NumberRow position { text: input.position_title; edit: input.position; }
                    NumberRow exposure { text: input.exposure_title; edit: input.exposure; }
                    ParameterRow enabled_row {
                        text: "";
                        Checkbox enabled { text: "Enabled"; selected: input.enabled; modified: input.enabled_modified; height: 24; expand_width: true; }
                    }
                    NumberRow vector4 { text: "Vector4"; edit: input.vector4; }
                    ParameterRow projection {
                        text: "Projection"; modified: input.mode_modified;
                        Combo mode { text: input.mode; modified: input.mode_modified; height: 26; content_width: 120; }
                    }
                }
            }
            Column appearance_body {
                collapsed: input.general; enabled: !input.disabled;
                Row color_tabs {
                    height: 26.667; padding_bottom: 0.667; classes: "section-tabs";
                    ChoiceButton rgb { text: "Color"; selected: input.rgb_selected; selection_group: node.color_tabs; height: 26; classes: "section-tab"; }
                    ChoiceButton channels { text: "Channels"; selected: !input.rgb_selected; selection_group: node.color_tabs; height: 26; classes: "section-tab joined"; }
                }
                Column nested {
                    gap: 1; classes: "parameter-nested-body";
                    Column swatch_row {
                        classes: "section-body";
                        Column swatch { height: 48; red: input.r; green: input.g; blue: input.b; classes: "color-swatch"; }
                    }
                    Foldout color_fold { text: "Color components"; selected: input.color_expanded; height: 24; classes: "section"; }
                    Column color_body {
                        gap: 5; collapsed: !input.color_expanded; classes: "section-body";
                        WorkbenchRgb rgb_fields { mounted: input.rgb_selected; color: input.color; }
                        WorkbenchChannels channel_fields { mounted: !input.rgb_selected; red: input.red; green: input.green; blue: input.blue; }
                    }
                    Text preview { text: "Preview"; height: 28; classes: "parameter-section"; }
                    Text explanation { text: "RGB values share one color. Switching tabs preserves edits; Undo restores the previous color."; caption: true; classes: "section-body"; }
                }
            }
            Column footer {
                gap: 5; classes: "section-body";
                Button reset { text: "Reset sample values"; enabled: input.can_reset; height: 24; expand_width: true; }
                Text history { text: input.history; caption: true; }
                Text gestures { text: "Middle drag: value ladder · Right click: menu\nCtrl + middle: defaults · Esc: cancel"; caption: true; }
            }
        }
    }
}


ui CodePanel(in CodeBinding document, in Text title, in Text status, in Text diagnostic,
             in bool has_diagnostic, in bool can_jump, in bool conflict, in Key file_menu,
             in ActionBinding open, in ActionBinding save, in ActionBinding close, in ActionBinding reload,
             in ActionBinding create, in ActionBinding build, in ActionBinding run, in ActionBinding stop, in bool running) {
    Row toolbar {
        height: 25; gap: 2; classes: "browser-toolbar";
        Combo files { text: input.title; context: input.file_menu; flex_width: 1; single_line: true; classes: "browser-path"; }
        Button open { text: "Open..."; action: input.open; classes: "browser-tool"; }
        Button save { text: "Save"; action: input.save; classes: "browser-tool"; }
        Button close { icon: 1; width: 23; action: input.close; classes: "browser-icon"; }
        Button create { icon: 10; width: 23; action: input.create; classes: "browser-icon"; }
        Button build { text: "Build"; action: input.build; classes: "browser-tool"; }
        Button run { text: "Run"; action: input.run; collapsed: input.running; classes: "browser-tool"; }
        Button stop { text: "Stop"; action: input.stop; collapsed: !input.running; classes: "browser-tool"; }
    }
    Row conflict {
        height: 24; collapsed: !input.conflict;
        Text message { text: "External changes detected"; flex_width: 1; single_line: true; }
        Button reload { text: "Reload from Disk"; action: input.reload; classes: "browser-tool"; }
    }
    CodeEditor buffer { document: input.document; expand_height: true; classes: "source-code"; }
    Button problem {
        text: input.diagnostic; collapsed: !input.has_diagnostic; enabled: input.can_jump;
        height: 25; expand_width: true; classes: "source-problem";
    }
    Text status { text: input.status; height: 22; classes: "browser-status source-status"; }
}

ui ProjectOutput(in TableBinding output) {
    Table messages { model: input.output; expand_height: true; view: "details"; row_height: 23; classes: "asset-table"; }
}
