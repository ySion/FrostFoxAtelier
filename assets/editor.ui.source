double choose(bool condition, double yes, double no) {
    if (condition) { return yes; }
    return no;
}
double shelf_expanded_height() { return 34.0d; }

double rail_button_length(double extent) {
    if (extent < 84.0d) { return extent / 3.0d; }
    return 28.0d;
}
double rail_button_thickness(double extent) {
    if (extent < 4.0d / 3.0d) { return 0.0d; }
    return extent - 4.0d / 3.0d;
}
double rail_button_width(bool vertical, double width, double height) {
    return choose(vertical, rail_button_length(width), rail_button_thickness(width));
}
double rail_button_height(bool vertical, double width, double height) {
    return choose(vertical, rail_button_thickness(height), rail_button_length(height));
}

ui Position(in bool matches, in EditBinding position, in EditBinding rotation, in EditBinding scale,
            in bool show_position, in bool show_rotation, in bool show_scale,
            in TooltipBinding position_help, in TooltipBinding rotation_help, in TooltipBinding scale_help) {
    state bool expanded = true;
    Foldout section {
        text: "Scene root content";
        icon: "transform";
        height: 22;
        classes: "section";
        selected: state.expanded;
        collapsed: !input.matches;
        on activate { state.expanded = event.checked; }
    }
    Column contents {
        gap: 3;
        classes: "section-body";
        collapsed: !state.expanded || !input.matches;
        NumberRow position {
            text: "Position (m)";
            tooltip: input.position_help;
            edit: input.position;
            collapsed: !input.show_position;
        }
        NumberRow rotation { text: "Rotation (°)"; edit: input.rotation; tooltip: input.rotation_help; collapsed: !input.show_rotation; }
        NumberRow scale { text: "Scale"; edit: input.scale; tooltip: input.scale_help; collapsed: !input.show_scale; }
    }
}

ui SearchBox(in TextEditBinding edit, in Text placeholder, in bool clear_collapsed, in ActionBinding clear) {
    Row box {
        height: 22; align_center: true; gap: 2; padding_left: 4; padding_right: 2; classes: "search-box";
        Text icon { icon: "search"; width: 15; height: 18; classes: "browser-search-icon"; }
        TextField field { edit: input.edit; context: input.edit; placeholder: input.placeholder; height: 20; expand_width: true; classes: "search-box-field"; }
        Button clear {
            icon: "close"; action: input.clear; collapsed: input.clear_collapsed; width: 18; height: 18; classes: "ghost-tool";
            tooltip_title: "Clear Filter"; tooltip_identity: "Search"; tooltip: "清空当前过滤关键字。";
        }
    }
}

ui NumericProperty(in Text title, in EditBinding edit, in bool row_enabled, in bool swatch, in double r, in double g, in double b, in ActionBinding pick) {
    // Houdini colour tuples end with a live swatch of the current value; clicking it opens the colour editor.
    Row row { align_center: true; gap: 4;
        Column fields { expand_width: true; NumberRow number { text: input.title; edit: input.edit; enabled: input.row_enabled; } }
        Button swatch { text: ""; action: input.pick; width: 22; height: 20; collapsed: !input.swatch; red: input.r; green: input.g; blue: input.b; classes: "color-swatch parameter-swatch"; }
    }
}

ui BooleanProperty(in Text title, in bool checked, in bool enabled, in bool row_enabled, in ActionBinding change, in Key context_menu) {
    ParameterRow row { text: input.title; enabled: input.row_enabled; context: input.context_menu;
        Checkbox toggle { text: ""; selected: input.checked; enabled: input.enabled; action: input.change; context: input.context_menu; height: 22; content_width: 0; }
    }
}

ui EnumProperty(in Text title, in Text choice, in bool enabled, in bool row_enabled, in Key target, in Key context_menu) {
    // Houdini menu buttons hug their label (e.g. "Scale Rot Trans") instead of
    // spanning the row; a minimum keeps short choices clickable.
    ParameterRow row { text: input.title; enabled: input.row_enabled; context: input.context_menu;
        Combo choice { text: input.choice; context: input.target; enabled: input.enabled; height: 22; content_width: 0; min_width: 92;
            classes: "parameter-menu"; }
    }
}

ui TextProperty(in Text title, in TextEditBinding text_edit, in bool row_enabled, in Key context_menu) {
    ParameterRow row { text: input.title; enabled: input.row_enabled; context: input.context_menu;
        TextField field { edit: input.text_edit; context: input.text_edit; expand_width: true; height: 22; }
    }
}

ui PropertyRow(in Text title, in EditBinding edit, in bool boolean, in bool checked, in bool enabled,
               in ActionBinding change, in bool enumeration, in Text choice, in Key target,
               in bool swatch, in double r, in double g, in double b,
               in bool override_available, in bool overridden, in ActionBinding inherit, in TooltipBinding help, in ActionBinding pick,
               in bool text_kind, in TextEditBinding text_edit, in Key context_menu, in bool row_enabled) {
    Row row { gap: 3; tooltip: input.help;
        Column override_area { collapsed: !input.override_available; width: 22;
            Checkbox override { text: ""; selected: input.overridden; action: input.inherit; width: 22; height: 22; }
        }
        Column value { expand_width: true;
        NumericProperty numeric { mounted: !input.boolean && !input.enumeration && !input.text_kind; title: input.title; edit: input.edit; row_enabled: input.row_enabled;
            swatch: input.swatch; r: input.r; g: input.g; b: input.b; pick: input.pick; }
        BooleanProperty boolean { mounted: input.boolean; title: input.title; checked: input.checked; enabled: input.enabled; row_enabled: input.row_enabled; change: input.change; context_menu: input.context_menu; }
        EnumProperty enumeration { mounted: input.enumeration; title: input.title; choice: input.choice; enabled: input.enabled; row_enabled: input.row_enabled; target: input.target; context_menu: input.context_menu; }
        TextProperty text_prop { mounted: input.text_kind; title: input.title; text_edit: input.text_edit; row_enabled: input.row_enabled; context_menu: input.context_menu; }
        }
    }
}

ui PropertyGroup(in Text title, in double icon, in Items<PropertyRow> properties) {
    state bool expanded = true;
    Column component {
        Foldout title { text: input.title; icon: input.icon; selected: state.expanded; height: 22; classes: "section";
            on activate { state.expanded = event.checked; }
        }
        Column properties { gap: 3; collapsed: !state.expanded; classes: "section-body"; Repeat rows { items: input.properties; } }
    }
}

ui EntityRow(in Text title, in bool enabled, in bool selected, in double icon,
            in TreeRowBinding row, in Text style, in bool draggable, in Key menu) {
    TreeItem row {
        draggable: input.draggable;
        context: input.menu;
        text: input.title;
        enabled: input.enabled;
        selected: input.selected;
        icon: input.icon;
        row: input.row;
        classes: input.style;
    }
}

ui InlineRenameField(in TextEditBinding edit) {
    TextField field { edit: input.edit; classes: "inline-rename"; }
}

ui SceneOutliner(in Items<EntityRow> entities, in double rows, in TextEditBinding filter,
                 in bool world_selected, in TreeRowBinding world_row,
                 in ActionBinding back, in ActionBinding forward,
                 in Text world_style, in bool show_components, in ActionBinding toggle_components,
                 in bool can_edit_entity, in Key add_component, in ActionBinding remove_object,
                 in bool renaming, in TextEditBinding rename,
                 in bool filter_empty, in ActionBinding clear_filter) {
    Row header {
        classes: "path-bar"; align_center: true; gap: 2; height: 30;
        padding_left: 4; padding_top: 3; padding_right: 4; padding_bottom: 3;
        Button back { icon: "back"; action: input.back; width: 22; height: 22; classes: "path-navigation";
            tooltip_title: "Back"; tooltip_identity: "Outliner Navigation"; tooltip: "返回上一个检视的场景对象。"; }
        Button forward { icon: "forward"; action: input.forward; width: 22; height: 22; classes: "path-navigation";
            tooltip_title: "Forward"; tooltip_identity: "Outliner Navigation"; tooltip: "前进到下一个检视的场景对象。"; }
        Combo path { text: "World"; icon: "world"; expand_width: true; min_width: 32; height: 22; classes: "pane-path"; }
        ToggleButton components {
            icon: "component"; selected: input.show_components; action: input.toggle_components;
            width: 24; height: 22; classes: "ghost-tool";
            tooltip_title: "Inline Components"; tooltip_identity: "Scene Outliner";
            tooltip: "在层级大纲中内联展开每个实体挂载的组件行，点击即可检视或开关单个组件。";
        }
        Combo add {
            icon: "plus"; context: input.add_component; enabled: input.can_edit_entity;
            width: 24; height: 22; classes: "icon-menu";
            tooltip_title: "Add Component"; tooltip_identity: "Entity Composition";
            tooltip: "向当前选中的实体挂载空间变换、网格、灯光、相机或业务组件。";
        }
        Button remove {
            icon: "trash"; action: input.remove_object; width: 24; height: 22; classes: "ghost-tool";
            tooltip_title: "Delete Selected [Del]"; tooltip_identity: "Scene Outliner";
            tooltip: "删除当前选中的组件或实体子树（支持撤销）。";
        }
    }
    Tree tree {
        expand_height: true;
        rows: input.rows;
        TreeItem world {
            text: "World";
            icon: "world";
            selected: input.world_selected;
            row: input.world_row;
            classes: input.world_style;
        }
        Repeat rows { items: input.entities; }
    }
    InlineRenameField rename_box { mounted: input.renaming; edit: input.rename; }
    Column filter_area {
        padding_left: 4;
        padding_top: 3;
        padding_right: 4;
        padding_bottom: 3;
        classes: "parameter-search";
        SearchBox query {
            edit: input.filter; placeholder: "Filter entities & components...";
            clear_collapsed: input.filter_empty; clear: input.clear_filter;
        }
    }
}

ui ShelfTool(in Text title, in double icon, in ActionBinding action) {
    Button tool {
        text: input.title;
        icon: input.icon;
        action: input.action;
        classes: "shelf-tool";
        content_width: 0;
        min_width: 54;
        height: 26;
    }
}

ui ToolShelf(in bool collapsed, in bool create_selected,
             in Items<ShelfTool> create_tools, in Items<ShelfTool> view_tools,
             in ActionBinding toggle, in ActionBinding create, in ActionBinding view,
             in double rail_width, in double closed_height, in double arrow_height,
             in double up_icon, in double down_icon) {
    Row shelf {
        classes: "tool-shelf";
        height: choose(input.collapsed, input.closed_height, shelf_expanded_height());
        ToggleButton stow {
            classes: "bar-stow";
            expand_width: input.collapsed;
            min_width: input.rail_width;
            expand_height: true;
            padding_bottom: choose(input.collapsed, 0.0d, shelf_expanded_height() - input.arrow_height);
            icon: choose(input.collapsed, input.down_icon, input.up_icon);
            selected: input.collapsed;
            action: input.toggle;
        }
        Row contents {
            expand_height: true;
            align_center: true;
            gap: 6;
            padding_left: 5;
            padding_right: 5;
            collapsed: input.collapsed;
            Row tabs {
                classes: "segmented-switch";
                content_width: 0;
                height: 24;
                gap: 1;
                padding_left: 1.5;
                padding_top: 1.5;
                padding_right: 1.5;
                padding_bottom: 1.5;
                align_center: true;
                ChoiceButton create {
                    text: "Create";
                    classes: "segmented-item";
                    height: 21;
                    content_width: 0;
                    selected: input.create_selected;
                    selection_group: node.tabs;
                    action: input.create;
                }
                ChoiceButton view {
                    text: "View";
                    classes: "segmented-item";
                    height: 21;
                    content_width: 0;
                    selected: !input.create_selected;
                    selection_group: node.tabs;
                    action: input.view;
                }
            }
            Column shelf_div { width: 1; height: 18; classes: "viewport-option-divider"; }
            Row body {
                expand_width: true;
                expand_height: true;
                align_center: true;
                gap: 2;
                Row create_tools {
                    content_width: 0;
                    align_center: true;
                    gap: 2;
                    collapsed: !input.create_selected;
                    Repeat buttons { items: input.create_tools; }
                }
                Row view_tools {
                    content_width: 0;
                    align_center: true;
                    gap: 2;
                    collapsed: input.create_selected;
                    Repeat view_buttons { items: input.view_tools; }
                }
            }
        }
    }
}

ui PanePath(in Text title, in ActionBinding back, in ActionBinding forward, in double path_icon) {
    Row bar {
        classes: "path-bar";
        align_center: true;
        gap: 2;
        height: 32;
        padding_left: 4;
        padding_top: 4;
        padding_right: 4;
        padding_bottom: 4;
        Button back { icon: "back"; action: input.back; width: 22; height: 24; classes: "path-navigation"; }
        Button forward { icon: "forward"; action: input.forward; width: 22; height: 24; classes: "path-navigation"; }
        Combo path { text: input.title; icon: input.path_icon; expand_width: true; min_width: 32; height: 24; classes: "pane-path"; }
    }
}

ui Parameters(in Text type_name, in TextEditBinding name,
              in ActionBinding back, in ActionBinding forward, in double path_icon,
              in bool has_selection, in Items<PropertyGroup> groups, in bool matches,
              in EditBinding position, in TextEditBinding filter, in bool empty,
              in double type_icon, in bool search_visible, in ActionBinding search,
              in EditBinding rotation, in EditBinding scale, in bool show_position, in bool show_rotation, in bool show_scale,
              in bool by_category, in ActionBinding components, in ActionBinding categories,
              in TooltipBinding position_help, in TooltipBinding rotation_help, in TooltipBinding scale_help,
              in TooltipBinding type_help, in Text path_title,
              in Text name_style, in bool filter_empty, in ActionBinding clear_filter) {
    Column pane {
        classes: "parameter-pane"; panel: true; expand_height: true;
        PanePath path { title: input.path_title; back: input.back; forward: input.forward; path_icon: input.path_icon; }
        // Houdini's parameter header: type, name, grouping tabs and search on one line.
        Row header {
            classes: "object-header"; height: 30; gap: 4; align_center: true; padding_left: 6; padding_right: 4;
            Text type { text: input.type_name; icon: input.type_icon; content_width: 0; single_line: true; classes: "object-type"; tooltip: input.type_help; }
            TextField name { edit: input.name; context: input.name; min_width: 32; height: 22; classes: input.name_style; }
            Row grouping {
                gap: 1; height: 23; padding_left: 1.5; padding_top: 1.5; padding_right: 1.5; padding_bottom: 1.5;
                align_center: true; content_width: 0; collapsed: !input.has_selection; classes: "segmented-switch";
                ChoiceButton components { text: "Object"; action: input.components; selected: !input.by_category; selection_group: node.grouping; height: 20; classes: "segmented-item"; }
                ChoiceButton categories { text: "Category"; action: input.categories; selected: input.by_category; selection_group: node.grouping; height: 20; classes: "segmented-item"; }
            }
            ToggleButton search_toggle { icon: "search"; width: 24; height: 22; selected: input.search_visible; action: input.search; classes: "parameter-tool"; }
        }
        Column search { classes: "parameter-search"; collapsed: !input.has_selection || !input.search_visible;
            SearchBox query {
                edit: input.filter; placeholder: "Filter parameters...";
                clear_collapsed: input.filter_empty; clear: input.clear_filter;
            }
        }
        Text no_selection { text: "Select an object to inspect its properties."; classes: "empty-state";
            caption: true; single_line: true; collapsed: input.has_selection;
        }
        List scroll {
            classes: "parameter-list"; expand_height: true; gap: 1;
            collapsed: !input.has_selection;
            Column transform { collapsed: !input.matches;
                Position position { mounted: input.matches; matches: input.matches; position: input.position;
                    rotation: input.rotation; scale: input.scale; show_position: input.show_position;
                    show_rotation: input.show_rotation; show_scale: input.show_scale;
                    position_help: input.position_help; rotation_help: input.rotation_help; scale_help: input.scale_help; }
            }
            Column properties { gap: 1; Repeat groups { items: input.groups; } }
            Text empty { text: "No matching parameters"; classes: "empty-state"; single_line: true; caption: true; collapsed: !input.empty; }
        }
    }
}

ui ResourceProperty(in Text title, in TextEditBinding value) {
    ParameterRow row { text: input.title;
        TextField value { edit: input.value; context: input.value; read_only: true; expand_width: true; height: 21; classes: "readonly-field"; }
    }
}
ui WorldPanel(in Items<PropertyGroup> lighting, in Items<PropertyGroup> gi_reflections,
              in Items<PropertyGroup> post_display, in Items<PropertyGroup> diagnostics,
              in Items<ResourceProperty> actual, in bool editable, in TableBinding performance,
              in Text performance_status, in Text performance_resources, in TextEditBinding main_camera,
              in ActionBinding clear_camera) {
    state double page = 0.0d;
    state bool show_actual = true;
    Column pane { expand_height: true; panel: true; classes: "parameter-pane";
        Row tabs { height: 26; gap: 2; padding_left: 4; padding_right: 4; classes: "subtab-bar";
            ChoiceButton lighting_tab { text: "Lighting"; expand_height: true; selected: state.page == 0.0d; selection_group: node.tabs; classes: "subtab-item"; on activate { state.page = 0.0d; } }
            ChoiceButton gi_tab { text: "GI & Refl"; expand_height: true; selected: state.page == 1.0d; selection_group: node.tabs; classes: "subtab-item"; on activate { state.page = 1.0d; } }
            ChoiceButton post_tab { text: "Post"; expand_height: true; selected: state.page == 2.0d; selection_group: node.tabs; classes: "subtab-item"; on activate { state.page = 2.0d; } }
            ChoiceButton diagnostics_tab { text: "Diagnostics"; expand_height: true; selected: state.page == 3.0d; selection_group: node.tabs; classes: "subtab-item"; on activate { state.page = 3.0d; } }
            ChoiceButton performance_tab { text: "Performance"; expand_height: true; selected: state.page == 4.0d; selection_group: node.tabs; classes: "subtab-item"; on activate { state.page = 4.0d; } }
        }
        List scroll { expand_height: true; gap: 1; collapsed: state.page == 4.0d; classes: "parameter-list";
            Column lighting { gap: 1; collapsed: state.page != 0.0d;
                Row camera { height: 26; padding_left: 8; padding_right: 6; gap: 6; align_center: true;
                    Text label { text: "Main camera"; single_line: true; classes: "field-label"; }
                    TextField value { edit: input.main_camera; context: input.main_camera; read_only: true; expand_width: true; height: 21; classes: "readonly-field"; }
                    Button clear_camera { text: "Clear"; action: input.clear_camera; enabled: input.editable; height: 21; width: 44; classes: "ghost-button"; }
                }
                Repeat lighting_settings { items: input.lighting; }
            }
            Column gi_reflections { gap: 1; collapsed: state.page != 1.0d; Repeat gi_settings { items: input.gi_reflections; } }
            Column post_display { gap: 1; collapsed: state.page != 2.0d; Repeat post_settings { items: input.post_display; } }
            Column diagnostics { gap: 1; collapsed: state.page != 3.0d;
                Repeat diagnostic_settings { items: input.diagnostics; }
                Foldout actual_title { text: "Live GPU pipeline telemetry"; icon: "info"; selected: state.show_actual; height: 22; classes: "section";
                    on activate { state.show_actual = event.checked; }
                }
                Column actual { gap: 3; collapsed: !state.show_actual; classes: "section-body"; Repeat rows { items: input.actual; } }
            }
        }
        Column performance { expand_height: true; collapsed: state.page != 4.0d;
            Row performance_header { height: 26; padding_left: 6; align_center: true;
                Text performance_status { text: input.performance_status; single_line: true; expand_width: true; }
            }
            Table performance_table { model: input.performance; expand_height: true; view: "details";
                row_height: 21; header_height: 23; classes: "data-table";
            }
            Row performance_memory { height: 24; padding_left: 6; align_center: true;
                Text performance_resources { text: input.performance_resources; single_line: true; expand_width: true; }
            }
            Row performance_note { height: 24; padding_left: 6; align_center: true;
                Text performance_scope { text: "Scene Lit GPU · union interval across graphics + async compute"; single_line: true; expand_width: true; }
            }
        }
    }
}

ui ResourceParameters(in Text kind, in TextEditBinding name, in double icon, in Items<ResourceProperty> properties) {
    Column pane { expand_height: true; panel: true; classes: "parameter-pane";
        Row header { height: 30; align_center: true; gap: 4; padding_left: 6; padding_right: 6; classes: "object-header";
            Text kind_badge { text: input.kind; icon: input.icon; content_width: 0; single_line: true; classes: "object-type"; }
            TextField name { edit: input.name; context: input.name; read_only: true; expand_width: true; height: 22; classes: "readonly-inline"; }
        }
        List properties { expand_height: true; gap: 3; classes: "parameter-list section-body";
            Repeat rows { items: input.properties; }
        }
    }
}
ui MaterialParameters(in TextEditBinding name, in bool dirty, in Items<PropertyGroup> groups, in bool search_visible,
                      in TextEditBinding query, in bool query_empty, in ActionBinding clear_query, in ActionBinding search) {
    Column pane { expand_height: true; panel: true; classes: "parameter-pane";
        Row header { height: 30; align_center: true; gap: 4; padding_left: 6; padding_right: 4; classes: "object-header";
            Text kind { text: "Material"; icon: "material"; content_width: 0; single_line: true; classes: "object-type"; }
            TextField name { edit: input.name; context: input.name; read_only: true; expand_width: true; height: 22; classes: "readonly-inline"; }
            Column dirty_area { collapsed: !input.dirty; width: 14; Text dirty { text: "*"; single_line: true; } }
            ToggleButton search { icon: "search"; selected: input.search_visible; action: input.search; width: 24; height: 22; classes: "parameter-tool"; }
        }
        Column filter { classes: "parameter-search"; collapsed: !input.search_visible;
            SearchBox query_box { edit: input.query; placeholder: "Filter material parameters..."; clear_collapsed: input.query_empty; clear: input.clear_query; }
        }
        List properties { expand_height: true; gap: 1; classes: "parameter-list";
            Repeat groups { items: input.groups; }
        }
    }
}
ui AssetBrowserShell(in Items<EntityRow> directories, in double directory_rows, in TextEditBinding query,
                     in Text path, in Text status,
                     in ActionBinding back, in ActionBinding up, in ActionBinding clear,
                     in bool filter_selected, in double view_icon,
                     in double directory_width, in double directory_limit) {
    Row toolbar {
        classes: "browser-toolbar";
        height: 32;
        gap: 2;
        wrap: false;
        align_center: true;
        padding_left: 4;
        padding_right: 4;
        Button back {
            icon: "back";
            action: input.back;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Button up {
            icon: "up";
            action: input.up;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Combo path {
            text: input.path;
            context: node.path;
            expand_width: true;
            min_width: 32;
            classes: "browser-path";
        }
        Row search_area {
            expand_width: true;
            min_width: 44;
            height: 22;
            align_center: true;
            padding_left: 3;
            padding_right: 2;
            classes: "browser-search";
            Text search_icon {
                icon: "search";
                width: 16;
                height: 18;
                classes: "browser-search-icon";
            }
            TextField query {
                edit: input.query;
                context: input.query;
                placeholder: "Search assets...";
                height: 20;
                min_width: 8;
                classes: "browser-search-input";
            }
            Button clear {
                icon: "close";
                action: input.clear;
                width: 18;
                height: 18;
                classes: "browser-tool browser-icon";
            }
        }
        Combo filter {
            icon: "filter";
            selected: input.filter_selected;
            context: node.filter;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Combo view {
            icon: input.view_icon;
            context: node.view;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Combo actions {
            icon: "more";
            context: node.actions;
            width: 23;
            classes: "browser-tool browser-icon";
        }
    }
    Row body {
        gap: 0;
        wrap: false;
        expand_height: true;
        Tree tree {
            classes: "browser-directories";
            shrink_width: input.directory_width;
            min_width: 96;
            expand_height: true;
            rows: input.directory_rows;
            Repeat directories { items: input.directories; }
        }
        Splitter divider {
            width: 5; expand_height: true; vertical: false;
            value: input.directory_width; minimum: 96; maximum: input.directory_limit; step: 1;
            classes: "dock-divider vertical browser-divider";
        }
        Column content {
            min_width: 64;
            expand_height: true;
        }
    }
    Text status {
        text: input.status;
        height: 20;
        padding_left: 6;
        padding_right: 6;
        caption: true;
        classes: "browser-status";
    }
}

ui AssetResults(in TableBinding model, in ActionBinding open, in Key context, in Text view, in Text empty,
                in bool renaming, in TextEditBinding rename) {
    Table results {
        model: input.model;
        action: input.open;
        context: input.context;
        view: input.view;
        empty_text: input.empty;
        row_height: 22;
        header_height: 24;
        tile_width: 90;
        tile_height: 66;
        item_gap: 2;
        classes: "browser-table";
        expand_height: true;
        min_width: 64;
        padding_left: 0;
    }
    InlineRenameField rename_box { mounted: input.renaming; edit: input.rename; }
}

ui MenuTitle(in Text title, in bool selected, in Key target) {
    Button title { text: input.title; selected: input.selected; context: input.target; content_width: 38; expand_height: true; classes: "menubar-item"; }
}
ui EditorShell(in bool menu_collapsed, in Items<MenuTitle> menus, in Text status,
               in ActionBinding toggle, in double rail_width, in double closed_height, in double arrow_height,
               in double up_icon, in double down_icon, in Text facts, in bool play_diverged, in ActionBinding restart_play) {
    Column root {
        expand_height: true;
        Row menubar {
            classes: "menubar";
            height: choose(input.menu_collapsed, input.closed_height, 32.0d);
            ToggleButton stow {
                classes: "bar-stow"; expand_width: input.menu_collapsed; min_width: input.rail_width;
                expand_height: true; padding_bottom: choose(input.menu_collapsed, 0.0d, 32.0d - input.arrow_height);
                icon: choose(input.menu_collapsed, input.down_icon, input.up_icon);
                selected: input.menu_collapsed; action: input.toggle;
            }
            Row menu_body {
                expand_height: true; padding_top: 1; padding_bottom: 1; collapsed: input.menu_collapsed;
                Repeat titles { items: input.menus; }
            }
        }
        Column shelf_slot { }
        Column workspace { expand_height: true; }
        Row footer {
            height: 23; padding_left: 8; padding_right: 8; align_center: true; gap: 18; classes: "status-bar";
            Text status { text: input.status; single_line: true; caption: true; content_width: 0; classes: "status-text"; }
            Button restart { text: "Restart Play"; action: input.restart_play; collapsed: !input.play_diverged; height: 19; content_width: 0; min_width: 88; }
            Column spacer { expand_width: true; height: 1; }
            Text facts { text: input.facts; single_line: true; caption: true; content_width: 0; classes: "status-text status-facts"; }
        }
    }
}
// Houdini rail cells are 32 DIP squares; a hairline groups selection apart
// from the handle tools (measured: #4d4d4d over #3a3a3a, 8 DIP breathing room).
ui ViewportMode(in ActionBinding choose, in double icon, in bool selected, in Key group, in Text style) {
    // Selection-group buttons stay direct children of the rail; the group gap is
    // drawn as a top border on the first handle tool instead of a wrapper.
    ChoiceButton mode { icon: input.icon; action: input.choose; selected: input.selected;
        selection_group: input.group; width: 32; height: 32; classes: input.style; }
}
// One toggle of Houdini's right-hand display bar.
ui DisplayToggle(in ActionBinding toggle, in double icon, in bool selected, in Text style) {
    ToggleButton toggle { icon: input.icon; action: input.toggle; selected: input.selected; width: 28; height: 28; classes: input.style; }
}
// One segment of a Blender header button group (shading, selection mode).
ui HeaderChoice(in ActionBinding choose, in double icon, in bool selected, in Key group, in Text style) {
    ChoiceButton choice { icon: input.icon; action: input.choose; selected: input.selected;
        selection_group: input.group; width: 26; height: 22; classes: input.style; }
}
// Scene view: Blender's semantic header (interaction mode, View/Select/Add/Object,
// pivot, snapping, overlays and shading as grouped widgets) over Houdini's tool
// rail and operation band; passive and interactive annotations float over the scene.
ui SceneViewport(in ActionBinding back, in ActionBinding forward,
                 in double back_icon, in double forward_icon, in double path_icon,
                 in double display_icon, in double guides_icon, in bool display_open, in bool guides_open,
                 in Items<ViewportMode> modes, in double pivot_icon, in bool pivot_open,
                 in Text mode_name, in double mode_icon, in Text basis, in Text pivot_name,
                 in ActionBinding snap, in double snap_icon, in bool snapping, in Text grid_step, in bool snap_open,
                 in bool surface, in ActionBinding surface_toggle, in Text view_name, in bool view_open,
                 in ActionBinding collapse_toggle, in bool collapsed, in double up_icon, in double down_icon,
                 in Text readout, in bool modal, in ActionBinding rail_snap, in Text tool_hint, in Text tool_hint_style,
                 in bool cavity_open, in bool show_fps, in Text fps, in bool camera_flying,
                 in Items<HeaderChoice> shading, in Items<HeaderChoice> select_modes,
                 in bool view_menu_open, in bool select_menu_open, in bool add_menu_open, in bool object_menu_open,
                 in bool actions_open, in bool compact, in Items<DisplayToggle> display_toggles,
                 in double basis_icon, in bool basis_open, in Text path_title) {
    Column pane {
        expand_height: true;
        Row navigation {
            height: 32; gap: 2; padding_left: 4; padding_top: 3; padding_right: 4; padding_bottom: 3;
            align_center: true; classes: "path-bar";
            Button back { icon: input.back_icon; action: input.back; width: 22; height: 24; classes: "path-navigation"; }
            Button forward { icon: input.forward_icon; action: input.forward; width: 22; height: 24; classes: "path-navigation"; }
            Combo path { text: input.path_title; icon: input.path_icon; min_width: 32; shrink_width: 176; height: 24; classes: "pane-path"; }
            Column lead_gap { width: 4; height: 1; }
            Combo actions { icon: input.mode_icon; selected: input.actions_open; width: 34; height: 24; classes: "icon-menu viewport-header-icon"; }
            Combo view_menu { collapsed: input.compact; text: "View"; selected: input.view_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Combo select_menu { collapsed: input.compact; text: "Select"; selected: input.select_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Combo add_menu { collapsed: input.compact; text: "Add"; selected: input.add_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Combo object_menu { collapsed: input.compact; text: "Object"; selected: input.object_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Column header_gap { expand_width: true; height: 1; }
            Combo pivot { icon: input.pivot_icon; selected: input.pivot_open; width: 34; height: 24; classes: "icon-menu viewport-header-icon"; }
            ToggleButton snapping { icon: input.snap_icon; action: input.snap; selected: input.snapping; width: 26; height: 24; classes: "viewport-header-toggle"; }
            Combo step { text: input.grid_step; selected: input.snap_open; content_width: 0; height: 24; classes: "viewport-header-step"; }
            Column overlay_gap { width: 6; height: 1; }
            Combo guides { icon: input.guides_icon; selected: input.guides_open; width: 34; height: 24; classes: "icon-menu viewport-header-icon"; }
            Combo cavity { collapsed: input.compact; text: "Cavity"; content_width: 0; height: 24; selected: input.cavity_open; classes: "viewport-header-step"; }
            Column shading_gap { width: 4; height: 1; }
            Row shading_modes { gap: 0; align_center: true; content_width: 0; classes: "viewport-segment";
                Repeat shading { items: input.shading; }
            }
            Combo display { icon: input.display_icon; selected: input.display_open; width: 16; height: 24; classes: "viewport-header-more"; }
        }
        Row options { height: choose(input.collapsed, 12.0d, 28.0d); wrap: false; classes: "viewport-options";
            ToggleButton stow { action: input.collapse_toggle; icon: choose(input.collapsed, input.down_icon, input.up_icon);
                selected: input.collapsed; min_width: 12; expand_width: input.collapsed; expand_height: true;
                padding_bottom: choose(input.collapsed, 0.0d, 16.0d); classes: "bar-stow"; }
            Text readout { text: input.readout; collapsed: input.collapsed || !input.modal; expand_width: true; expand_height: true;
                padding_left: 10; classes: "viewport-readout"; }
            Row settings { collapsed: input.collapsed || input.modal; expand_width: true; expand_height: true; align_center: true; gap: 6;
                padding_left: 4; padding_right: 6;
                Row selection_modes { gap: 0; align_center: true; content_width: 0; classes: "viewport-segment";
                    Repeat select_modes { items: input.select_modes; }
                }
                Column divider { width: 1; height: 18; classes: "viewport-option-divider"; }
                Combo basis { text: input.basis; icon: input.basis_icon; selected: input.basis_open; content_width: 0; height: 22; classes: "viewport-option-menu"; }
                Text pivot_label { text: input.pivot_name; content_width: 0; single_line: true; classes: "viewport-option-label"; }
                Column divider2 { width: 1; height: 18; classes: "viewport-option-divider"; }
                Checkbox surface { text: "Surface Cursor"; action: input.surface_toggle; selected: input.surface; content_width: 0; height: 22; classes: "viewport-option-check"; }
            }
        }
        Row content { expand_height: true;
            Column edit_tools { width: 38; expand_height: true; gap: 2; padding_top: 6; padding_left: 3; classes: "viewport-rail";
                Repeat modes { items: input.modes; }
                Column snap_separator { height: 1; classes: "viewport-rail-separator"; }
                Column snap_spacing { height: 6; }
                // Houdini keeps snapping beside the handles; here it shares the header toggle.
                ToggleButton rail_snap { icon: input.snap_icon; action: input.rail_snap; selected: input.snapping;
                    width: 32; height: 32; classes: "viewport-mode"; }
            }
            Overlay scene { expand_width: true; expand_height: true;
                Viewport viewport { expand_width: true; expand_height: true; }
                // Houdini closes the scene with a recessed bevel; drawn over the
                // edge so the viewport rectangle and its hit area stay unchanged.
                Column frame { expand_width: true; expand_height: true; enabled: false; classes: "viewport-frame"; }
                Text mode { text: input.mode_name; icon: input.mode_icon; enabled: false;
                    out_of_flow: true; offset_x: 12; offset_y: 10; width: 200; height: 26; classes: "viewport-mode-label"; }
                Text fps { text: input.fps; collapsed: !input.show_fps; enabled: false; single_line: true;
                    out_of_flow: true; offset_x: 12; offset_y: 40; width: 220; classes: "viewport-fps"; }
                Text fly_reticle { text: "+"; collapsed: !input.camera_flying; enabled: false;
                    out_of_flow: true; anchor_x: 0.5; anchor_y: 0.5; pivot_x: 0.5; pivot_y: 0.5;
                    width: 20; height: 20; classes: "viewport-fly-reticle"; }
                // Houdini prints the active tool's mouse bindings on the scene's lower edge.
                Text tool_hint { text: input.tool_hint; enabled: false; out_of_flow: true; anchor_y: 1; pivot_y: 1;
                    offset_x: 12; offset_y: -8; width: 640; height: 20; classes: input.tool_hint_style; }
                Combo camera { text: input.view_name; selected: input.view_open; content_width: 0; height: 22;
                    out_of_flow: true; anchor_x: 1; pivot_x: 1; offset_x: -10; offset_y: 12; classes: "viewport-view-menu"; }
            }
            // Houdini's display bar: view-only toggles mirrored by the header, Guides and the Z pie.
            Column display_bar { width: 34; expand_height: true; gap: 2; padding_top: 6; padding_left: 3; classes: "viewport-rail viewport-display-bar";
                Repeat display_toggles { items: input.display_toggles; }
            }
        }
    }
}
ui PaneTab(in Text title, in bool selected, in Text style, in Text group_style, in Key target) {
    Row group {
        classes: input.group_style; selected: input.selected; flex_width: 44; expand_height: true; wrap: false;
        Tab title { text: input.title; selected: input.selected; context: input.target; classes: input.style; grow_width: 12; expand_height: true; }
        Button close { icon: "close"; selected: input.selected; width: 18; expand_height: true; classes: "dock-close"; }
    }
}
ui PaneSlot(in bool panel) { Column content { expand_height: true; panel: input.panel; } }
ui PaneTabs(in Items<PaneTab> tabs, in Items<PaneSlot> contents, in bool active, in Text strip_style,
            in double maximize_icon) {
    Row strip {
        height: 22; wrap: false; classes: input.strip_style;
        Row tabs { flex_width: 0; expand_height: true; wrap: false; Repeat tab_items { items: input.tabs; } }
        Combo add { icon: "plus"; width: 22; height: 22; context: node.add; classes: "dock-add"; }
        Column gap { height: 22; }
        Button maximize { icon: input.maximize_icon; width: 22; height: 22; enabled: input.active; classes: "dock-tool"; }
        Combo menu { icon: "down"; width: 22; height: 22; context: node.menu; classes: "dock-menu"; }
    }
    Repeat contents { items: input.contents; }
    Text empty {
        text: "Open a view from the pane menu."; caption: true; expand_height: true;
        padding_left: 12; padding_top: 12; padding_right: 12; padding_bottom: 12; collapsed: input.active;
    }
}
ui PaneDivider(in double x, in double y, in double width, in double height, in bool vertical,
               in double value, in double minimum, in double maximum, in double step,
               in double first_icon, in double second_icon, in double grip_icon,
               in bool first_hidden, in bool second_hidden, in Text divider_style, in Text grip_style) {
    Overlay rail {
        width: input.width; height: input.height; out_of_flow: true; offset_x: input.x; offset_y: input.y;
        Splitter track {
            expand_height: true; value: input.value; minimum: input.minimum; maximum: input.maximum;
            step: input.step; vertical: input.vertical; classes: input.divider_style;
        }
        Button first {
            width: rail_button_width(input.vertical, input.width, input.height);
            height: rail_button_height(input.vertical, input.width, input.height);
            out_of_flow: true; anchor_x: 0.5d; anchor_y: 0.5d; pivot_x: 0.5d; pivot_y: 0.5d;
            offset_x: -choose(input.vertical, rail_button_length(input.width), 0.0d);
            offset_y: -choose(input.vertical, 0.0d, rail_button_length(input.height));
            icon: input.first_icon; selected: input.first_hidden; classes: "dock-collapse";
        }
        Splitter grip {
            width: rail_button_width(input.vertical, input.width, input.height);
            height: rail_button_height(input.vertical, input.width, input.height);
            out_of_flow: true; anchor_x: 0.5d; anchor_y: 0.5d; pivot_x: 0.5d; pivot_y: 0.5d;
            value: input.value; minimum: input.minimum; maximum: input.maximum; step: input.step;
            vertical: input.vertical; click_action: true; icon: input.grip_icon; classes: input.grip_style;
        }
        Button second {
            width: rail_button_width(input.vertical, input.width, input.height);
            height: rail_button_height(input.vertical, input.width, input.height);
            out_of_flow: true; anchor_x: 0.5d; anchor_y: 0.5d; pivot_x: 0.5d; pivot_y: 0.5d;
            offset_x: choose(input.vertical, rail_button_length(input.width), 0.0d);
            offset_y: choose(input.vertical, 0.0d, rail_button_length(input.height));
            icon: input.second_icon; selected: input.second_hidden; classes: "dock-collapse";
        }
    }
}
ui DockPane(in double width, in double height, in double x, in double y, in bool split,
            in Items<PaneTab> tabs, in Items<PaneSlot> contents, in bool active, in Text strip_style,
            in double maximize_icon,
            in double divider_x, in double divider_y, in double divider_width, in double divider_height,
            in bool vertical, in double value, in double minimum, in double maximum, in double step,
            in double first_icon, in double second_icon, in double grip_icon,
            in bool first_hidden, in bool second_hidden, in Text divider_style, in Text grip_style) {
    Column pane {
        width: input.width; height: input.height; out_of_flow: true; offset_x: input.x; offset_y: input.y; classes: "dock-pane";
        PaneTabs tabs {
            mounted: !input.split; tabs: input.tabs; contents: input.contents; active: input.active; strip_style: input.strip_style;
            maximize_icon: input.maximize_icon;
        }
        PaneDivider divider {
            mounted: input.split; x: input.divider_x; y: input.divider_y; width: input.divider_width; height: input.divider_height;
            vertical: input.vertical; value: input.value; minimum: input.minimum; maximum: input.maximum; step: input.step;
            first_icon: input.first_icon; second_icon: input.second_icon; grip_icon: input.grip_icon;
            first_hidden: input.first_hidden; second_hidden: input.second_hidden;
            divider_style: input.divider_style; grip_style: input.grip_style;
        }
    }
}
ui DockWorkspace(in Items<DockPane> panes) { Repeat panes { items: input.panes; } }
ui DockPreview(in bool visible, in double x, in double y, in double width, in double height) {
    Column preview { collapsed: !input.visible; enabled: false; out_of_flow: true; offset_x: input.x; offset_y: input.y; width: input.width; height: input.height; classes: "dock-preview"; }
}
ui PopupEntry(in Text title, in Text shortcut, in bool enabled, in bool selected,
              in bool branch, in bool separator, in Text behavior, in Key group,
              in double icon, in double arrow_icon, in Text shortcut_style, in Text heading, in bool has_heading) {
    Column entry {
        Overlay separator {
            height: 14; collapsed: !input.separator; enabled: false;
            Column line { height: 2.0d / 3.0d; out_of_flow: true; anchor_y: 0.5d; pivot_y: 0.5d; enabled: false; classes: "menu-separator"; }
        }
        Text heading { text: input.heading; collapsed: !input.has_heading; enabled: false; single_line: true; caption: true; classes: "menu-heading"; }
        Column row {
            content_height: 25.0d + 1.0d / 3.0d;
            MenuItem item {
                text: input.title; enabled: input.enabled; selected: input.selected; icon: input.icon;
                menu_branch: input.branch; menu_behavior: input.behavior; radio_group: input.group;
                content_height: 25.0d + 1.0d / 3.0d;
            }
            Text shortcut {
                text: input.shortcut; icon: input.arrow_icon; enabled: false; classes: input.shortcut_style;
                content_width: choose(input.branch, 12.0d, 0.0d); expand_height: true;
                out_of_flow: true; anchor_x: 1; pivot_x: 1; offset_x: -10;
            }
        }
    }
}
ui PopupMenu(in Items<PopupEntry> entries) {
    Popup menu {
        width: 280; out_of_flow: true; classes: "menu";
        padding_left: 2.0d / 3.0d; padding_top: 2.0d / 3.0d; padding_right: 2.0d / 3.0d; padding_bottom: 2.0d / 3.0d;
        Repeat entries { items: input.entries; }
    }
}

ui PieEntry(in Text title, in bool enabled, in bool selected, in double x, in double y, in Key group, in Text behavior) {
    MenuItem item {
        text: input.title; enabled: input.enabled; selected: input.selected;
        menu_behavior: input.behavior; radio_group: input.group;
        out_of_flow: true; offset_x: input.x; offset_y: input.y; pivot_x: 0.5d; pivot_y: 0.5d;
        width: 112; height: 28; classes: "pie-item";
    }
}
ui ViewportPie(in double x, in double y, in Text title, in Items<PieEntry> entries) {
    Popup menu {
        width: 360; height: 208; out_of_flow: true; offset_x: input.x; offset_y: input.y; classes: "pie-menu";
        Text hub {
            text: input.title; enabled: false; single_line: true; width: 64;
            out_of_flow: true; anchor_x: 0.5d; anchor_y: 0.5d; pivot_x: 0.5d; pivot_y: 0.5d; classes: "pie-hub";
        }
        Repeat entries { items: input.entries; }
    }
}
ui ColorEditor(in double x, in double y, in double r, in double g, in double b, in double r0, in double g0, in double b0,
               in double hue, in double sat, in double val_norm,
               in EditBinding rgb, in EditBinding hsv, in EditBinding intensity,
               in TextEditBinding hex, in ActionBinding revert, in ActionBinding done) {
    // Houdini/Blender 2D colour editor: interactive SV plane + Hue spectrum bar + HDR intensity
    // slider, live/original split swatch, RGB/HSV tuples and Hex; one undo entry per session.
    Popup editor {
        width: 416; out_of_flow: true; offset_x: input.x; offset_y: input.y; classes: "color-editor";
        padding_left: 8; padding_top: 8; padding_right: 8; padding_bottom: 8;
        Row picker_area { height: 152; gap: 8;
            ColorPlane sv_plane {
                width: 152; expand_height: true; hue: input.hue; value: input.sat; brightness: input.val_norm;
                vertical: false; classes: "color-plane";
            }
            ColorPlane hue_bar {
                width: 18; expand_height: true; hue: input.hue; vertical: true; classes: "color-plane";
            }
            Column side { expand_width: true; expand_height: true; gap: 6;
                Row preview { height: 42; gap: 1;
                    Column current { expand_width: true; expand_height: true; red: input.r; green: input.g; blue: input.b; classes: "color-swatch"; }
                    Button original {
                        text: ""; action: input.revert; expand_width: true; expand_height: true;
                        red: input.r0; green: input.g0; blue: input.b0; classes: "color-swatch color-original";
                        tooltip_title: "Revert to Original"; tooltip_identity: "Color Picker";
                        tooltip: "恢复为打开拾色器之前的原始颜色值。";
                    }
                }
                Row hex_row { gap: 4; align_center: true; height: 24;
                    Text hex_label { text: "Hex #"; width: 40; single_line: true; classes: "field-label"; }
                    TextField hex { edit: input.hex; context: input.hex; placeholder: "RRGGBB"; expand_width: true; height: 22; }
                }
                Column side_spacer { expand_height: true; }
                Text hint {
                    text: "2D plane: Saturation / Value\nSpectrum bar: Hue (0°–360°)";
                    caption: true;
                }
            }
        }
        Column fields { gap: 4; padding_top: 8;
            NumberRow rgb { text: "RGB"; edit: input.rgb; }
            NumberRow hsv { text: "HSV"; edit: input.hsv; }
            NumberRow intensity { text: "Intensity (V)"; edit: input.intensity; }
        }
        Row actions { height: 28; padding_top: 6; gap: 6; align_center: true;
            Button revert_btn { text: "Revert"; action: input.revert; height: 22; content_width: 0; min_width: 64; classes: "ghost-button"; }
            Column spacer { expand_width: true; height: 1; }
            Button done { text: "Done"; action: input.done; height: 22; content_width: 0; min_width: 72; }
        }
    }
}
ui WorkbenchRgb(in EditBinding color) { NumberRow color { text: "Color"; edit: input.color; } }
ui WorkbenchChannels(in EditBinding red, in EditBinding green, in EditBinding blue) {
    NumberRow red { text: "Red"; edit: input.red; }
    NumberRow green { text: "Green"; edit: input.green; }
    NumberRow blue { text: "Blue"; edit: input.blue; }
}
ui Controls(in TextEditBinding name, in bool name_modified, in bool disabled, in bool long_labels,
            in bool expanded, in bool general, in bool rgb_selected, in bool color_expanded,
            in bool enabled, in bool enabled_modified, in Text mode, in bool mode_modified,
            in EditBinding position, in EditBinding exposure, in EditBinding vector4,
            in EditBinding color, in EditBinding red, in EditBinding green, in EditBinding blue,
            in double r, in double g, in double b, in bool can_reset, in Text history, in Text position_title, in Text exposure_title,
            in TextEditBinding filter, in bool filter_empty, in ActionBinding clear_filter,
            in TextEditBinding readonly_id, in TextEditBinding readonly_summary,
            in double hue, in double sat, in double val_norm,
            in bool readonly_expanded, in bool show_options, in bool show_transform_group,
            in bool show_position, in bool show_exposure, in bool show_enabled, in bool show_vector4, in bool show_projection,
            in bool show_readonly_group, in bool show_readonly_id, in bool show_readonly_summary, in bool no_matches) {
    Row header {
        classes: "object-header"; height: 30; gap: 4; align_center: true; padding_left: 6; padding_right: 4;
        Text type { text: "Sample"; icon: "sliders"; content_width: 0; single_line: true; classes: "object-type"; }
        TextField name { edit: input.name; context: input.name; modified: input.name_modified; min_width: 32; height: 22; classes: "object-name"; }
    }
    Column pages {
        expand_height: true;
        Row tabs {
            height: 26; gap: 2; padding_left: 4; padding_right: 4; classes: "subtab-bar";
            ChoiceButton general { text: "Parameters"; selected: input.general; selection_group: node.tabs; expand_height: true; classes: "subtab-item"; }
            ChoiceButton appearance { text: "Appearance"; selected: !input.general; selection_group: node.tabs; expand_height: true; classes: "subtab-item"; }
        }
        Column search_bar {
            classes: "parameter-search"; collapsed: !input.general;
            SearchBox sample_search {
                edit: input.filter; placeholder: "Filter showcase controls...";
                clear_collapsed: input.filter_empty; clear: input.clear_filter;
            }
        }
        List scroll {
            expand_height: true; gap: 1; classes: "parameter-list";
            Column general_body {
                gap: 1; collapsed: !input.general;
                Column options {
                    gap: 4; collapsed: !input.show_options; classes: "section-body";
                    Checkbox disable { text: "Disable sample fields"; selected: input.disabled; height: 22; expand_width: true; }
                    Checkbox long_labels { text: "Show long labels"; selected: input.long_labels; height: 22; expand_width: true; }
                }
                Foldout fold { text: "Transform and display"; icon: "axes"; selected: input.expanded; collapsed: !input.show_transform_group; height: 22; classes: "section"; }
                Column body {
                    gap: 3; collapsed: !input.expanded || !input.show_transform_group; enabled: !input.disabled; classes: "section-body";
                    NumberRow position { text: input.position_title; edit: input.position; collapsed: !input.show_position; }
                    NumberRow exposure { text: input.exposure_title; edit: input.exposure; collapsed: !input.show_exposure; }
                    ParameterRow enabled_row {
                        text: "Enabled"; modified: input.enabled_modified; collapsed: !input.show_enabled;
                        Checkbox enabled { text: "Active"; selected: input.enabled; modified: input.enabled_modified; height: 22; content_width: 0; }
                    }
                    NumberRow vector4 { text: "Vector4"; edit: input.vector4; collapsed: !input.show_vector4; }
                    ParameterRow projection {
                        text: "Projection"; modified: input.mode_modified; collapsed: !input.show_projection;
                        Combo mode { text: input.mode; modified: input.mode_modified; height: 22; content_width: 112; }
                    }
                }
                Foldout readonly_fold { text: "Read-only observability"; icon: "copy"; selected: input.readonly_expanded; collapsed: !input.show_readonly_group; height: 22; classes: "section"; }
                Column readonly_body {
                    gap: 3; collapsed: !input.readonly_expanded || !input.show_readonly_group; classes: "section-body";
                    ParameterRow readonly_row {
                        text: "Object URI"; collapsed: !input.show_readonly_id;
                        TextField readonly_id { edit: input.readonly_id; context: input.readonly_id; read_only: true; expand_width: true; height: 21; classes: "readonly-field"; }
                    }
                    ParameterRow summary_row {
                        text: "Live digest"; collapsed: !input.show_readonly_summary;
                        TextField readonly_summary { edit: input.readonly_summary; context: input.readonly_summary; read_only: true; expand_width: true; height: 21; classes: "readonly-inline"; }
                    }
                }
                Text empty_filter { text: "No matching controls."; caption: true; collapsed: !input.no_matches; classes: "empty-state"; }
            }
            Column appearance_body {
                collapsed: input.general; enabled: !input.disabled;
                Row color_tabs_bar {
                    height: 28; padding_left: 6; padding_right: 6; align_center: true; classes: "path-bar";
                    Row color_tabs {
                        height: 22; gap: 1; padding_left: 1.5; padding_top: 1.5; padding_right: 1.5; padding_bottom: 1.5;
                        align_center: true; content_width: 0; classes: "segmented-switch";
                        ChoiceButton rgb { text: "Color"; selected: input.rgb_selected; selection_group: node.color_tabs; height: 19; classes: "segmented-item"; }
                        ChoiceButton channels { text: "Channels"; selected: !input.rgb_selected; selection_group: node.color_tabs; height: 19; classes: "segmented-item"; }
                    }
                }
                Column nested {
                    gap: 1; classes: "parameter-nested-body";
                    Row swatch_row {
                        gap: 8; classes: "section-body";
                        ColorPlane sv_plane {
                            hue: input.hue; value: input.sat; brightness: input.val_norm;
                            vertical: false; width: 128; height: 112; classes: "color-plane";
                        }
                        ColorPlane hue_bar {
                            hue: input.hue; vertical: true;
                            width: 16; height: 112; classes: "color-plane";
                        }
                        Column swatch { expand_width: true; height: 112; red: input.r; green: input.g; blue: input.b; classes: "color-swatch"; }
                    }
                    Foldout color_fold { text: "Color components"; icon: "sliders"; selected: input.color_expanded; height: 22; classes: "section"; }
                    Column color_body {
                        gap: 3; collapsed: !input.color_expanded; classes: "section-body";
                        WorkbenchRgb rgb_fields { mounted: input.rgb_selected; color: input.color; }
                        WorkbenchChannels channel_fields { mounted: !input.rgb_selected; red: input.red; green: input.green; blue: input.blue; }
                    }
                    Text preview { text: "Preview"; height: 24; classes: "parameter-section"; }
                    Text explanation { text: "2D Saturation/Value plane, Hue spectrum bar and RGB channels share one color; Undo restores the previous color."; caption: true; classes: "section-body"; }
                }
            }
            Column footer {
                gap: 5; classes: "section-body";
                Button reset { text: "Reset sample values"; enabled: input.can_reset; height: 24; expand_width: true; }
                Text history { text: input.history; caption: true; }
                Text gestures { text: "Middle drag: value ladder · Drag select + Ctrl+C: copy read-only\nCtrl + middle: defaults · Esc: cancel"; caption: true; }
            }
        }
    }
}


ui CodeFileTab(in Text title, in bool selected, in ActionBinding select_file, in ActionBinding close_file) {
    Row tab_box {
        selected: input.selected; flex_width: 52; expand_height: true; align_center: true; wrap: false;
        padding_left: 4; padding_right: 2; gap: 1; classes: "code-tab-item";
        Button select_btn {
            text: input.title; icon: "source_file"; selected: input.selected; action: input.select_file;
            flex_width: 26; height: 22; classes: "code-tab-btn";
        }
        Button close_btn {
            icon: "close"; selected: input.selected; action: input.close_file; width: 17; height: 18; classes: "dock-close";
            tooltip_title: "Close Document"; tooltip_identity: "Source Editor"; tooltip: "关闭此源码文档标签页。";
        }
    }
}

ui CodeCompletionItem(in Text badge, in Text badge_style, in Text title, in Text detail,
                      in bool active_row, in ActionBinding pick, in Text row_style) {
    Row row {
        height: 22; gap: 6; padding_left: 5; padding_right: 6; align_center: true; wrap: false; classes: input.row_style;
        Text kind_badge { text: input.badge; width: 34; single_line: true; classes: input.badge_style; }
        Button pick_btn { text: input.title; selected: input.active_row; action: input.pick; expand_width: true; height: 20; classes: "code-completion-btn"; }
        Text sig_txt { text: input.detail; content_width: 0; single_line: true; caption: true; classes: "code-completion-detail"; }
    }
}

ui CodePanel(in CodeBinding document, in bool conflict, in Key file_menu, in Key outline_menu,
             in ActionBinding open, in ActionBinding save, in ActionBinding reload, in ActionBinding create,
             in ActionBinding build, in ActionBinding run, in ActionBinding stop,
             in bool running, in bool has_files, in Items<CodeFileTab> open_tabs,
             in Text breadcrumb_path, in Text breadcrumb_symbol,
             in ActionBinding nav_back, in ActionBinding nav_forward,
             in bool find_open, in ActionBinding toggle_find,
             in bool problems_open, in ActionBinding toggle_problems,
             in bool search_bar_visible, in bool find_mode, in bool replace_mode, in bool goto_mode,
             in TextEditBinding find_edit, in TextEditBinding replace_edit, in TextEditBinding goto_edit,
             in Text match_count, in bool match_case, in ActionBinding toggle_case,
             in bool whole_word, in ActionBinding toggle_word,
             in ActionBinding prev_match, in ActionBinding next_match,
             in ActionBinding replace_one, in ActionBinding replace_all,
             in ActionBinding goto_commit, in ActionBinding close_search,
             in bool comp_open, in double comp_x, in double comp_y, in Items<CodeCompletionItem> comp_items,
             in bool comp_has_doc, in Text comp_doc,
             in bool sig_open, in double sig_x, in double sig_y,
             in Text sig_prefix, in Text sig_active, in Text sig_suffix,
             in bool hover_open, in double hover_x, in double hover_y,
             in Text hover_header, in Text hover_body,
             in TableBinding problems_model, in ActionBinding problem_jump,
             in Text diag_summary, in Text diag_badge_style,
             in Text build_status, in Text cursor_status, in ActionBinding open_goto, in Text meta_status) {
    Row doc_bar {
        height: 28; gap: 2; padding_left: 2; padding_right: 4; align_center: true; wrap: false; classes: "code-tab-bar";
        Row tabs_area {
            flex_width: 0; expand_height: true; wrap: false; collapsed: !input.has_files;
            Repeat tabs { items: input.open_tabs; }
        }
        Text empty_tab {
            text: "No open source document"; collapsed: input.has_files;
            content_width: 0; single_line: true; classes: "code-empty-tab";
        }
        Combo all_files {
            icon: "down"; context: input.file_menu; collapsed: !input.has_files;
            width: 22; height: 22; classes: "dock-menu";
            tooltip_title: "Open Editors"; tooltip_identity: "Source Editor"; tooltip: "列出并快速切换当前打开的全部文档。";
        }
        Button create {
            icon: "plus"; width: 23; height: 22; action: input.create; classes: "ghost-tool";
            tooltip_title: "New Component"; tooltip_identity: "Source Authoring"; tooltip: "在当前工程 Source 目录新建业务组件源码文件。";
        }
        Button open {
            icon: "folder"; width: 23; height: 22; action: input.open; classes: "ghost-tool";
            tooltip_title: "Open Source File..."; tooltip_identity: "File I/O"; tooltip: "从工程或磁盘打开 UTF-8 源码、UI 声明或样式表文件。";
        }
        Button save {
            icon: "save"; width: 23; height: 22; action: input.save; classes: "ghost-tool";
            tooltip_title: "Save File [Ctrl+S]"; tooltip_identity: "File I/O"; tooltip: "保存当前活动源码文档到磁盘。";
        }
        Column top_spacer { expand_width: true; height: 1; }
        Button build {
            text: "Build"; icon: "build"; action: input.build; height: 22; content_width: 0; classes: "ghost-button";
            tooltip_title: "Build Project Source [F6]"; tooltip_identity: "JIT Compiler"; tooltip: "编译并验证当前工程中的全部业务语言与 UI 模块。";
        }
        Button run {
            text: "Run"; icon: "play"; action: input.run; collapsed: input.running; height: 22; content_width: 0; classes: "ghost-button";
            tooltip_title: "Start Play [F8]"; tooltip_identity: "Project Runner"; tooltip: "启动独立子进程运行当前场景与工程代码。";
        }
        Button stop {
            text: "Stop"; icon: "stop"; action: input.stop; collapsed: !input.running; height: 22; content_width: 0; classes: "ghost-button";
            tooltip_title: "Stop Play [Shift+F8]"; tooltip_identity: "Project Runner"; tooltip: "终止正在运行的场景预览子进程。";
        }
    }
    Row breadcrumb_bar {
        height: 24; gap: 3; padding_left: 4; padding_right: 4; align_center: true; wrap: false;
        collapsed: !input.has_files; classes: "code-breadcrumb-bar";
        Button back_btn {
            icon: "back"; action: input.nav_back; width: 20; height: 20; classes: "ghost-tool";
            tooltip_title: "Navigate Back"; tooltip_identity: "Code Navigation"; tooltip: "返回上一次定义跳转前的代码位置。";
        }
        Button fwd_btn {
            icon: "forward"; action: input.nav_forward; width: 20; height: 20; classes: "ghost-tool";
            tooltip_title: "Navigate Forward"; tooltip_identity: "Code Navigation"; tooltip: "前进到下一个历史代码位置。";
        }
        Text path_crumb { text: input.breadcrumb_path; content_width: 0; single_line: true; classes: "code-breadcrumb-path"; }
        Text crumb_sep { text: "›"; content_width: 0; single_line: true; classes: "code-breadcrumb-sep"; }
        Combo outline_combo {
            text: input.breadcrumb_symbol; icon: "component"; context: input.outline_menu;
            min_width: 64; shrink_width: 240; height: 20; classes: "pane-path code-outline-combo";
            tooltip_title: "Document Symbol Outline"; tooltip_identity: "Code Intelligence";
            tooltip: "显示当前光标所在的类/方法/组件，点击展开当前文件符号大纲直接跳转。";
        }
        Column crumb_spacer { expand_width: true; height: 1; }
        ToggleButton find_btn {
            icon: "search"; selected: input.find_open; action: input.toggle_find;
            width: 22; height: 20; classes: "ghost-tool";
            tooltip_title: "Find & Replace [Ctrl+F / Ctrl+H]"; tooltip_identity: "Code Search";
            tooltip: "展开或收起内联查找与替换栏。";
        }
        ToggleButton problems_btn {
            icon: "warning"; selected: input.problems_open; action: input.toggle_problems;
            width: 22; height: 20; classes: "ghost-tool";
            tooltip_title: "Problems Drawer"; tooltip_identity: "Live Diagnostics";
            tooltip: "展开或收起实时诊断问题列表抽屉。";
        }
    }
    Column find_bar {
        collapsed: !input.search_bar_visible; padding_left: 6; padding_right: 6; padding_top: 3; padding_bottom: 3; gap: 3;
        classes: "code-find-bar";
        Row find_row {
            height: 23; gap: 4; align_center: true; wrap: false; collapsed: !input.find_mode;
            TextField find_box { edit: input.find_edit; context: input.find_edit; shrink_width: 210; min_width: 80; height: 21; }
            ToggleButton case_btn {
                text: "Aa"; selected: input.match_case; action: input.toggle_case; width: 24; height: 21; classes: "ghost-tool code-find-opt";
                tooltip_title: "Match Case"; tooltip_identity: "Find Option"; tooltip: "区分大小写匹配。";
            }
            ToggleButton word_btn {
                text: "ab"; selected: input.whole_word; action: input.toggle_word; width: 24; height: 21; classes: "ghost-tool code-find-opt";
                tooltip_title: "Match Whole Word"; tooltip_identity: "Find Option"; tooltip: "全字匹配标识符边界。";
            }
            Button prev_btn {
                icon: "up"; action: input.prev_match; width: 21; height: 21; classes: "ghost-tool";
                tooltip_title: "Previous Match [Shift+F3]"; tooltip_identity: "Code Search"; tooltip: "跳转到上一个匹配项。";
            }
            Button next_btn {
                icon: "down"; action: input.next_match; width: 21; height: 21; classes: "ghost-tool";
                tooltip_title: "Next Match [F3]"; tooltip_identity: "Code Search"; tooltip: "跳转到下一个匹配项。";
            }
            Text match_lbl { text: input.match_count; content_width: 0; single_line: true; classes: "code-find-count"; }
            Column find_spacer { expand_width: true; height: 1; }
            Button close_find { icon: "close"; action: input.close_search; width: 21; height: 21; classes: "ghost-tool"; }
        }
        Row replace_row {
            height: 23; gap: 4; align_center: true; wrap: false; collapsed: !input.replace_mode;
            TextField replace_box { edit: input.replace_edit; context: input.replace_edit; shrink_width: 210; min_width: 80; height: 21; }
            Button rep_one { text: "Replace"; action: input.replace_one; height: 21; content_width: 0; classes: "ghost-button"; }
            Button rep_all { text: "Replace All"; action: input.replace_all; height: 21; content_width: 0; classes: "ghost-button"; }
        }
        Row goto_row {
            height: 23; gap: 4; align_center: true; wrap: false; collapsed: !input.goto_mode;
            Text goto_lbl { text: "Go to Line[:Col]"; content_width: 0; single_line: true; classes: "code-find-count"; }
            TextField goto_box { edit: input.goto_edit; context: input.goto_edit; shrink_width: 140; min_width: 64; height: 21; }
            Button goto_btn { text: "Jump"; action: input.goto_commit; height: 21; content_width: 0; classes: "ghost-button"; }
            Column goto_spacer { expand_width: true; height: 1; }
            Button close_goto { icon: "close"; action: input.close_search; width: 21; height: 21; classes: "ghost-tool"; }
        }
    }
    Row conflict {
        height: 26; gap: 6; padding_left: 8; padding_right: 6; align_center: true;
        collapsed: !input.conflict; classes: "conflict-banner";
        Text message {
            text: "External changes detected on disk"; icon: "warning";
            flex_width: 1; single_line: true; classes: "conflict-text";
        }
        Button reload {
            text: "Reload from Disk"; icon: "reload"; action: input.reload;
            height: 21; content_width: 0; classes: "ghost-button";
            tooltip_title: "Reload from Disk"; tooltip_identity: "Conflict Resolution";
            tooltip: "丢弃当前未保存内存修改，重新加载磁盘最新文件内容。";
        }
    }
    Overlay editor_stack {
        expand_height: true; expand_width: true;
        CodeEditor buffer { document: input.document; expand_height: true; expand_width: true; classes: "source-code"; }
        Row sig_popup {
            out_of_flow: true; offset_x: input.sig_x; offset_y: input.sig_y;
            collapsed: !input.sig_open; enabled: false; content_width: 0; height: 23;
            padding_left: 7; padding_right: 7; gap: 0; align_center: true; wrap: false;
            classes: "code-signature-popup";
            Text sig_pre { text: input.sig_prefix; content_width: 0; single_line: true; classes: "code-sig-text"; }
            Text sig_act { text: input.sig_active; content_width: 0; single_line: true; classes: "code-sig-active"; }
            Text sig_suf { text: input.sig_suffix; content_width: 0; single_line: true; classes: "code-sig-text"; }
        }
        Column comp_popup {
            width: 344; out_of_flow: true; offset_x: input.comp_x; offset_y: input.comp_y;
            collapsed: !input.comp_open; panel: true; padding_left: 2; padding_right: 2; padding_top: 2; padding_bottom: 2; gap: 1;
            classes: "code-completion-popup";
            Column comp_list { gap: 0; Repeat comp_rows { items: input.comp_items; } }
            Text comp_doc_box {
                text: input.comp_doc; collapsed: !input.comp_has_doc; content_height: 0;
                padding_left: 6; padding_right: 6; padding_top: 4; padding_bottom: 4; caption: true;
                classes: "code-completion-doc";
            }
        }
        Column hover_popup {
            width: 356; out_of_flow: true; offset_x: input.hover_x; offset_y: input.hover_y;
            collapsed: !input.hover_open; enabled: false; content_height: 0;
            padding_left: 8; padding_right: 8; padding_top: 5; padding_bottom: 6; gap: 3;
            classes: "code-hover-card";
            Text hover_hdr { text: input.hover_header; content_height: 0; classes: "code-hover-header"; }
            Text hover_txt { text: input.hover_body; content_height: 0; caption: true; classes: "code-hover-body"; }
        }
    }
    Column problems_pane {
        height: 118; collapsed: !input.problems_open; classes: "code-problems-pane";
        Table problems_table {
            model: input.problems_model; action: input.problem_jump; expand_height: true; view: "details";
            empty_text: "No compiler or syntax problems in active buffer.";
            row_height: 21; header_height: 22; classes: "data-table";
        }
    }
    Row status_bar {
        height: 22; gap: 8; padding_left: 4; padding_right: 6; align_center: true; wrap: false; classes: "code-status-bar";
        Button problem {
            text: input.diag_summary; icon: "warning"; action: input.toggle_problems;
            height: 19; content_width: 0; classes: input.diag_badge_style;
            tooltip_title: "Toggle Problems Drawer"; tooltip_identity: "Live Diagnostics";
            tooltip: "查看或定位当前源码与工程的实时编译诊断信息。";
        }
        Text build_txt { text: input.build_status; content_width: 0; single_line: true; classes: "source-status"; }
        Column status_spacer { expand_width: true; height: 1; }
        Button cursor_btn {
            text: input.cursor_status; action: input.open_goto; height: 19; content_width: 0; classes: "code-status-item";
            tooltip_title: "Go to Line / Column [Ctrl+G]"; tooltip_identity: "Navigation";
            tooltip: "点击打开行号快速跳转栏。";
        }
        Text meta_txt { text: input.meta_status; content_width: 0; single_line: true; classes: "code-status-meta"; }
    }
}

ui ProjectOutput(in TableBinding output, in CodeBinding document, in TextEditBinding category, in TextEditBinding search,
                 in bool search_empty, in ActionBinding clear_search,
                 in Text level, in Text err_badge, in Text warn_badge,
                 in Text health, in bool health_open, in double health_height, in ActionBinding toggle_health, in double health_icon,
                 in TextEditBinding detail, in bool empty, in bool selected,
                 in double list_height, in double split_ratio, in double split_min, in double split_max, in double split_step,
                 in ActionBinding next_level, in ActionBinding clear, in ActionBinding locate, in ActionBinding open_directory,
                 in Text empty_text) {
    Row filters {
        height: 30; gap: 4; padding_left: 4; padding_right: 4; align_center: true; classes: "output-toolbar";
        Button level {
            text: input.level; icon: "filter"; action: input.next_level; content_width: 0; min_width: 84; height: 22; classes: "filter-selector";
            tooltip_title: "Cycle Minimum Severity"; tooltip_identity: "Output Filter"; tooltip: "按严重级别过滤日志（All / Debug+ / Info+ / Warn+ / Error+ / Critical）。";
        }
        Text errs { text: input.err_badge; content_width: 0; single_line: true; classes: "badge-error"; }
        Text warns { text: input.warn_badge; content_width: 0; single_line: true; classes: "badge-warn"; }
        Column sep1 { width: 1; height: 16; classes: "viewport-option-divider"; }
        TextField category {
            edit: input.category; context: input.category; placeholder: "Category...";
            shrink_width: 112; min_width: 48; height: 22;
        }
        Column search_wrap {
            expand_width: true; min_width: 72;
            SearchBox search_box {
                edit: input.search; placeholder: "Search log messages & codes...";
                clear_collapsed: input.search_empty; clear: input.clear_search;
            }
        }
        Button clear {
            text: "Reset"; action: input.clear; content_width: 0; height: 22; classes: "ghost-button";
            tooltip_title: "Reset Filters"; tooltip_identity: "Output Filter"; tooltip: "恢复全部日志级别、分类与关键字筛选条件。";
        }
        ToggleButton health_btn {
            icon: input.health_icon; selected: input.health_open; action: input.toggle_health;
            width: 24; height: 22; classes: "ghost-tool";
            tooltip_title: "Stream & Reader Health"; tooltip_identity: "Log Telemetry";
            tooltip: "展开或收起后台 JSONL 读取器、缓存容量、丢包与运行流健康度诊断抽屉。";
        }
        Button logs {
            icon: "folder"; action: input.open_directory; width: 24; height: 22; classes: "ghost-tool";
            tooltip_title: "Open Run Log Directory"; tooltip_identity: "Log Storage";
            tooltip: "在系统资源管理器中打开当前选中记录或宿主的原始日志目录。";
        }
    }
    List health_scroll {
        collapsed: !input.health_open; height: input.health_height; classes: "output-health-drawer";
        Text health { text: input.health; content_height: 0; padding_left: 6; padding_right: 6; caption: true; }
    }
    Overlay list { height: input.list_height;
        Table messages { model: input.output; expand_height: true; view: "details"; row_height: 21; header_height: 23; classes: "data-table"; }
        Text empty { text: input.empty_text; collapsed: !input.empty; enabled: false;
            out_of_flow: true; offset_y: 28; padding_left: 8; height: 36; caption: true; }
    }
    Splitter split {
        collapsed: !input.selected; height: 5; vertical: true;
        value: input.split_ratio; minimum: input.split_min; maximum: input.split_max; step: input.split_step;
        classes: "dock-divider horizontal";
    }
    Column detail_pane {
        collapsed: !input.selected; expand_height: true; classes: "output-detail-pane";
        Row detail_header { height: 26; gap: 4; padding_left: 6; padding_right: 4; align_center: true; classes: "path-bar";
            TextField detail { edit: input.detail; context: input.detail; read_only: true; expand_width: true; min_width: 32; height: 21; classes: "readonly-inline source-status"; }
            Button locate {
                text: "Locate"; icon: "source_file"; action: input.locate; content_width: 0; height: 21; classes: "ghost-button";
                tooltip_title: "Locate in Source Editor"; tooltip_identity: "Source Mapping";
                tooltip: "跳转到产生此条日志的原始源码文件与精确行列位置。";
            }
        }
        CodeEditor body { document: input.document; expand_height: true; classes: "source-code"; }
    }
}

ui GeometrySpreadsheet(in TableBinding model, in TextEditBinding filter, in bool filter_empty, in ActionBinding clear_filter,
                       in Text target,
                       in bool follow_selected, in ActionBinding follow_action,
                       in Text points_title, in Text vertices_title, in Text primitives_title,
                       in Text detail_title, in Text instances_title,
                       in bool points_sel, in bool vertices_sel, in bool primitives_sel,
                       in bool detail_sel, in bool instances_sel,
                       in Text range_text, in bool paged, in ActionBinding prev_page, in ActionBinding next_page,
                       in Text empty_text) {
    Column pane {
        expand_height: true;
        Row toolbar {
            height: 28; gap: 5; padding_left: 5; padding_right: 5; align_center: true; classes: "path-bar";
            Row layers {
                height: 23; gap: 1; padding_left: 1.5; padding_top: 1.5; padding_right: 1.5; padding_bottom: 1.5;
                align_center: true; content_width: 0; classes: "segmented-switch";
                ChoiceButton points { text: input.points_title; selected: input.points_sel; selection_group: node.layers; height: 20; content_width: 0; classes: "segmented-item"; }
                ChoiceButton vertices { text: input.vertices_title; selected: input.vertices_sel; selection_group: node.layers; height: 20; content_width: 0; classes: "segmented-item"; }
                ChoiceButton primitives { text: input.primitives_title; selected: input.primitives_sel; selection_group: node.layers; height: 20; content_width: 0; classes: "segmented-item"; }
                ChoiceButton detail { text: input.detail_title; selected: input.detail_sel; selection_group: node.layers; height: 20; content_width: 0; classes: "segmented-item"; }
                ChoiceButton instances { text: input.instances_title; selected: input.instances_sel; selection_group: node.layers; height: 20; content_width: 0; classes: "segmented-item"; }
            }
            Column spacer { expand_width: true; height: 1; }
            Text target_label { text: input.target; content_width: 0; single_line: true; caption: true; }
            ToggleButton follow {
                icon: "pin"; selected: !input.follow_selected; action: input.follow_action; width: 24; height: 22; classes: "ghost-tool";
                tooltip_title: "Pin to Display Node"; tooltip_identity: "Geometry Spreadsheet";
                tooltip: "锁定电子表格目标：默认未锁定时实时跟随画布中选中的节点；点击钉住后始终锁定检视 Display Flag 节点输出。";
            }
        }
        Row filter_bar {
            height: 26; gap: 6; padding_left: 6; padding_right: 6; align_center: true; classes: "browser-toolbar";
            Column search_col {
                expand_width: true; min_width: 64;
                SearchBox attr_search {
                    edit: input.filter; placeholder: "Filter attributes (e.g. P N uv)...";
                    clear_collapsed: input.filter_empty; clear: input.clear_filter;
                }
            }
            Button prev_page {
                icon: "left"; action: input.prev_page; collapsed: !input.paged; width: 22; height: 22; classes: "ghost-tool";
                tooltip_title: "Previous Page"; tooltip_identity: "Spreadsheet Paging"; tooltip: "翻到上一页元素数据。";
            }
            Text range_info { text: input.range_text; content_width: 0; single_line: true; caption: true; }
            Button next_page {
                icon: "right"; action: input.next_page; collapsed: !input.paged; width: 22; height: 22; classes: "ghost-tool";
                tooltip_title: "Next Page"; tooltip_identity: "Spreadsheet Paging"; tooltip: "翻到下一页元素数据。";
            }
        }
        Table table {
            model: input.model;
            expand_height: true;
            view: "details";
            empty_text: input.empty_text;
            row_height: 21;
            header_height: 23;
            classes: "data-table";
        }
    }
}

ui NetworkTabItem(in Text title, in Text badge, in bool active_row, in ActionBinding pick, in Text row_style) {
    Row row {
        height: 24; gap: 4; padding_left: 4; padding_right: 4; align_center: true; classes: input.row_style;
        Button pick_btn { text: input.title; selected: input.active_row; action: input.pick; expand_width: true; height: 22; classes: "network-node-btn"; }
        Text badge_txt { text: input.badge; content_width: 0; single_line: true; caption: true; }
    }
}

ui NetworkPanel(in Text graph_title, in double path_icon, in ActionBinding back, in ActionBinding forward,
                in double back_icon, in double forward_icon,
                in bool locked, in double lock_icon, in ActionBinding lock_action,
                in bool pinned, in double pin_icon, in ActionBinding pin_action,
                in bool isolated, in double isolate_icon, in ActionBinding isolate_action,
                in bool has_graph, in bool compact,
                in bool add_menu_open, in bool edit_menu_open, in bool view_menu_open, in bool layout_menu_open,
                in Text cook_summary, in Text cook_summary_style,
                in ActionBinding scratch_action,
                in ActionBinding add_action, in double add_icon,
                in ActionBinding note_action, in double note_icon,
                in ActionBinding box_action, in double box_icon,
                in bool color_open, in ActionBinding color_action, in double color_icon,
                in bool shape_open, in ActionBinding shape_action, in double shape_icon,
                in bool info_open, in ActionBinding info_action, in double info_icon,
                in ActionBinding layout_action, in double layout_icon,
                in ActionBinding frame_action, in double frame_icon,
                in Text zoom_text, in ActionBinding zoom_action,
                in bool seed_selected, in ActionBinding settings_action, in double settings_icon,
                in ActionBinding delete_action, in double delete_icon,
                in bool tab_open, in double tab_x, in double tab_y,
                in TextEditBinding tab_query, in Items<NetworkTabItem> tab_items,
                in Text status_text) {
    Column pane {
        expand_height: true; panel: true; classes: "parameter-pane";
        Row toolbar {
            height: 32; gap: 2; padding_left: 4; padding_top: 3; padding_right: 4; padding_bottom: 3;
            align_center: true; classes: "path-bar";
            Button back { icon: input.back_icon; action: input.back; width: 22; height: 24; classes: "path-navigation"; }
            Button forward { icon: input.forward_icon; action: input.forward; width: 22; height: 24; classes: "path-navigation"; }
            Combo path { text: input.graph_title; icon: input.path_icon; expand_width: true; min_width: 40; height: 24; classes: "pane-path"; }
            Column path_gap { width: 2; height: 1; }
            ToggleButton lock_btn { collapsed: !input.has_graph; icon: input.lock_icon; action: input.lock_action; selected: input.locked; width: 26; height: 24; classes: "ghost-tool"; }
            ToggleButton pin_btn { icon: input.pin_icon; action: input.pin_action; selected: input.pinned; width: 26; height: 24; classes: "ghost-tool"; }
            ToggleButton isolate_btn { icon: input.isolate_icon; action: input.isolate_action; selected: input.isolated; width: 26; height: 24; classes: "ghost-tool"; }
        }
        Row action_bar {
            height: 28; gap: 2; padding_left: 4; padding_right: 4; align_center: true; wrap: false; classes: "viewport-options";
            Combo add_menu { text: "Add"; selected: input.add_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Combo edit_menu { collapsed: !input.has_graph; text: "Edit"; selected: input.edit_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Combo view_menu { collapsed: !input.has_graph; text: "View"; selected: input.view_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Combo layout_menu { collapsed: !input.has_graph || input.compact; text: "Layout"; selected: input.layout_menu_open; content_width: 0; height: 24; classes: "viewport-header-menu"; }
            Column empty_spacer { collapsed: input.has_graph; expand_width: true; height: 1; }
            Button scratch { text: "+ Scratch Graph"; action: input.scratch_action; collapsed: input.has_graph; height: 24; content_width: 0; classes: "ghost-button"; }
            Text cook_readout { text: input.cook_summary; collapsed: !input.has_graph || input.compact; expand_width: true; min_width: 24; single_line: true; classes: input.cook_summary_style; }
            Column compact_spacer { collapsed: !input.has_graph || !input.compact; expand_width: true; height: 1; }
            Button add_node { collapsed: !input.has_graph; icon: input.add_icon; action: input.add_action; width: 24; height: 24; classes: "ghost-tool"; }
            Button note_btn { collapsed: !input.has_graph; icon: input.note_icon; action: input.note_action; width: 24; height: 24; classes: "ghost-tool"; }
            Button box_btn { collapsed: !input.has_graph; icon: input.box_icon; action: input.box_action; width: 24; height: 24; classes: "ghost-tool"; }
            Column div_style { collapsed: !input.has_graph || input.compact; width: 1; height: 15; classes: "viewport-option-divider"; }
            ToggleButton color_btn { collapsed: !input.has_graph || input.compact; icon: input.color_icon; action: input.color_action; selected: input.color_open; width: 24; height: 24; classes: "ghost-tool"; }
            ToggleButton shape_btn { collapsed: !input.has_graph || input.compact; icon: input.shape_icon; action: input.shape_action; selected: input.shape_open; width: 24; height: 24; classes: "ghost-tool"; }
            ToggleButton info_btn { collapsed: !input.has_graph || input.compact; icon: input.info_icon; action: input.info_action; selected: input.info_open; width: 24; height: 24; classes: "ghost-tool"; }
            Column div_view { collapsed: !input.has_graph; width: 1; height: 15; classes: "viewport-option-divider"; }
            Button layout_btn { collapsed: !input.has_graph; icon: input.layout_icon; action: input.layout_action; width: 24; height: 24; classes: "ghost-tool"; }
            Button frame_btn { collapsed: !input.has_graph; icon: input.frame_icon; action: input.frame_action; width: 24; height: 24; classes: "ghost-tool"; }
            Button zoom_btn { collapsed: !input.has_graph; text: input.zoom_text; action: input.zoom_action; content_width: 34; height: 24; classes: "ghost-button"; }
            Column div_graph { collapsed: !input.has_graph; width: 1; height: 15; classes: "viewport-option-divider"; }
            ToggleButton settings { collapsed: !input.has_graph; icon: input.settings_icon; action: input.settings_action; selected: input.seed_selected; width: 24; height: 24; classes: "ghost-tool"; }
            Button remove { collapsed: !input.has_graph; icon: input.delete_icon; action: input.delete_action; width: 24; height: 24; classes: "ghost-tool"; }
        }
        Text empty_hint {
            text: "Select a Procedural Generator Entity in Scene Tree / 3D Viewport to view and edit its network live in World, open a .procgraph in Asset Browser, or click + Scratch Graph.";
            collapsed: input.has_graph; caption: true; classes: "empty-state";
        }
        Overlay body {
            expand_height: true; expand_width: true; collapsed: !input.has_graph;
            Overlay canvas {
                expand_height: true; expand_width: true; classes: "network-canvas";
            }
            Column tab_box {
                width: 244; out_of_flow: true; offset_x: input.tab_x; offset_y: input.tab_y;
                collapsed: !input.tab_open; panel: true; padding_left: 4; padding_right: 4; padding_top: 4; padding_bottom: 4; gap: 3;
                classes: "network-tab-popup";
                TextField search_field { edit: input.tab_query; context: input.tab_query; placeholder: "Search node types..."; height: 22; expand_width: true; }
                Column results { gap: 1; Repeat items { items: input.tab_items; } }
            }
        }
        Text status {
            text: input.status_text; collapsed: !input.has_graph; height: 21; padding_left: 6; padding_right: 6; caption: true; classes: "browser-status";
        }
    }
}
