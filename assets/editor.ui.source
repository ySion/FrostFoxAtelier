double choose(bool condition, double yes, double no) {
    if (condition) { return yes; }
    return no;
}
double shelf_expanded_height() { return 56.0d; }

ui Position(in bool matches, in EditBinding position) {
    state bool expanded = true;
    Text no_matches {
        text: "No matching parameters";
        classes: "empty-state";
        height: 26;
        collapsed: input.matches;
    }
    Foldout section {
        text: "Scene root content";
        classes: "section";
        selected: state.expanded;
        collapsed: !input.matches;
        on activate { state.expanded = event.checked; }
    }
    Column contents {
        gap: 7;
        classes: "parameter-inset";
        collapsed: !state.expanded || !input.matches;
        NumberRow position {
            text: "Position (m)";
            edit: input.position;
        }
    }
}

ui QueryRow(in TextEditBinding edit, in double label_width, in double gap, in bool caption) {
    Row row {
        single_line: true;
        align_center: true;
        gap: input.gap;
        Text label {
            text: "Filter";
            width: input.label_width;
            single_line: true;
            caption: input.caption;
            classes: "field-label";
        }
        TextField field { edit: input.edit; }
    }
}

ui ComponentRow(in Text title, in double icon) {
    Text row { text: input.title; icon: input.icon; single_line: true; }
}

ui Components(in Items<ComponentRow> rows) {
    Repeat items { items: input.rows; }
}

ui ActorRow(in Text title, in bool enabled, in bool selected, in double icon,
            in Key parent, in bool expanded, in Text style) {
    TreeItem row {
        text: input.title;
        enabled: input.enabled;
        selected: input.selected;
        icon: input.icon;
        tree_parent: input.parent;
        initially_expanded: input.expanded;
        classes: input.style;
    }
}

ui SceneTree(in Items<ActorRow> actors, in TextEditBinding filter,
             in bool world_selected, in bool world_expanded, in double world_icon) {
    Tree tree {
        expand_height: true;
        filter: input.filter;
        TreeItem world {
            text: "World";
            icon: input.world_icon;
            selected: input.world_selected;
            initially_expanded: input.world_expanded;
        }
        Repeat rows { items: input.actors; }
    }
    Column filter_area {
        padding_left: 4;
        padding_top: 2;
        padding_right: 3;
        padding_bottom: 2;
        QueryRow query { edit: input.filter; label_width: 36; gap: 6; caption: false; }
    }
}

ui ShelfTool(in Text title, in double icon, in ActionBinding action) {
    Button tool {
        text: input.title;
        icon: input.icon;
        action: input.action;
        classes: "shelf-tool";
        width: 64;
        expand_height: true;
    }
}

ui ToolShelf(in bool collapsed, in bool create_selected,
             in Items<ShelfTool> create_tools, in Items<ShelfTool> view_tools,
             in ActionBinding toggle, in ActionBinding create, in ActionBinding view,
             in double rail_width, in double closed_height, in double arrow_height,
             in double up_icon, in double down_icon) {
    Row shelf {
        classes: "tool-shelf";
        height: choose(input.collapsed, input.closed_height, shelf_expanded_height());
        ToggleButton stow {
            classes: "bar-stow";
            width: input.rail_width;
            expand_height: true;
            padding_bottom: choose(input.collapsed, 0.0d, shelf_expanded_height() - input.arrow_height);
            icon: choose(input.collapsed, input.down_icon, input.up_icon);
            selected: input.collapsed;
            action: input.toggle;
        }
        Column contents {
            expand_height: true;
            collapsed: input.collapsed;
            Row tabs {
                classes: "parameter-tabs shelf-tabs";
                content_height: 18;
                padding_bottom: 2.0d / 3.0d;
                wrap: true;
                ChoiceButton create {
                    text: "Create";
                    classes: "parameter-tab shelf-tab";
                    height: 17.0d + 1.0d / 3.0d;
                    selected: input.create_selected;
                    selection_group: node.tabs;
                    action: input.create;
                }
                ChoiceButton view {
                    text: "View";
                    classes: "parameter-tab joined shelf-tab";
                    height: 17.0d + 1.0d / 3.0d;
                    selected: !input.create_selected;
                    selection_group: node.tabs;
                    action: input.view;
                }
            }
            Column body {
                expand_height: true;
                padding_left: 2;
                padding_right: 2;
                padding_top: 1;
                padding_bottom: 1;
                Row create_tools {
                    expand_height: true;
                    collapsed: !input.create_selected;
                    Repeat buttons { items: input.create_tools; }
                }
                Row view_tools {
                    expand_height: true;
                    collapsed: input.create_selected;
                    Repeat view_buttons { items: input.view_tools; }
                }
            }
        }
    }
}

ui PanePath(in Text title, in ActionBinding back, in ActionBinding forward,
            in double back_icon, in double forward_icon, in double path_icon) {
    Row bar {
        classes: "path-bar";
        gap: 2;
        height: 40;
        padding_left: 4;
        padding_top: 4;
        padding_right: 6;
        padding_bottom: 4;
        Button back { icon: input.back_icon; action: input.back; width: 26; height: 28; classes: "path-navigation"; }
        Button forward { icon: input.forward_icon; action: input.forward; width: 26; height: 28; classes: "path-navigation"; }
        Combo path { text: input.title; icon: input.path_icon; expand_width: true; min_width: 32; height: 28; classes: "pane-path"; }
    }
}

ui ObjectHeader(in Text type_name, in TextEditBinding name) {
    Row row {
        classes: "object-header";
        gap: 6;
        align_center: true;
        padding_left: 6;
        padding_top: 3;
        padding_right: 6;
        padding_bottom: 3;
        Text type { text: input.type_name; content_width: 0; single_line: true; classes: "object-type"; }
        TextField name { edit: input.name; min_width: 32; classes: "object-name"; }
    }
}

ui PropertyPage(in Text title, in bool selected, in ActionBinding action, in Key group, in Text style) {
    ChoiceButton tab {
        text: input.title; height: 26; classes: input.style;
        selected: input.selected; selection_group: input.group; action: input.action;
    }
}

ui ViewportTools(in double display_icon, in double guides_icon, in bool display_open, in bool guides_open) {
    Row tools {
        content_width: 60;
        height: 28;
        gap: 2;
        Combo display { icon: input.display_icon; width: 28; height: 28; selected: input.display_open; classes: "icon-menu"; }
        Combo guides { icon: input.guides_icon; width: 28; height: 28; selected: input.guides_open; classes: "icon-menu"; }
    }
}

ui Parameters(in Text type_name, in TextEditBinding name,
              in ActionBinding back, in ActionBinding forward,
              in double back_icon, in double forward_icon, in double path_icon,
              in bool has_selection, in bool transform_selected, in Items<PropertyPage> property_pages,
              in Items<ComponentRow> components, in bool matches,
              in EditBinding position, in TextEditBinding filter, in bool components_empty, in Text component_empty) {
    Column pane {
        classes: "parameter-pane";
        panel: true;
        expand_height: true;
        PanePath path {
            title: "World";
            back: input.back; forward: input.forward;
            back_icon: input.back_icon; forward_icon: input.forward_icon; path_icon: input.path_icon;
        }
        ObjectHeader header { type_name: input.type_name; name: input.name; }
        Column search {
            classes: "parameter-search";
            collapsed: !input.has_selection;
            QueryRow query { edit: input.filter; label_width: 48; gap: 8; caption: true; }
        }
        Text no_selection {
            text: "Select an Actor to inspect its properties.";
            classes: "empty-state";
            caption: true;
            padding_left: 8;
            single_line: true;
            collapsed: input.has_selection;
        }
        Column pages {
            classes: "parameter-page";
            expand_height: true;
            collapsed: !input.has_selection;
            Row tabs {
                classes: "parameter-tabs";
                content_height: 26.0d + 2.0d / 3.0d;
                padding_bottom: 2.0d / 3.0d;
                wrap: true;
                Repeat choices { items: input.property_pages; }
            }
            List scroll {
                classes: "parameter-list";
                expand_height: true;
                gap: 7;
                padding_top: 7.333;
                padding_bottom: 8;
                Column components {
                    classes: "parameter-inset";
                    gap: 3;
                    collapsed: input.transform_selected;
                    Components rows { rows: input.components; }
                    Text empty { text: input.component_empty; classes: "empty-state"; single_line: true; caption: true; collapsed: !input.components_empty; }
                }
                Column transform {
                    gap: 7;
                    collapsed: !input.transform_selected;
                    Position position { matches: input.matches; position: input.position; }
                }
            }
        }
    }
}

ui AssetBrowserShell(in Items<ActorRow> directories, in TextEditBinding query,
                     in Text path, in Text status,
                     in ActionBinding back, in ActionBinding up, in ActionBinding clear,
                     in bool filter_selected, in double view_icon,
                     in double back_icon, in double up_icon, in double search_icon,
                     in double clear_icon, in double filter_icon, in double more_icon) {
    Row toolbar {
        classes: "browser-toolbar";
        gap: 2;
        wrap: false;
        padding_left: 4;
        padding_top: 3;
        padding_right: 4;
        padding_bottom: 3;
        Button back {
            icon: input.back_icon;
            action: input.back;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Button up {
            icon: input.up_icon;
            action: input.up;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Combo path {
            text: input.path;
            context: node.path;
            expand_width: true;
            min_width: 32;
            classes: "browser-path";
        }
        Row search_area {
            expand_width: true;
            min_width: 44;
            classes: "browser-search";
            Text search_icon {
                icon: input.search_icon;
                width: 18;
                height: 23;
                classes: "browser-search-icon";
            }
            TextField query {
                edit: input.query;
                min_width: 8;
                classes: "browser-search-input";
            }
            Button clear {
                icon: input.clear_icon;
                action: input.clear;
                width: 18;
                classes: "browser-tool browser-icon";
            }
        }
        Combo filter {
            icon: input.filter_icon;
            selected: input.filter_selected;
            context: node.filter;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Combo view {
            icon: input.view_icon;
            context: node.view;
            width: 23;
            classes: "browser-tool browser-icon";
        }
        Combo actions {
            icon: input.more_icon;
            context: node.actions;
            width: 23;
            classes: "browser-tool browser-icon";
        }
    }
    Row body {
        gap: 1;
        wrap: false;
        expand_height: true;
        Tree tree {
            classes: "browser-directories";
            shrink_width: 144;
            min_width: 96;
            expand_height: true;
            Repeat directories { items: input.directories; }
        }
        Column content {
            min_width: 64;
            expand_height: true;
        }
    }
    Text status {
        text: input.status;
        height: 18;
        padding_left: 5;
        padding_right: 5;
        caption: true;
        classes: "browser-status";
    }
}

ui AssetResults(in TableBinding model, in ActionBinding open, in Key context, in Text view, in Text empty) {
    Table results {
        model: input.model;
        action: input.open;
        context: input.context;
        view: input.view;
        empty_text: input.empty;
        row_height: 23;
        header_height: 25;
        tile_width: 90;
        tile_height: 66;
        item_gap: 2;
        classes: "asset-table";
        expand_height: true;
        min_width: 64;
        padding_left: 0;
    }
}
