// Parallel-safe read-only spatial queries over `[Port] const procedural.Spatial&` inputs.
// Worker threads traverse pre-projected 32-byte BVH buffers without touching Runtime.

[DESC = "表面空间查询（射线投射或最近点）命中结果。未命中时 hit 为 false，normal 默认为 +Y。"]
struct procedural.SurfaceHit {
    [DESC = "在 max_distance 范围内命中表面三角形时为 true。"]
    bool hit;
    [DESC = "命中距离（米）；未命中时为 0。"]
    float distance;
    [DESC = "命中的图局部空间三维坐标（米）。"]
    vector3 position;
    [DESC = "命中三角形的单位面法线；未命中时为 (0, 1, 0)。"]
    vector3 normal;
    [DESC = "命中的源多边形 primitive 索引。"]
    uint primitive;
};

[DESC = "折线空间最近点查询结果。未命中时 hit 为 false，tangent 默认为 +Z。"]
struct procedural.CurveSample {
    [DESC = "在 max_distance 范围内找到折线线段时为 true。"]
    bool hit;
    [DESC = "查询点到最近折线点的欧氏距离（米）。"]
    float distance;
    [DESC = "命中位置在所属折线上的归一化弧长参数 [0, 1]。"]
    float u;
    [DESC = "折线上的最近点三维坐标（米）。"]
    vector3 position;
    [DESC = "命中线段的有向单位切向；未命中时为 (0, 0, 1)。"]
    vector3 tangent;
    [DESC = "命中的折线 primitive 索引。"]
    uint primitive;
};

struct procedural.BvhEntry {
    double entry;
    uint node;
};

struct procedural.BvhStack4 {
    procedural.BvhEntry x;
    procedural.BvhEntry y;
    procedural.BvhEntry z;
    procedural.BvhEntry w;
};

struct procedural.BvhStack16 {
    procedural.BvhStack4 a;
    procedural.BvhStack4 b;
    procedural.BvhStack4 c;
    procedural.BvhStack4 d;
};

struct procedural.BvhStack64 {
    procedural.BvhStack16 s0;
    procedural.BvhStack16 s1;
    procedural.BvhStack16 s2;
    procedural.BvhStack16 s3;
    uint size;
};

void procedural.bvh_stack4_set(procedural.BvhStack4& s, uint k, procedural.BvhEntry value) {
    if (k == 0u) { s.x = value; }
    else if (k == 1u) { s.y = value; }
    else if (k == 2u) { s.z = value; }
    else { s.w = value; }
}

procedural.BvhEntry procedural.bvh_stack4_get(const procedural.BvhStack4& s, uint k) {
    if (k == 0u) { return s.x; }
    if (k == 1u) { return s.y; }
    if (k == 2u) { return s.z; }
    return s.w;
}

void procedural.bvh_stack16_set(procedural.BvhStack16& s, uint k, procedural.BvhEntry value) {
    const uint sub = k >> 2u;
    const uint lane = k & 3u;
    if (sub == 0u) { procedural.bvh_stack4_set(s.a, lane, value); }
    else if (sub == 1u) { procedural.bvh_stack4_set(s.b, lane, value); }
    else if (sub == 2u) { procedural.bvh_stack4_set(s.c, lane, value); }
    else { procedural.bvh_stack4_set(s.d, lane, value); }
}

procedural.BvhEntry procedural.bvh_stack16_get(const procedural.BvhStack16& s, uint k) {
    const uint sub = k >> 2u;
    const uint lane = k & 3u;
    if (sub == 0u) { return procedural.bvh_stack4_get(s.a, lane); }
    if (sub == 1u) { return procedural.bvh_stack4_get(s.b, lane); }
    if (sub == 2u) { return procedural.bvh_stack4_get(s.c, lane); }
    return procedural.bvh_stack4_get(s.d, lane);
}

void procedural.bvh_stack_push(procedural.BvhStack64& s, uint node, double entry) {
    if (s.size >= 64u) { return; }
    const uint idx = s.size;
    s.size += 1u;
    procedural.BvhEntry item;
    item.entry = entry;
    item.node = node;
    const uint bank = idx >> 4u;
    const uint rem = idx & 15u;
    if (bank == 0u) { procedural.bvh_stack16_set(s.s0, rem, item); }
    else if (bank == 1u) { procedural.bvh_stack16_set(s.s1, rem, item); }
    else if (bank == 2u) { procedural.bvh_stack16_set(s.s2, rem, item); }
    else { procedural.bvh_stack16_set(s.s3, rem, item); }
}

procedural.BvhEntry procedural.bvh_stack_pop(procedural.BvhStack64& s) {
    s.size -= 1u;
    const uint idx = s.size;
    const uint bank = idx >> 4u;
    const uint rem = idx & 15u;
    if (bank == 0u) { return procedural.bvh_stack16_get(s.s0, rem); }
    if (bank == 1u) { return procedural.bvh_stack16_get(s.s1, rem); }
    if (bank == 2u) { return procedural.bvh_stack16_get(s.s2, rem); }
    return procedural.bvh_stack16_get(s.s3, rem);
}

void procedural.bvh_push_ordered(procedural.BvhStack64& stack, uint left, double dl, double dr, double limit) {
    const uint right = left + 1u;
    if (dl <= limit && dr <= limit) {
        if (dl <= dr) {
            procedural.bvh_stack_push(stack, right, dr);
            procedural.bvh_stack_push(stack, left, dl);
        } else {
            procedural.bvh_stack_push(stack, left, dl);
            procedural.bvh_stack_push(stack, right, dr);
        }
    } else if (dl <= limit) {
        procedural.bvh_stack_push(stack, left, dl);
    } else if (dr <= limit) {
        procedural.bvh_stack_push(stack, right, dr);
    }
}

bool procedural.bvh_ray_slab(double o, double d, double inv_d, double lo, double hi, double& tmin, double& tmax) {
    if (d == 0.0d) {
        return o >= lo && o <= hi;
    }
    const double t0 = (lo - o) * inv_d;
    const double t1 = (hi - o) * inv_d;
    tmin = math.max(tmin, math.min(t0, t1));
    tmax = math.min(tmax, math.max(t0, t1));
    return tmin <= tmax;
}

double procedural.bvh_ray_box(vector3 bmin,
                              vector3 bmax,
                              vector3d origin,
                              vector3d dir,
                              vector3d inv_dir,
                              double max_dist) {
    double tmin = 0.0d;
    double tmax = max_dist;
    return (procedural.bvh_ray_slab(origin.x, dir.x, inv_dir.x, double(bmin.x), double(bmax.x), tmin, tmax) &&
            procedural.bvh_ray_slab(origin.y, dir.y, inv_dir.y, double(bmin.y), double(bmax.y), tmin, tmax) &&
            procedural.bvh_ray_slab(origin.z, dir.z, inv_dir.z, double(bmin.z), double(bmax.z), tmin, tmax))
               ? tmin
               : max_dist + math.max(max_dist, 1.0d);
}

double procedural.bvh_point_box_dist_sq(vector3 bmin, vector3 bmax, vector3d point) {
    return math.distance_squared(math.clamp(point, vector3d(bmin), vector3d(bmax)), point);
}

vector3d procedural.closest_point_on_triangle(vector3d p, vector3d a, vector3d b, vector3d c) {
    const vector3d ab = b - a;
    const vector3d ac = c - a;
    const vector3d ap = p - a;
    const double d1 = math.dot(ab, ap);
    const double d2 = math.dot(ac, ap);
    if (d1 <= 0.0d && d2 <= 0.0d) { return a; }

    const vector3d bp = p - b;
    const double d3 = math.dot(ab, bp);
    const double d4 = math.dot(ac, bp);
    if (d3 >= 0.0d && d4 <= d3) { return b; }

    const double vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0d && d1 >= 0.0d && d3 <= 0.0d) {
        return a + ab * (d1 / (d1 - d3));
    }

    const vector3d cp = p - c;
    const double d5 = math.dot(ab, cp);
    const double d6 = math.dot(ac, cp);
    if (d6 >= 0.0d && d5 <= d6) { return c; }

    const double vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0d && d2 >= 0.0d && d6 <= 0.0d) {
        return a + ac * (d2 / (d2 - d6));
    }

    const double va = d3 * d6 - d5 * d4;
    if (va <= 0.0d && (d4 - d3) >= 0.0d && (d5 - d6) >= 0.0d) {
        const double w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return b + (c - b) * w;
    }

    const double denom = 1.0d / (va + vb + vc);
    return a + ab * (vb * denom) + ac * (vc * denom);
}

[DESC = "在只读 procedural.Spatial 加速结构上沿 direction（内部自动归一化）投射双面射线，查找 [0, max_distance] 米内最近的表面交点；可安全用于 parallel_for。"]
procedural.SurfaceHit procedural.raycast_surface(const procedural.Spatial& spatial,
                                                 vector3 origin,
                                                 vector3 direction,
                                                 float max_distance) {
    procedural.SurfaceHit result;
    result.normal = vector3(0.0f, 1.0f, 0.0f);
    if (spatial.size() == 0 || !math.is_finite(origin) || !(max_distance >= 0.0f) || !math.is_finite(max_distance)) {
        return result;
    }
    const vector3d origin_d = vector3d(origin);
    const vector3d dir = math.normalize_or_zero(vector3d(direction));
    const uint root = spatial[0].u0;
    if (dir == vector3d() || root == 0) {
        return result;
    }

    const vector3d inv_dir = vector3d(dir.x != 0.0d ? 1.0d / dir.x : 0.0d,
                                      dir.y != 0.0d ? 1.0d / dir.y : 0.0d,
                                      dir.z != 0.0d ? 1.0d / dir.z : 0.0d);
    double best_dist = double(max_distance);
    const procedural.SpatialNode root_node = spatial[root];
    const double root_entry = procedural.bvh_ray_box(root_node.a, root_node.b, origin_d, dir, inv_dir, best_dist);
    if (root_entry > best_dist) {
        return result;
    }

    procedural.BvhStack64 stack;
    procedural.bvh_stack_push(stack, root, root_entry);
    while (stack.size > 0u) {
        const procedural.BvhEntry top = procedural.bvh_stack_pop(stack);
        if (top.entry > best_dist) {
            continue;
        }
        const procedural.SpatialNode node = spatial[top.node];
        if (node.u1 > 0u) {
            for (uint k = 0u; k < node.u1; k += 1u) {
                const uint base = node.u0 + k * 2u;
                const procedural.SpatialNode w0 = spatial[base];
                const procedural.SpatialNode w1 = spatial[base + 1u];
                const vector3d vertex = vector3d(w0.a);
                const vector3d e1 = vector3d(w0.b) - vertex;
                const vector3d e2 = vector3d(w1.a) - vertex;
                const vector3d h = math.cross(dir, e2);
                const double det = math.dot(e1, h);
                // Bound the angular error independently of triangle scale. Squared float inputs fit in double.
                if (det * det > 1e-28d * math.length_squared(e1) * math.length_squared(h)) {
                    const double inv_det = 1.0d / det;
                    const vector3d s = origin_d - vertex;
                    const double u = math.dot(s, h) * inv_det;
                    if (u >= -0.000001d && u <= 1.000001d) {
                        const vector3d q = math.cross(s, e1);
                        const double v = math.dot(dir, q) * inv_det;
                        if (v >= -0.000001d && (u + v) <= 1.000001d) {
                            const double t = math.dot(e2, q) * inv_det;
                            if (t >= 0.0d && t <= best_dist) {
                                best_dist = t;
                                result.hit = true;
                                result.distance = float(t);
                                result.position = vector3(origin_d + dir * t);
                                result.normal = w1.b;
                                result.primitive = w0.u0;
                            }
                        }
                    }
                }
            }
            continue;
        }
        const procedural.SpatialNode ln = spatial[node.u0];
        const procedural.SpatialNode rn = spatial[node.u0 + 1u];
        procedural.bvh_push_ordered(stack,
                                    node.u0,
                                    procedural.bvh_ray_box(ln.a, ln.b, origin_d, dir, inv_dir, best_dist),
                                    procedural.bvh_ray_box(rn.a, rn.b, origin_d, dir, inv_dir, best_dist),
                                    best_dist);
    }
    return result;
}

[DESC = "在只读 procedural.Spatial 加速结构上查询距离 point 不超过 max_distance 米的最近表面点与面法线；可安全用于 parallel_for。"]
procedural.SurfaceHit procedural.closest_surface_point(const procedural.Spatial& spatial,
                                                       vector3 point,
                                                       float max_distance) {
    procedural.SurfaceHit result;
    result.normal = vector3(0.0f, 1.0f, 0.0f);
    if (spatial.size() == 0 || !math.is_finite(point) || !(max_distance >= 0.0f) || !math.is_finite(max_distance)) {
        return result;
    }
    const uint root = spatial[0].u0;
    if (root == 0) {
        return result;
    }

    const vector3d point_d = vector3d(point);
    double best_dist_sq = double(max_distance) * double(max_distance);
    const procedural.SpatialNode root_node = spatial[root];
    const double root_d2 = procedural.bvh_point_box_dist_sq(root_node.a, root_node.b, point_d);
    if (root_d2 > best_dist_sq) {
        return result;
    }

    procedural.BvhStack64 stack;
    procedural.bvh_stack_push(stack, root, root_d2);
    while (stack.size > 0u) {
        const procedural.BvhEntry top = procedural.bvh_stack_pop(stack);
        if (top.entry > best_dist_sq) {
            continue;
        }
        const procedural.SpatialNode node = spatial[top.node];
        if (node.u1 > 0u) {
            for (uint k = 0u; k < node.u1; k += 1u) {
                const uint base = node.u0 + k * 2u;
                const procedural.SpatialNode w0 = spatial[base];
                const procedural.SpatialNode w1 = spatial[base + 1u];
                const vector3d q = procedural.closest_point_on_triangle(
                    point_d, vector3d(w0.a), vector3d(w0.b), vector3d(w1.a));
                const double d2 = math.distance_squared(q, point_d);
                if (d2 <= best_dist_sq) {
                    best_dist_sq = d2;
                    result.hit = true;
                    result.distance = float(math.sqrt(d2));
                    result.position = vector3(q);
                    result.normal = w1.b;
                    result.primitive = w0.u0;
                }
            }
            continue;
        }
        const procedural.SpatialNode ln = spatial[node.u0];
        const procedural.SpatialNode rn = spatial[node.u0 + 1u];
        procedural.bvh_push_ordered(stack,
                                    node.u0,
                                    procedural.bvh_point_box_dist_sq(ln.a, ln.b, point_d),
                                    procedural.bvh_point_box_dist_sq(rn.a, rn.b, point_d),
                                    best_dist_sq);
    }
    return result;
}

[DESC = "在只读 procedural.Spatial 加速结构上查询距离 point 不超过 max_distance 米的最近折线点、归一化弧长 u 与切向；可安全用于 parallel_for。"]
procedural.CurveSample procedural.closest_polyline(const procedural.Spatial& spatial,
                                                   vector3 point,
                                                   float max_distance) {
    procedural.CurveSample result;
    result.tangent = vector3(0.0f, 0.0f, 1.0f);
    if (spatial.size() == 0 || !math.is_finite(point) || !(max_distance >= 0.0f) || !math.is_finite(max_distance)) {
        return result;
    }
    const uint root = spatial[0].u1;
    if (root == 0) {
        return result;
    }

    const vector3d point_d = vector3d(point);
    double best_dist_sq = double(max_distance) * double(max_distance);
    const procedural.SpatialNode root_node = spatial[root];
    const double root_d2 = procedural.bvh_point_box_dist_sq(root_node.a, root_node.b, point_d);
    if (root_d2 > best_dist_sq) {
        return result;
    }

    procedural.BvhStack64 stack;
    procedural.bvh_stack_push(stack, root, root_d2);
    while (stack.size > 0u) {
        const procedural.BvhEntry top = procedural.bvh_stack_pop(stack);
        if (top.entry > best_dist_sq) {
            continue;
        }
        const procedural.SpatialNode node = spatial[top.node];
        if (node.u1 > 0u) {
            for (uint k = 0u; k < node.u1; k += 1u) {
                const uint base = node.u0 + k * 2u;
                const procedural.SpatialNode w0 = spatial[base];
                const procedural.SpatialNode w1 = spatial[base + 1u];
                const vector3d a = vector3d(w0.a);
                const vector3d ab = vector3d(w0.b) - a;
                const double denom = math.length_squared(ab);
                const double t = denom > 0.0d ? math.clamp(math.dot(point_d - a, ab) / denom, 0.0d, 1.0d) : 0.0d;
                const vector3d q = a + ab * t;
                const double d2 = math.distance_squared(q, point_d);
                if (d2 <= best_dist_sq) {
                    best_dist_sq = d2;
                    result.hit = true;
                    result.distance = float(math.sqrt(d2));
                    result.u = math.lerp(w1.b.x, w1.b.y, float(t));
                    result.position = vector3(q);
                    result.tangent = w1.a;
                    result.primitive = w0.u0;
                }
            }
            continue;
        }
        const procedural.SpatialNode ln = spatial[node.u0];
        const procedural.SpatialNode rn = spatial[node.u0 + 1u];
        procedural.bvh_push_ordered(stack,
                                    node.u0,
                                    procedural.bvh_point_box_dist_sq(ln.a, ln.b, point_d),
                                    procedural.bvh_point_box_dist_sq(rn.a, rn.b, point_d),
                                    best_dist_sq);
    }
    return result;
}
