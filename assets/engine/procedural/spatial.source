// Parallel-safe read-only spatial queries over `[Port] const procedural.Spatial&` inputs.
// Worker threads traverse pre-projected 32-byte BVH buffers without touching Runtime.

struct procedural.SurfaceHit {
    bool hit;
    float distance;
    vector3 position;
    vector3 normal;
    uint primitive;
};

struct procedural.CurveSample {
    bool hit;
    float distance;
    float u;
    vector3 position;
    vector3 tangent;
    uint primitive;
};

struct procedural.BvhStack4 {
    uint x;
    uint y;
    uint z;
    uint w;
};

struct procedural.BvhStack16 {
    procedural.BvhStack4 a;
    procedural.BvhStack4 b;
    procedural.BvhStack4 c;
    procedural.BvhStack4 d;
};

struct procedural.BvhStack64 {
    procedural.BvhStack16 s0;
    procedural.BvhStack16 s1;
    procedural.BvhStack16 s2;
    procedural.BvhStack16 s3;
    uint size;
};

void procedural.bvh_stack4_set(procedural.BvhStack4& s, uint k, uint value) {
    if (k == 0) { s.x = value; }
    else if (k == 1) { s.y = value; }
    else if (k == 2) { s.z = value; }
    else { s.w = value; }
}

uint procedural.bvh_stack4_get(const procedural.BvhStack4& s, uint k) {
    return k == 0 ? s.x : k == 1 ? s.y : k == 2 ? s.z : s.w;
}

void procedural.bvh_stack16_set(procedural.BvhStack16& s, uint k, uint value) {
    const uint sub = k >> 2;
    const uint lane = k & 3;
    if (sub == 0) { procedural.bvh_stack4_set(s.a, lane, value); }
    else if (sub == 1) { procedural.bvh_stack4_set(s.b, lane, value); }
    else if (sub == 2) { procedural.bvh_stack4_set(s.c, lane, value); }
    else { procedural.bvh_stack4_set(s.d, lane, value); }
}

uint procedural.bvh_stack16_get(const procedural.BvhStack16& s, uint k) {
    const uint sub = k >> 2;
    const uint lane = k & 3;
    return sub == 0 ? procedural.bvh_stack4_get(s.a, lane)
         : sub == 1 ? procedural.bvh_stack4_get(s.b, lane)
         : sub == 2 ? procedural.bvh_stack4_get(s.c, lane)
                    : procedural.bvh_stack4_get(s.d, lane);
}

void procedural.bvh_stack_push(procedural.BvhStack64& s, uint value) {
    if (s.size >= 64) { return; }
    const uint idx = s.size;
    s.size += 1;
    const uint bank = idx >> 4;
    const uint rem = idx & 15;
    if (bank == 0) { procedural.bvh_stack16_set(s.s0, rem, value); }
    else if (bank == 1) { procedural.bvh_stack16_set(s.s1, rem, value); }
    else if (bank == 2) { procedural.bvh_stack16_set(s.s2, rem, value); }
    else { procedural.bvh_stack16_set(s.s3, rem, value); }
}

uint procedural.bvh_stack_pop(procedural.BvhStack64& s) {
    s.size -= 1;
    const uint idx = s.size;
    const uint bank = idx >> 4;
    const uint rem = idx & 15;
    return bank == 0 ? procedural.bvh_stack16_get(s.s0, rem)
         : bank == 1 ? procedural.bvh_stack16_get(s.s1, rem)
         : bank == 2 ? procedural.bvh_stack16_get(s.s2, rem)
                     : procedural.bvh_stack16_get(s.s3, rem);
}

void procedural.bvh_push_ordered(procedural.BvhStack64& stack, uint left, float dl, float dr, float limit) {
    const uint right = left + 1;
    if (dl <= limit && dr <= limit) {
        procedural.bvh_stack_push(stack, dl <= dr ? right : left);
        procedural.bvh_stack_push(stack, dl <= dr ? left : right);
    } else if (dl <= limit) {
        procedural.bvh_stack_push(stack, left);
    } else if (dr <= limit) {
        procedural.bvh_stack_push(stack, right);
    }
}

bool procedural.bvh_ray_slab(float o, float d, float lo, float hi, float& tmin, float& tmax) {
    if (d == 0.0f) {
        return o >= lo && o <= hi;
    }
    const float inv = 1.0f / d;
    const float t0 = (lo - o) * inv;
    const float t1 = (hi - o) * inv;
    tmin = math.max(tmin, math.min(t0, t1));
    tmax = math.min(tmax, math.max(t0, t1));
    return tmin <= tmax;
}

float procedural.bvh_ray_box(vector3 bmin, vector3 bmax, vector3 origin, vector3 dir, float max_dist) {
    float tmin = 0.0f;
    float tmax = max_dist;
    return (procedural.bvh_ray_slab(origin.x, dir.x, bmin.x, bmax.x, tmin, tmax) &&
            procedural.bvh_ray_slab(origin.y, dir.y, bmin.y, bmax.y, tmin, tmax) &&
            procedural.bvh_ray_slab(origin.z, dir.z, bmin.z, bmax.z, tmin, tmax))
               ? tmin
               : max_dist + 1.0f;
}

float procedural.bvh_point_box_dist_sq(vector3 bmin, vector3 bmax, vector3 point) {
    const vector3 d = point - math.clamp(point, bmin, bmax);
    return math.dot(d, d);
}

vector3 procedural.closest_point_on_triangle(vector3 p, vector3 a, vector3 b, vector3 c) {
    const vector3 ab = b - a;
    const vector3 ac = c - a;
    const vector3 ap = p - a;
    const float d1 = math.dot(ab, ap);
    const float d2 = math.dot(ac, ap);
    if (d1 <= 0.0f && d2 <= 0.0f) { return a; }

    const vector3 bp = p - b;
    const float d3 = math.dot(ab, bp);
    const float d4 = math.dot(ac, bp);
    if (d3 >= 0.0f && d4 <= d3) { return b; }

    const float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0f && d1 >= 0.0f && d3 <= 0.0f) {
        return a + ab * (d1 / (d1 - d3));
    }

    const vector3 cp = p - c;
    const float d5 = math.dot(ab, cp);
    const float d6 = math.dot(ac, cp);
    if (d6 >= 0.0f && d5 <= d6) { return c; }

    const float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0f && d2 >= 0.0f && d6 <= 0.0f) {
        return a + ac * (d2 / (d2 - d6));
    }

    const float va = d3 * d6 - d5 * d4;
    if (va <= 0.0f && (d4 - d3) >= 0.0f && (d5 - d6) >= 0.0f) {
        const float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return b + (c - b) * w;
    }

    const float denom = 1.0f / (va + vb + vc);
    return a + ab * (vb * denom) + ac * (vc * denom);
}

procedural.SurfaceHit procedural.raycast_surface(const procedural.Spatial& spatial,
                                                 vector3 origin,
                                                 vector3 direction,
                                                 float max_distance) {
    procedural.SurfaceHit result;
    result.normal = vector3(0.0f, 1.0f, 0.0f);
    if (spatial.size() == 0 || !math.is_finite(origin) || !(max_distance >= 0.0f) || !math.is_finite(max_distance)) {
        return result;
    }
    const vector3 dir = math.normalize_or_zero(direction);
    const uint root = spatial[0].u0;
    if (dir == vector3() || root == 0) {
        return result;
    }

    float best_dist = max_distance;
    const procedural.SpatialNode root_node = spatial[root];
    if (procedural.bvh_ray_box(root_node.a, root_node.b, origin, dir, best_dist) > best_dist) {
        return result;
    }

    procedural.BvhStack64 stack;
    procedural.bvh_stack_push(stack, root);
    while (stack.size > 0) {
        const procedural.SpatialNode node = spatial[procedural.bvh_stack_pop(stack)];
        if (procedural.bvh_ray_box(node.a, node.b, origin, dir, best_dist) > best_dist) {
            continue;
        }
        if (node.u1 > 0) {
            for (uint k = 0; k < node.u1; k += 1) {
                const uint base = node.u0 + k * 2;
                const procedural.SpatialNode w0 = spatial[base];
                const procedural.SpatialNode w1 = spatial[base + 1];
                const vector3 e1 = w0.b - w0.a;
                const vector3 e2 = w1.a - w0.a;
                const vector3 h = math.cross(dir, e2);
                const float det = math.dot(e1, h);
                if (math.abs(det) > 0.00000001f) {
                    const float inv_det = 1.0f / det;
                    const vector3 s = origin - w0.a;
                    const float u = math.dot(s, h) * inv_det;
                    if (u >= -0.000001f && u <= 1.000001f) {
                        const vector3 q = math.cross(s, e1);
                        const float v = math.dot(dir, q) * inv_det;
                        if (v >= -0.000001f && (u + v) <= 1.000001f) {
                            const float t = math.dot(e2, q) * inv_det;
                            if (t >= 0.0f && t <= best_dist) {
                                best_dist = t;
                                result.hit = true;
                                result.distance = t;
                                result.position = origin + dir * t;
                                result.normal = w1.b;
                                result.primitive = w0.u0;
                            }
                        }
                    }
                }
            }
            continue;
        }
        const procedural.SpatialNode ln = spatial[node.u0];
        const procedural.SpatialNode rn = spatial[node.u0 + 1];
        procedural.bvh_push_ordered(stack,
                                    node.u0,
                                    procedural.bvh_ray_box(ln.a, ln.b, origin, dir, best_dist),
                                    procedural.bvh_ray_box(rn.a, rn.b, origin, dir, best_dist),
                                    best_dist);
    }
    return result;
}

procedural.SurfaceHit procedural.closest_surface_point(const procedural.Spatial& spatial,
                                                       vector3 point,
                                                       float max_distance) {
    procedural.SurfaceHit result;
    result.normal = vector3(0.0f, 1.0f, 0.0f);
    if (spatial.size() == 0 || !math.is_finite(point) || !(max_distance >= 0.0f) || !math.is_finite(max_distance)) {
        return result;
    }
    const uint root = spatial[0].u0;
    if (root == 0) {
        return result;
    }

    float best_dist_sq = max_distance * max_distance;
    const procedural.SpatialNode root_node = spatial[root];
    if (procedural.bvh_point_box_dist_sq(root_node.a, root_node.b, point) > best_dist_sq) {
        return result;
    }

    procedural.BvhStack64 stack;
    procedural.bvh_stack_push(stack, root);
    while (stack.size > 0) {
        const procedural.SpatialNode node = spatial[procedural.bvh_stack_pop(stack)];
        if (procedural.bvh_point_box_dist_sq(node.a, node.b, point) > best_dist_sq) {
            continue;
        }
        if (node.u1 > 0) {
            for (uint k = 0; k < node.u1; k += 1) {
                const uint base = node.u0 + k * 2;
                const procedural.SpatialNode w0 = spatial[base];
                const procedural.SpatialNode w1 = spatial[base + 1];
                const vector3 q = procedural.closest_point_on_triangle(point, w0.a, w0.b, w1.a);
                const vector3 diff = point - q;
                const float d2 = math.dot(diff, diff);
                if (d2 <= best_dist_sq) {
                    best_dist_sq = d2;
                    result.hit = true;
                    result.distance = math.sqrt(d2);
                    result.position = q;
                    result.normal = w1.b;
                    result.primitive = w0.u0;
                }
            }
            continue;
        }
        const procedural.SpatialNode ln = spatial[node.u0];
        const procedural.SpatialNode rn = spatial[node.u0 + 1];
        procedural.bvh_push_ordered(stack,
                                    node.u0,
                                    procedural.bvh_point_box_dist_sq(ln.a, ln.b, point),
                                    procedural.bvh_point_box_dist_sq(rn.a, rn.b, point),
                                    best_dist_sq);
    }
    return result;
}

procedural.CurveSample procedural.closest_polyline(const procedural.Spatial& spatial,
                                                   vector3 point,
                                                   float max_distance) {
    procedural.CurveSample result;
    result.tangent = vector3(0.0f, 0.0f, 1.0f);
    if (spatial.size() == 0 || !math.is_finite(point) || !(max_distance >= 0.0f) || !math.is_finite(max_distance)) {
        return result;
    }
    const uint root = spatial[0].u1;
    if (root == 0) {
        return result;
    }

    float best_dist_sq = max_distance * max_distance;
    const procedural.SpatialNode root_node = spatial[root];
    if (procedural.bvh_point_box_dist_sq(root_node.a, root_node.b, point) > best_dist_sq) {
        return result;
    }

    procedural.BvhStack64 stack;
    procedural.bvh_stack_push(stack, root);
    while (stack.size > 0) {
        const procedural.SpatialNode node = spatial[procedural.bvh_stack_pop(stack)];
        if (procedural.bvh_point_box_dist_sq(node.a, node.b, point) > best_dist_sq) {
            continue;
        }
        if (node.u1 > 0) {
            for (uint k = 0; k < node.u1; k += 1) {
                const uint base = node.u0 + k * 2;
                const procedural.SpatialNode w0 = spatial[base];
                const procedural.SpatialNode w1 = spatial[base + 1];
                const vector3 ab = w0.b - w0.a;
                const float denom = math.dot(ab, ab);
                const float t = denom > 0.0f ? math.clamp(math.dot(point - w0.a, ab) / denom, 0.0f, 1.0f) : 0.0f;
                const vector3 q = math.lerp(w0.a, w0.b, t);
                const vector3 diff = point - q;
                const float d2 = math.dot(diff, diff);
                if (d2 <= best_dist_sq) {
                    best_dist_sq = d2;
                    result.hit = true;
                    result.distance = math.sqrt(d2);
                    result.u = math.lerp(w1.b.x, w1.b.y, t);
                    result.position = q;
                    result.tangent = w1.a;
                    result.primitive = w0.u0;
                }
            }
            continue;
        }
        const procedural.SpatialNode ln = spatial[node.u0];
        const procedural.SpatialNode rn = spatial[node.u0 + 1];
        procedural.bvh_push_ordered(stack,
                                    node.u0,
                                    procedural.bvh_point_box_dist_sq(ln.a, ln.b, point),
                                    procedural.bvh_point_box_dist_sq(rn.a, rn.b, point),
                                    best_dist_sq);
    }
    return result;
}
