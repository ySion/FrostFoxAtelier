// Fixed integer hashes and uniform numbers for procedural nodes. Results are part of the
// generated content, so the algorithms never change silently. They are the ones in
// modules/engine/procedural/include/procedural/random.hpp, so Source and C++ nodes draw the same values: lowbias32 by
// Chris Wellons (public domain), combined as hash(a ^ hash(b)).

uint procedural.hash(uint value) {
    uint x = value;
    x = x ^ (x >> 16u);
    x = x * 0x7feb352du;
    x = x ^ (x >> 15u);
    x = x * 0x846ca68bu;
    x = x ^ (x >> 16u);
    return x;
}

uint procedural.hash2(uint a, uint b) {
    return procedural.hash(a ^ procedural.hash(b));
}

// Uniform in [0, 1) from the top 24 bits, exact in float.
float procedural.unit(uint x) {
    return float(x >> 8u) * 0.000000059604644775390625f;
}

// Uniform in [-1, 1) per component, from three successive hashes of x.
vector3 procedural.random_vector(uint x) {
    const uint a = procedural.hash(x);
    const uint b = procedural.hash(a);
    const uint c = procedural.hash(b);
    return vector3(procedural.unit(a), procedural.unit(b), procedural.unit(c)) * 2.0f - vector3(1.0f);
}
