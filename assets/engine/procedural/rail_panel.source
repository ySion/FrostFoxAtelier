void procedural.rail_panel_triangle(const Array<vector3>& p, Array<uint>& corners, Array<uint>& offsets,
                         Array<vector3>& normals, uint a, uint b, uint c) {
    const vector3 normal = math.normalize_or_zero(math.cross(p[b] - p[a], p[c] - p[a]));
    corners.add(a);
    corners.add(b);
    corners.add(c);
    offsets.add(corners.size());
    normals.add(normal);
    normals.add(normal);
    normals.add(normal);
}

void procedural.rail_panel_quad(const Array<vector3>& p, Array<uint>& corners, Array<uint>& offsets,
                     Array<vector3>& normals, uint a, uint b, uint c, uint d) {
    procedural.rail_panel_triangle(p, corners, offsets, normals, a, b, c);
    procedural.rail_panel_triangle(p, corners, offsets, normals, a, c, d);
}

[DESC = "将两条同向、逐站对应的有序边线连成板面，沿图局部负 Y 加厚并封边。适用于变坡屋面、桥面和引板。"]
class procedural.RailPanel : procedural.Node {
    [Label = "Vertical thickness (m)", Min = 0.01, Max = 0.2,
     DESC = "从上表面沿图局部负 Y 量取的竖直厚度，单位米，必须有限且大于零。"]
    float thickness = 0.09f;

    void process([In("P", Port = "rail_a", DESC = "沿前进方向的左边线。取点层 P，按点序输入至少两站。向 +X 布点时接 Z 较小的一列；两轨须同向、点数相同。")] const Array<vector3>& A,
                 [In("P", Port = "rail_b", DESC = "沿前进方向的右边线。取点层 P，向 +X 布点时接 Z 较大的一列。按相同点序与左边线逐站对应，两轨弧长可不同。")] const Array<vector3>& B,
                 [Port, DESC = "封闭三角网格。上表面连接两条边线，下表面沿负 Y 偏移 thickness 米，包含侧壁、两端端盖和顶点层法线 N。"] procedural.Geometry& panel) {
        const uint n = A.size();
        if (n != B.size() || n < 2) { fail("RailPanel requires two equally sized rails with at least two stations."); }
        // Each interval contributes 24 corners, and the two end caps contribute 12.
        if (n > 178956971) { fail("RailPanel exceeds the geometry corner limit."); }
        if (!(math.is_finite(self.thickness) && self.thickness > 0.0f)) { fail("RailPanel thickness must be finite and positive."); }
        const vector3 depth = vector3(0.0f, self.thickness, 0.0f);
        Array<vector3> p;
        Array<uint> corners;
        Array<uint> offsets;
        Array<vector3> normals;
        const uint faces = (n - 1) * 8 + 4;
        p.reserve(n * 4);
        corners.reserve(faces * 3);
        offsets.reserve(faces + 1);
        normals.reserve(faces * 3);
        offsets.add(uint(0));
        for (uint i = 0; i < n; i += 1) {
            const vector3 lower_a = A[i] - depth;
            const vector3 lower_b = B[i] - depth;
            if (!(math.is_finite(lower_a) && math.is_finite(lower_b))) { fail("RailPanel requires finite station positions."); }
            p.add(A[i]);
            p.add(B[i]);
            p.add(lower_a);
            p.add(lower_b);
            if (i > 0) {
                const uint a = (i - 1) * 4;
                const uint b = i * 4;
                if (!(math.cross(p[a + 1] - p[a], p[b + 1] - p[a]).y > 0.0f &&
                      math.cross(p[b + 1] - p[a], p[b] - p[a]).y > 0.0f)) {
                    fail("RailPanel rails cross, repeat a station or face down; check rail order.");
                }
                procedural.rail_panel_quad(p, corners, offsets, normals, a, a + 1, b + 1, b);
                procedural.rail_panel_quad(p, corners, offsets, normals, a + 2, b + 2, b + 3, a + 3);
                procedural.rail_panel_quad(p, corners, offsets, normals, a, b, b + 2, a + 2);
                procedural.rail_panel_quad(p, corners, offsets, normals, a + 1, a + 3, b + 3, b + 1);
            }
        }
        const uint end = (n - 1) * 4;
        procedural.rail_panel_quad(p, corners, offsets, normals, 0, 2, 3, 1);
        procedural.rail_panel_quad(p, corners, offsets, normals, end, end + 1, end + 3, end + 2);
        self.emit_polygons(p, corners, offsets, 0);
        self.set_vec3("N", procedural.Layer::vertex, normals, 0);
    }
}
