// Sets pscale on selected points to a random value in [minimum, maximum], seeded from the graph
// seed, the node's seed and the point's `id` (or the point index when `id` is absent). Unselected
// points keep an existing `pscale`, or default to unit scale (1.0) when `pscale` is newly created.
[DESC = "在指定区间内为选中点生成可复现的随机实例缩放 pscale；可用点组限制范围。"]
class procedural.RandomScale : procedural.Node {
    [Label = "Group", DESC = "只修改选中点；空名称表示全选。"]
    String group = "";
    [Min = 0.0, Max = 4.0, LockMin, Label = "Minimum", DESC = "pscale 的下限。"]
    float minimum = 0.5f;
    [Min = 0.0, Max = 4.0, LockMin, Label = "Maximum", DESC = "pscale 的上限。"]
    float maximum = 1.5f;
    [Label = "Seed", DESC = "与图的种子混合后得到本节点的随机种子。"]
    uint seed = 0;

    void process(const procedural.Context& context,
                 [In("pscale", Optional, DESC = "组外点保留原值；缺列时取 1。")] const Array<float>& prior_pscale,
                 [Out("pscale", DESC = "为选中的点写入 minimum 到 maximum 之间的均匀缩放。")] Array<float>& pscale,
                 [In("id", Optional, DESC = "混入随机种子；缺列时使用点序号。")] const Array<uint>& id,
                 [Group(From = "group")] const Array<bool>& selected) {
        const float low = self.minimum;
        const float high = self.maximum;
        if (!(math.is_finite(low) && math.is_finite(high))) {
            fail("RandomScale bounds must be finite.");
        }
        const uint node_seed = procedural.hash2(context.seed, self.seed);
        const uint n = pscale.size();
        const bool has_id = id.size() == n;
        const bool has_mask = selected.size() == n;
        const bool had_pscale = prior_pscale.size() == n;
        if (!has_mask && has_id) {
            parallel_for (uint i : n) {
                pscale[i] = math.lerp(low, high, procedural.unit(procedural.hash2(node_seed, id[i])));
            }
        } else if (!has_mask) {
            parallel_for (uint i : n) {
                pscale[i] = math.lerp(low, high, procedural.unit(procedural.hash2(node_seed, i)));
            }
        } else if (has_id) {
            parallel_for (uint i : n) {
                if (!selected[i]) {
                    if (!had_pscale) { pscale[i] = 1.0f; }
                    continue;
                }
                pscale[i] = math.lerp(low, high, procedural.unit(procedural.hash2(node_seed, id[i])));
            }
        } else {
            parallel_for (uint i : n) {
                if (!selected[i]) {
                    if (!had_pscale) { pscale[i] = 1.0f; }
                    continue;
                }
                pscale[i] = math.lerp(low, high, procedural.unit(procedural.hash2(node_seed, i)));
            }
        }
    }
}
