// Orientations as quaternions in the row-vector convention of math.rotation_matrix, where the
// rows of the rotation matrix are the images of the X, Y and Z axes.

// The rotation whose matrix rows are the orthonormal axes x, y and z (Shepperd's method: the
// largest of w, x, y, z is taken from the diagonal, the others from sums and differences).
quaternion procedural.frame_rotation(vector3 x, vector3 y, vector3 z) {
    const float trace = x.x + y.y + z.z;
    if (trace > 0.0f) {
        const float s = math.sqrt(trace + 1.0f) * 2.0f;
        return quaternion((y.z - z.y) / s, (z.x - x.z) / s, (x.y - y.x) / s, 0.25f * s);
    }
    if (x.x > y.y && x.x > z.z) {
        const float s = math.sqrt(1.0f + x.x - y.y - z.z) * 2.0f;
        return quaternion(0.25f * s, (x.y + y.x) / s, (z.x + x.z) / s, (y.z - z.y) / s);
    }
    if (y.y > z.z) {
        const float s = math.sqrt(1.0f + y.y - x.x - z.z) * 2.0f;
        return quaternion((x.y + y.x) / s, 0.25f * s, (y.z + z.y) / s, (z.x - x.z) / s);
    }
    const float s = math.sqrt(1.0f + z.z - x.x - y.y) * 2.0f;
    return quaternion((z.x + x.z) / s, (y.z + z.y) / s, 0.25f * s, (x.y - y.x) / s);
}

// The shortest rotation taking +Z to the unit vector z; half a turn about X when z is -Z.
quaternion procedural.shortest_arc(vector3 z) {
    const float w = 1.0f + z.z;
    if (w < 0.0000001f) {
        return quaternion(1.0f, 0.0f, 0.0f, 0.0f);
    }
    return math.normalize_or_zero(quaternion(-z.y, z.x, 0.0f, w));
}

// Shortest-arc unit rotation taking normalized `from` to normalized `to`.
// Non-finite inputs return NaN; a finite zero vector returns the identity rotation;
// opposite vectors rotate 180 degrees around a deterministic orthogonal axis (matching
// shortest_arc when `from` is +Z and `to` is -Z, and preserving +Z when flipping +Y to -Y).
quaternion procedural.rotation_between(vector3 from, vector3 to) {
    if (!math.is_finite(from) || !math.is_finite(to)) {
        const float invalid = math.length((from - from) + (to - to));
        return quaternion(invalid, invalid, invalid, 1.0f + invalid);
    }
    const vector3 a = math.normalize_or_zero(from);
    const vector3 b = math.normalize_or_zero(to);
    if (a == vector3() || b == vector3()) {
        return quaternion();
    }
    const float w = 1.0f + math.dot(a, b);
    if (w < 0.0000001f) {
        const vector3 ref = math.abs(a.y) < 0.9f ? vector3(0.0f, 1.0f, 0.0f) : vector3(1.0f, 0.0f, 0.0f);
        const vector3 ortho = math.normalize_or_zero(math.cross(ref, a));
        return quaternion(ortho.x, ortho.y, ortho.z, 0.0f);
    }
    const vector3 c = math.cross(a, b);
    return math.normalize_or_zero(quaternion(c.x, c.y, c.z, w));
}

// The orientation Copy to Points derives from a normal and an up vector: +Z along the normal and
// +Y toward up, or the shortest rotation from +Z to the normal when up is zero, parallel to it or
// not finite. A zero normal leaves the identity; a non-finite one gives a non-finite result.
quaternion procedural.align_to_normal(vector3 normal, vector3 up) {
    const vector3 z = math.normalize_or_zero(normal);
    if (z == vector3()) {
        const float invalid = math.length(normal - normal); // 0 when finite, NaN otherwise.
        return quaternion(invalid, invalid, invalid, 1.0f + invalid);
    }
    const vector3 x = math.normalize_or_zero(math.cross(up, z));
    if (x == vector3()) {
        return procedural.shortest_arc(z);
    }
    return procedural.frame_rotation(x, math.cross(z, x), z);
}

// Upright architectural/prop frame: local +Y strictly follows `up`, and local +Z follows the
// projection of `forward` onto the plane perpendicular to `up` (+X = +Y x +Z). When `forward`
// is zero, collinear with `up`, or non-finite, tilts +Y to `up` via shortest arc (returning
// exact identity when `up` is +Y). A zero finite `up` returns identity; non-finite `up` returns NaN.
quaternion procedural.align_to_up(vector3 up, vector3 forward) {
    const vector3 y = math.normalize_or_zero(up);
    if (y == vector3()) {
        const float invalid = math.length(up - up);
        return quaternion(invalid, invalid, invalid, 1.0f + invalid);
    }
    const vector3 f = math.normalize_or_zero(forward);
    const vector3 x = math.normalize_or_zero(math.cross(y, f));
    if (x == vector3()) {
        return procedural.rotation_between(vector3(0.0f, 1.0f, 0.0f), y);
    }
    return procedural.frame_rotation(x, y, math.cross(x, y));
}

// Quaternion from a caller-normalized unit axis and right-handed angle in radians
// (direct counterpart of C++ atelier::math::from_axis_angle).
quaternion procedural.unit_axis_angle(vector3 unit_axis, float radians) {
    const float half = radians * 0.5f;
    const vector3 xyz = unit_axis * math.sin(half);
    return quaternion(xyz.x, xyz.y, xyz.z, math.cos(half));
}

// Extrinsic X -> Y -> Z Euler rotation in degrees (q_z * q_y * q_x), matching
// procedural.Transform.rotate and C++ procedural::euler_to_quaternion.
quaternion procedural.euler_degrees(vector3 degrees) {
    const vector3d half = math.radians(vector3d(degrees)) * 0.5d;
    const vector3d s = math.sin(half);
    const vector3d c = math.cos(half);
    const quaterniond q = quaterniond(0.0d, 0.0d, s.z, c.z) *
                          quaterniond(0.0d, s.y, 0.0d, c.y) *
                          quaterniond(s.x, 0.0d, 0.0d, c.x);
    return quaternion(q);
}
