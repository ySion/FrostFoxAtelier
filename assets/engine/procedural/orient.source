// Orientations as quaternions in the row-vector convention of math.rotation_matrix, where the
// rows of the rotation matrix are the images of the X, Y and Z axes.

// The rotation whose matrix rows are the orthonormal axes x, y and z (Shepperd's method: the
// largest of w, x, y, z is taken from the diagonal, the others from sums and differences).
quaternion procedural.frame_rotation(vector3 x, vector3 y, vector3 z) {
    const float trace = x.x + y.y + z.z;
    if (trace > 0.0f) {
        const float s = math.sqrt(trace + 1.0f) * 2.0f;
        return quaternion((y.z - z.y) / s, (z.x - x.z) / s, (x.y - y.x) / s, 0.25f * s);
    }
    if (x.x > y.y && x.x > z.z) {
        const float s = math.sqrt(1.0f + x.x - y.y - z.z) * 2.0f;
        return quaternion(0.25f * s, (x.y + y.x) / s, (z.x + x.z) / s, (y.z - z.y) / s);
    }
    if (y.y > z.z) {
        const float s = math.sqrt(1.0f + y.y - x.x - z.z) * 2.0f;
        return quaternion((x.y + y.x) / s, 0.25f * s, (y.z + z.y) / s, (z.x - x.z) / s);
    }
    const float s = math.sqrt(1.0f + z.z - x.x - y.y) * 2.0f;
    return quaternion((z.x + x.z) / s, (y.z + z.y) / s, 0.25f * s, (x.y - y.x) / s);
}

// The shortest rotation taking +Z to the unit vector z; half a turn about X when z is -Z.
quaternion procedural.shortest_arc(vector3 z) {
    const float w = 1.0f + z.z;
    if (w < 0.0000001f) {
        return quaternion(1.0f, 0.0f, 0.0f, 0.0f);
    }
    return math.normalize_or_zero(quaternion(-z.y, z.x, 0.0f, w));
}

// The orientation Copy to Points derives from a normal and an up vector: +Z along the normal and
// +Y toward up, or the shortest rotation from +Z to the normal when up is zero, parallel to it or
// not finite. A zero normal leaves the identity; a non-finite one gives a non-finite result.
quaternion procedural.align_to_normal(vector3 normal, vector3 up) {
    const vector3 z = math.normalize_or_zero(normal);
    if (z == vector3()) {
        const float invalid = math.length(normal - normal); // 0 when finite, NaN otherwise.
        return quaternion(invalid, invalid, invalid, 1.0f + invalid);
    }
    const vector3 x = math.normalize_or_zero(math.cross(up, z));
    if (x == vector3()) {
        return procedural.shortest_arc(z);
    }
    return procedural.frame_rotation(x, math.cross(z, x), z);
}
