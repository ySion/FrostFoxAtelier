class procedural.Remap : procedural.Node {
    [RunOver, Label = "Run Over", DESC = "读取与写入属性所在的几何层。"]
    procedural.Layer layer = procedural.Layer::point;
    [Label = "Source Attribute", DESC = "读取的 float 属性列，同名读写仍读取旧输入。"]
    String source_attribute = "noise";
    [Label = "Attribute", DESC = "写入映射结果的 float 属性列。"]
    String attribute = "pscale";
    [Label = "Group", DESC = "只修改选中元素；空名称表示全选。"]
    String group = "";
    [Label = "Input Minimum", DESC = "输入区间首端，允许反向但不能两端相等。"]
    float input_min = 0.0f;
    [Label = "Input Maximum", DESC = "输入区间末端；区间外的值线性外推。"]
    float input_max = 1.0f;
    [Label = "Output Minimum", DESC = "输出区间首端，不夹值。"]
    float output_min = 0.0f;
    [Label = "Output Maximum", DESC = "输出区间末端，可等于首端以生成常量。"]
    float output_max = 1.0f;

    void process([In(From = "source_attribute")] const Array<float>& source,
                 [Out(From = "attribute")] Array<float>& values,
                 [Group(From = "group")] const Array<bool>& selected) {
        if (!(math.is_finite(self.input_min) && math.is_finite(self.input_max) &&
              math.is_finite(self.output_min) && math.is_finite(self.output_max) &&
              self.input_min != self.input_max)) {
            fail("Remap endpoints must be finite and input endpoints must differ.");
        }
        // Widen before subtraction: finite float endpoints may span more than FLT_MAX.
        const double low = double(self.input_min);
        const double high = double(self.input_max);
        const double output_low = double(self.output_min);
        const double output_high = double(self.output_max);
        const double input_span = high - low;
        const double output_span = output_high - output_low;
        const double limit = double(3.402823466385288598e38f);
        const uint n = values.size();
        if (source.size() != n) { return; }
        if (selected.size() != n) {
            parallel_for (uint i : n) {
                const double mapped = output_low + ((double(source[i]) - low) / input_span) * output_span;
                // Also rejects non-finite source values, including infinity * a zero output span.
                if (!(mapped >= -limit && mapped <= limit)) {
                    fail("Remap result must fit a finite float.");
                }
                values[i] = float(mapped);
            }
        } else {
            parallel_for (uint i : n) {
                if (!selected[i]) { continue; }
                const double mapped = output_low + ((double(source[i]) - low) / input_span) * output_span;
                if (!(mapped >= -limit && mapped <= limit)) {
                    fail("Remap result must fit a finite float.");
                }
                values[i] = float(mapped);
            }
        }
    }
}
