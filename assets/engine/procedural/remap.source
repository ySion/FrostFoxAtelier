// Wide-precision affine range map for finite distinct input bounds; shared by procedural.efit and Remap.
double procedural.efit_wide(float value, double in_min, double in_span, double out_min, double out_span) {
    return out_min + ((double(value) - in_min) / in_span) * out_span;
}

// Unclamped normalized position of `value` in [in_min, in_max] (supports reversed bounds).
// Returns NaN if any argument is non-finite, and 0.0f when finite bounds coincide (in_min == in_max).
[DESC = "计算 value 在 [in_min, in_max] 内的未夹值归一化比例（支持反向区间；in_min == in_max 时返回 0.0f；非有限参数返回 NaN）。"]
float procedural.unlerp(float value, float in_min, float in_max) {
    if (!(math.is_finite(value) && math.is_finite(in_min) && math.is_finite(in_max))) {
        return 0.0f / 0.0f;
    }
    if (in_min == in_max) {
        return 0.0f;
    }
    return float((double(value) - double(in_min)) / (double(in_max) - double(in_min)));
}

// Clamped affine remap (Houdini `fit`): clamps the normalized parameter to [0, 1] before
// interpolating [out_min, out_max] (supports reversed bounds; exact endpoints; NaN on non-finite args).
[DESC = "带夹值区间重映射（同 Houdini fit）：先将 [in_min, in_max] 的归一化参数夹取到 [0, 1]，再插值到 [out_min, out_max]（支持反向区间；in_min == in_max 返回 out_min；非有限参数返回 NaN）。"]
float procedural.fit(float value, float in_min, float in_max, float out_min, float out_max) {
    if (!(math.is_finite(value) && math.is_finite(in_min) && math.is_finite(in_max) &&
          math.is_finite(out_min) && math.is_finite(out_max))) {
        return 0.0f / 0.0f;
    }
    if (in_min == in_max) {
        return out_min;
    }
    const double t = (double(value) - double(in_min)) / (double(in_max) - double(in_min));
    const double tc = math.clamp(t, 0.0d, 1.0d);
    return float((1.0d - tc) * double(out_min) + tc * double(out_max));
}

// Clamped [0, 1] -> [out_min, out_max] remap (NaN on non-finite args; exact endpoints).
[DESC = "将 [0, 1] 夹取后线性映射到 [out_min, out_max]（两端精确对齐；非有限参数返回 NaN）。"]
float procedural.fit01(float value, float out_min, float out_max) {
    if (!(math.is_finite(value) && math.is_finite(out_min) && math.is_finite(out_max))) {
        return 0.0f / 0.0f;
    }
    const double tc = math.clamp(double(value), 0.0d, 1.0d);
    return float((1.0d - tc) * double(out_min) + tc * double(out_max));
}

// Unclamped affine remap (Houdini `efit`): extrapolates outside [in_min, in_max] using double
// intermediates; returns out_min when finite bounds coincide, and NaN on non-finite args.
[DESC = "不夹值仿射重映射（同 Houdini efit，对应 procedural.Remap 节点行为）：区间外继续线性外推；in_min == in_max 返回 out_min；非有限参数返回 NaN。"]
float procedural.efit(float value, float in_min, float in_max, float out_min, float out_max) {
    if (!(math.is_finite(value) && math.is_finite(in_min) && math.is_finite(in_max) &&
          math.is_finite(out_min) && math.is_finite(out_max))) {
        return 0.0f / 0.0f;
    }
    if (in_min == in_max) {
        return out_min;
    }
    const double low = double(in_min);
    const double out_low = double(out_min);
    return float(procedural.efit_wide(value, low, double(in_max) - low, out_low, double(out_max) - out_low));
}

[DESC = "将一个 float 属性从输入区间线性映射到输出区间，区间外继续外推。可指定写入列和选组。"]
class procedural.Remap : procedural.Node {
    [RunOver, Label = "Run Over", DESC = "读取与写入属性所在的几何层。"]
    procedural.Layer layer = procedural.Layer::point;
    [Label = "Source Attribute", DESC = "读取的 float 属性列，同名读写仍读取旧输入。"]
    String source_attribute = "noise";
    [Label = "Attribute", DESC = "写入映射结果的 float 属性列。"]
    String attribute = "pscale";
    [Label = "Group", DESC = "只修改选中元素；空名称表示全选。"]
    String group = "";
    [Label = "Input Minimum", DESC = "输入区间首端，允许反向但不能两端相等。"]
    float input_min = 0.0f;
    [Label = "Input Maximum", DESC = "输入区间末端；区间外的值线性外推。"]
    float input_max = 1.0f;
    [Label = "Output Minimum", DESC = "输出区间首端，不夹值。"]
    float output_min = 0.0f;
    [Label = "Output Maximum", DESC = "输出区间末端，可等于首端以生成常量。"]
    float output_max = 1.0f;

    void process([In(From = "source_attribute")] const Array<float>& source,
                 [Out(From = "attribute")] Array<float>& values,
                 [Group(From = "group")] const Array<bool>& selected) {
        if (!(math.is_finite(self.input_min) && math.is_finite(self.input_max) &&
              math.is_finite(self.output_min) && math.is_finite(self.output_max) &&
              self.input_min != self.input_max)) {
            fail("Remap endpoints must be finite and input endpoints must differ.");
        }
        // Widen before subtraction: finite float endpoints may span more than FLT_MAX.
        const double low = double(self.input_min);
        const double high = double(self.input_max);
        const double output_low = double(self.output_min);
        const double output_high = double(self.output_max);
        const double input_span = high - low;
        const double output_span = output_high - output_low;
        const double limit = double(3.402823466385288598e38f);
        const uint n = values.size();
        if (source.size() != n) { return; }
        if (selected.size() != n) {
            parallel_for (uint i : n) {
                const double mapped = procedural.efit_wide(source[i], low, input_span, output_low, output_span);
                // Also rejects non-finite source values, including infinity * a zero output span.
                if (!(mapped >= -limit && mapped <= limit)) {
                    fail("Remap result must fit a finite float.");
                }
                values[i] = float(mapped);
            }
        } else {
            parallel_for (uint i : n) {
                if (!selected[i]) { continue; }
                const double mapped = procedural.efit_wide(source[i], low, input_span, output_low, output_span);
                if (!(mapped >= -limit && mapped <= limit)) {
                    fail("Remap result must fit a finite float.");
                }
                values[i] = float(mapped);
            }
        }
    }
}
