@@ -0,0 +1,35 @@
+include(FetchContent)
+file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies-lock.json" _dense_dependencies)
+string(JSON _dense_url GET "${_dense_dependencies}" unordered_dense url)
+string(JSON _dense_sha GET "${_dense_dependencies}" unordered_dense sha256)
+string(JSON _dense_version GET "${_dense_dependencies}" unordered_dense version)
+set(ANKERL_ENABLE_MODULES OFF CACHE BOOL "" FORCE)
+set(ANKERL_ENABLE_EXAMPLE OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(atelier_unordered_dense
+    URL "${_dense_url}" URL_HASH "SHA256=${_dense_sha}"
+    DOWNLOAD_NAME "unordered_dense-v${_dense_version}.tar.gz"
+    DOWNLOAD_DIR "${PROJECT_SOURCE_DIR}/.tools/downloads" EXCLUDE_FROM_ALL SYSTEM)
+FetchContent_MakeAvailable(atelier_unordered_dense)
+find_package(Git REQUIRED)
+set(_dense_patch "${PROJECT_SOURCE_DIR}/third_party/unordered_dense/atelier.patch")
+set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_dense_patch}")
+file(SHA256 "${_dense_patch}" _dense_sha)
+set(_dense_stamp "${atelier_unordered_dense_SOURCE_DIR}/.atelier-patch-sha256")
+set(_dense_applied "")
+if(EXISTS "${_dense_stamp}")
+    file(READ "${_dense_stamp}" _dense_applied)
+endif()
+if(NOT _dense_applied STREQUAL _dense_sha)
+    set(_dense_header "${atelier_unordered_dense_SOURCE_DIR}/include/ankerl/unordered_dense.h")
+    set(_dense_original "${atelier_unordered_dense_SOURCE_DIR}/.atelier-upstream-unordered_dense.h")
+    if(EXISTS "${_dense_original}")
+        file(COPY_FILE "${_dense_original}" "${_dense_header}" ONLY_IF_DIFFERENT)
+    else()
+        file(COPY_FILE "${_dense_header}" "${_dense_original}")
+    endif()
+    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --unsafe-paths "--directory=${atelier_unordered_dense_SOURCE_DIR}" "${_dense_patch}"
+        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
+    file(WRITE "${_dense_stamp}" "${_dense_sha}")
+endif()
+configure_file("${atelier_unordered_dense_SOURCE_DIR}/LICENSE"
+    "${CMAKE_BINARY_DIR}/LICENSE.unordered_dense.txt" COPYONLY)
