diff --git a/modules/core/foundation/include/foundation/detail/small_hash_table.hpp b/modules/core/foundation/include/foundation/detail/small_hash_table.hpp
new file mode 100644
--- /dev/null
+++ b/modules/core/foundation/include/foundation/detail/small_hash_table.hpp
@@ -0,0 +1,146 @@
+#pragma once
+
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <tuple>
+#include <type_traits>
+#include <utility>
+
+namespace atelier::detail {
+
+// No separate mode field. Before the first index allocation only this adapter
+// searches/edits the dense values; reserve() builds the index in place.
+template <class Indexed>
+class SmallHashTable {
+    using Key = typename Indexed::key_type;
+
+    using Value = typename Indexed::value_type;
+
+    using Values = typename Indexed::value_container_type;
+
+    static constexpr bool is_set = std::is_same_v<Key, Value>;
+
+    static constexpr std::size_t scan_limit = 4;
+
+    static_assert(std::is_same_v<decltype(Indexed::m_group_mask), std::uint32_t> &&
+                  scan_limit <= sizeof(std::uint32_t));
+
+    using Pointer = std::conditional_t<is_set, const Value*, Value*>;
+
+    Indexed table_;
+
+    bool unindexed() const noexcept { return table_.m_max_bucket_capacity == 0; }
+
+    template <class Q>
+    std::uint32_t fingerprint(const Q& key) const noexcept {
+        return Indexed::fingerprint_word(table_.mixed_hash(key));
+    }
+
+    template <class Q>
+    const Value* scan(const Q& key, std::uint32_t word) const noexcept {
+        // The unused group mask holds four nonzero tags in dense value order.
+        // Set each byte's high bit iff its XOR with the query tag is zero.
+        const auto different = table_.m_group_mask ^ word;
+        constexpr std::uint32_t low_bits = 0x7f7f7f7f;
+        auto matches = ~(((different & low_bits) + low_bits) | different | low_bits);
+        while (matches) {
+            const auto* entry = table_.m_values.data() + std::countr_zero(matches) / 8;
+            if (table_.m_equal(key, Indexed::get_key(*entry)))
+                return entry;
+            matches &= matches - 1;
+        }
+        return nullptr;
+    }
+
+public:
+    SmallHashTable() = default;
+
+    SmallHashTable(const typename Indexed::hasher& hash, const typename Indexed::key_equal& equal) noexcept
+        : table_(0, hash, equal) {}
+
+    SmallHashTable empty_with_policies() const noexcept { return {table_.m_hash, table_.m_equal}; }
+
+    static constexpr std::size_t max_size() noexcept { return Indexed::max_size(); }
+
+    const Values& values() const noexcept { return table_.values(); }
+
+    Values& values() noexcept { return table_.m_values; }
+
+    std::size_t size() const noexcept { return table_.size(); }
+
+    void reserve(std::size_t total) noexcept {
+        if (total <= scan_limit && unindexed())
+            table_.m_values.reserve(total);
+        else
+            table_.reserve(total);
+    }
+
+    template <class Q>
+    const Value* find(const Q& key) const noexcept {
+        const auto hash = table_.mixed_hash(key);
+        if (unindexed())
+            return scan(key, Indexed::fingerprint_word(hash));
+        const auto slot = table_.probe(key, hash);
+        return slot.found ? table_.m_values.data() + slot.value_idx : nullptr;
+    }
+
+    template <class Q, class... Args>
+    std::pair<Pointer, bool> try_emplace(Q&& key, Args&&... args) {
+        if (unindexed()) {
+            const auto word = fingerprint(key);
+            if (const auto* found = scan(key, word))
+                return {const_cast<Pointer>(found), false};
+            auto& values = table_.m_values;
+            if constexpr (is_set)
+                values.emplace_back(std::forward<Q>(key));
+            else
+                values.emplace_back(std::piecewise_construct, std::forward_as_tuple(std::forward<Q>(key)),
+                                    std::forward_as_tuple(std::forward<Args>(args)...));
+            if (values.size() > scan_limit)
+                reserve(values.size());
+            else
+                table_.m_group_mask |= (word & 0xffu) << ((values.size() - 1) * 8);
+            return {std::addressof(values.back()), true};
+        }
+        if constexpr (is_set) {
+            auto [it, inserted] = table_.emplace(std::forward<Q>(key));
+            return {std::addressof(*it), inserted};
+        } else {
+            auto [it, inserted] = table_.try_emplace(std::forward<Q>(key), std::forward<Args>(args)...);
+            return {std::addressof(*it), inserted};
+        }
+    }
+
+    template <class Q>
+    bool erase(const Q& key) noexcept {
+        if (unindexed()) {
+            auto* found = const_cast<Value*>(scan(key, fingerprint(key)));
+            if (!found)
+                return false;
+            auto& values = table_.m_values;
+            const auto last_shift = (values.size() - 1) * 8;
+            const auto last_tag = table_.m_group_mask >> last_shift;
+            table_.m_group_mask &= ~(0xffu << last_shift);
+            if (found != std::addressof(values.back())) {
+                const auto shift = (found - values.data()) * 8;
+                table_.m_group_mask = (table_.m_group_mask & ~(0xffu << shift)) | (last_tag << shift);
+                *found = std::move(values.back());
+            }
+            values.pop_back();
+            return true;
+        }
+        return table_.erase(key) != 0;
+    }
+
+    void clear() noexcept {
+        if (unindexed())
+            table_.m_group_mask = 0;
+        table_.clear();
+    }
+
+    void swap(SmallHashTable& other) noexcept { table_.swap(other.table_); }
+};
+
+}
