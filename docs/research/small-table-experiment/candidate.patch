+// Both representations own the same kind of dense value buffer. Promotion hands
+// that buffer to the index, including the capacity reserved by the caller.
+template <class Indexed>
+class SmallHashTable {
+    using Key = typename Indexed::key_type;
+    using Value = typename Indexed::value_type;
+    using Values = typename Indexed::value_container_type;
+    static constexpr bool is_set = std::is_same_v<Key, Value>;
+    using Pointer = std::conditional_t<is_set, const Value*, Value*>;
+
+    static constexpr std::size_t scan_limit = 4;
+
+    struct Small {
+        Values values;
+        [[msvc::no_unique_address]] typename Indexed::hasher hash{};
+        [[msvc::no_unique_address]] typename Indexed::key_equal equal{};
+
+        template <class Q>
+        const Value* find(const Q& key) const noexcept {
+            const auto* end = values.data() + values.size();
+            for (auto* it = values.data(); it != end; ++it) {
+                if constexpr (is_set) {
+                    if (equal(key, *it))
+                        return it;
+                } else if (equal(key, it->first))
+                    return it;
+            }
+            return nullptr;
+        }
+    };
+
+    std::variant<Small, Indexed> state_;
+
+    Indexed& promote() noexcept {
+        Small small{std::move(std::get<Small>(state_))};
+        auto& indexed = state_.template emplace<Indexed>(0, small.hash, small.equal);
+        if (!small.values.empty())
+            indexed.replace(std::move(small.values));
+        return indexed;
+    }
+
+public:
+    static constexpr std::size_t max_size() noexcept { return Indexed::max_size(); }
+
+    const Values& values() const noexcept {
+        if (auto* small = std::get_if<Small>(&state_))
+            return small->values;
+        return std::get<Indexed>(state_).values();
+    }
+
+    std::size_t size() const noexcept { return values().size(); }
+
+    void reserve(std::size_t total) noexcept {
+        if (auto* small = std::get_if<Small>(&state_)) {
+            if (total <= scan_limit)
+                small->values.reserve(total);
+            else
+                promote().reserve(total);
+        } else
+            std::get<Indexed>(state_).reserve(total);
+    }
+
+    template <class Q>
+    const Value* find(const Q& key) const noexcept {
+        if (const auto* small = std::get_if<Small>(&state_))
+            return small->find(key);
+        const auto& indexed = std::get<Indexed>(state_);
+        const auto it = indexed.find(key);
+        return it == indexed.end() ? nullptr : std::addressof(*it);
+    }
+
+    template <class Q, class... Args>
+    std::pair<Pointer, bool> try_emplace(Q&& key, Args&&... args) {
+        if (auto* small = std::get_if<Small>(&state_)) {
+            if (auto* found = small->find(key))
+                return {const_cast<Pointer>(found), false};
+            if constexpr (is_set)
+                small->values.emplace_back(std::forward<Q>(key));
+            else
+                small->values.emplace_back(std::piecewise_construct, std::forward_as_tuple(std::forward<Q>(key)),
+                                           std::forward_as_tuple(std::forward<Args>(args)...));
+            auto* inserted = std::addressof(small->values.back());
+            if (small->values.size() > scan_limit)
+                promote();
+            return {inserted, true};
+        }
+        auto& indexed = std::get<Indexed>(state_);
+        if constexpr (is_set) {
+            const auto [it, inserted] = indexed.emplace(std::forward<Q>(key));
+            return {std::addressof(*it), inserted};
+        } else {
+            const auto [it, inserted] = indexed.try_emplace(std::forward<Q>(key), std::forward<Args>(args)...);
+            return {std::addressof(*it), inserted};
+        }
+    }
+
+    template <class Q>
+    bool erase(const Q& key) noexcept {
+        if (auto* small = std::get_if<Small>(&state_)) {
+            auto* found = const_cast<Value*>(small->find(key));
+            if (!found)
+                return false;
+            auto& last = small->values.back();
+            if (found != std::addressof(last))
+                *found = std::move(last);
+            small->values.pop_back();
+            return true;
+        }
+        return std::get<Indexed>(state_).erase(key) != 0;
+    }
+
+    void clear() noexcept {
+        if (auto* small = std::get_if<Small>(&state_))
+            small->values.clear();
+        else
+            std::get<Indexed>(state_).clear();
+    }
+
+    void swap(SmallHashTable& other) noexcept { state_.swap(other.state_); }
+};
+
+}
