void trace_queries() {
    PhysicsFixture f;
    p::BodySettings touch;touch.category=1;touch.responses[7]=p::Response::overlap;
    auto near_body=f.make({0,0,0},touch);
    p::BodySettings block;block.category=2;
    auto wall=f.make({0,0,3},block);auto behind=f.make({0,0,6},block);
    auto ignored_settings=block;ignored_settings.responses[7]=p::Response::ignore;
    auto ignored=f.make({0,0,9},ignored_settings);
    f.start();take(f.scene->update(0));
    p::TraceSettings query;query.channel=7;
    const Vector3 start{0,0,-3},end{0,0,12};
    p::QueryFilter legacy;legacy.category=7;
    const auto closest=take(f.scene->raycast(start,end,legacy));
    require(closest.hits.size()==1 && !closest.has_block,"Legacy closest query changed its blocking summary.");
    auto result=take(f.scene->trace(start,end,query));
    require(result.has_hit && result.has_block && result.hits.size()==1 && result.hits[0].body.actor==wall.id(),"Channel single did not skip touches and select the first block.");
    require(near(result.hits[0].distance,5.5f) && near(result.hits[0].point.z,2.5f) && near(result.hits[0].normal.z,-1),"Line trace distance, point or normal is incorrect.");
    query.mode=p::TraceMode::multi;result=take(f.scene->trace(start,end,query));
    require(result.hits.size()==2 && !result.hits[0].blocking && result.hits[1].body.actor==wall.id(),"Channel multi did not stop after the first block.");
    query.capacity=1;result=take(f.scene->trace(start,end,query));
    require(result.overflow && result.has_block && result.hits.size()==1 && !result.hits[0].blocking,"Truncation lost the full trace blocking summary.");
    query.capacity=64;query.mode=p::TraceMode::test;result=take(f.scene->trace(start,end,query));
    require(result.has_hit && result.has_block && result.hits.empty(),"Boolean trace retained payload or lost the blocking result.");
    const std::array ignored_actors{wall.id(),behind.id()};
    require(!take(f.scene->trace(start,end,query,{ignored_actors,{}})).has_hit,"Channel test accepted touches or ignored Actors.");
    const std::array ignored_components{wall.body.id(),behind.body.id()};
    require(!take(f.scene->trace(start,end,query,{{},ignored_components})).has_hit,"Ignored Component list was not applied.");
    query.mode=p::TraceMode::multi;query.selection=p::TraceSelection::object_type;query.object_types=1u<<2;
    result=take(f.scene->trace(start,end,query));
    require(result.hits.size()==3 && result.hits.back().body.actor==ignored.id(),"Object-type trace stopped at a block or consulted channel responses.");
    query.object_types=0;require(!take(f.scene->trace(start,end,query)).has_hit,"Empty object mask did not miss.");
    query.object_types=0xffff;query.shape=p::TraceShape::sphere_sweep;query.radius=.25f;query.mode=p::TraceMode::single;
    result=take(f.scene->trace(start,end,query));
    require(result.hits.size()==1 && near(result.hits[0].distance,2.25f,.002f) && near(result.hits[0].location.z,-.75f,.002f) &&
        near(result.hits[0].point.z,-.5f,.002f),"Sphere trace confused shape location with surface contact.");
    result=take(f.scene->trace({0,0,0},{0,0,2},query));
    require(result.hits.size()==1 && result.hits[0].initial_overlap && result.hits[0].distance==0 && result.hits[0].penetration_depth>0,"Initial sphere penetration was not reported.");
    query.shape=p::TraceShape::sphere_overlap;query.mode=p::TraceMode::multi;
    result=take(f.scene->trace({0,0,0},{},query));
    require(result.hits.size()==1 && result.hits[0].body.actor==near_body.id() && result.hits[0].location==Vector3{},"Sphere overlap lost its center or identity.");
    query.shape=p::TraceShape::line;
    require(!f.scene->trace({}, {},query),"Zero-length line trace was accepted.");
    const auto maximum=std::numeric_limits<float>::max();
    require(!f.scene->trace({maximum,0,0},{-maximum,0,0},query),"Overflowing finite endpoints reached Jolt.");
    query.channel=16;require(!f.scene->trace(start,end,query),"Out-of-range channel was accepted.");query.channel=7;
    query.capacity=0;require(!f.scene->trace(start,end,query),"Zero result capacity was accepted.");query.capacity=64;
    query.object_types=0x10000;require(!f.scene->trace(start,end,query),"Out-of-range object mask was accepted.");query.object_types=0xffff;
    query.mode=static_cast<p::TraceMode>(99);require(!f.scene->trace(start,end,query),"Unknown trace mode was accepted.");
    committed(f.world.stop());touch.sensor=true;touch.responses[7]=p::Response::block;take(p::configure(f.runtime,near_body.body.id(),touch));
    f.start();take(f.scene->update(0));query.mode=p::TraceMode::single;query.object_types=1u<<1;
    require(take(f.scene->trace(start,end,query)).has_hit,"Object trace excluded a requested Sensor.");
    query.include_sensors=false;require(!take(f.scene->trace(start,end,query)).has_hit,"Sensor exclusion was ignored.");
}

void query_components() {
    PhysicsFixture f;auto target=f.make({0,0,0});auto emitter=f.make({0,0,-3});
    auto parent=take(w::create_component(f.runtime,f.world_types.scene_component));
    auto query=take(w::create_component(f.runtime,f.physics_types.scene_query_component));
    committed(f.world.attach_components(emitter.id(),std::array{w::Attachment{parent.id(),emitter.root.id()},w::Attachment{query.id(),parent.id()}}));
    const auto edit=[&](auto callback) {take(f.runtime.with_native<p::SceneQueryComponent>(query.id(),[&](auto& value)->atelier::Result<void>{callback(value);return {};}));};
    const auto ready=[&] {return take(f.runtime.with_native<const p::SceneQueryComponent>(query.id(),[](const auto& value)->atelier::Result<bool>{return value.query_ready();}));};
    f.start();take(f.scene->update(0));require(!f.scene->read_query_result(query.id()) && !ready(),"Unsampled component reported a result.");
    auto snapshot=take(f.scene->execute_query(query.id()));
    require(snapshot.hits.front().body.actor==target.id() && near(snapshot.hits.front().distance,2.5f),"Component did not transform its ray or ignore its owner.");
    edit([](auto& q){q.ignore_self=false;});
    require(take(f.scene->execute_query(query.id())).hits.front().body.actor==emitter.id(),"Opting into self detection did not hit the emitter.");
    edit([](auto& q){q.ignore_self=true;});f.advance(1);
    require(take(f.scene->read_query_result(query.id())).step_id==1,"Automatic query did not stamp the completed fixed step.");
    f.scene->set_paused(true);take(f.scene->update(.1f));
    require(take(f.scene->read_query_result(query.id())).step_id==1,"Paused component query advanced.");
    edit([](auto& q){q.automatic=false;q.request_query();q.request_query();});f.scene->step_once();take(f.scene->update(0));
    require(take(f.scene->read_query_result(query.id())).step_id==2,"Coalesced request was not sampled on the next fixed step.");
    f.scene->step_once();take(f.scene->update(0));require(take(f.scene->read_query_result(query.id())).step_id==2,"One-shot request replayed.");
    edit([](auto& q){q.settings.capacity=0;});require(!f.scene->execute_query(query.id()) && !ready() && !f.scene->read_query_result(query.id()),"Failed query retained a stale success.");
    edit([](auto& q){q.settings.capacity=64;q.end={0,10,0};});
    require(!take(f.scene->execute_query(query.id())).has_hit && ready(),"Miss was not published as a completed empty result.");
    edit([](auto& q){q.end={0,0,10};});take(f.scene->execute_query(query.id()));
    committed(f.world.set_enabled(parent.id(),false));require(!ready() && !f.scene->read_query_result(query.id()),"Inactive ancestor retained a cached result.");
    take(f.scene->update(0));require(!f.scene->execute_query(query.id()),"Query executed under an inactive ancestor.");
    committed(f.world.set_enabled(parent.id(),true));take(f.scene->update(0));take(f.scene->execute_query(query.id()));
    auto removed=take(f.world.remove_component(query.id()));require(!ready() && !f.scene->read_query_result(query.id()),"Removed component retained query data.");
    committed(f.world.restore(removed));take(f.scene->update(0));take(f.scene->execute_query(query.id()));
    committed(f.world.set_enabled(target.body.id(),false));require(!f.scene->read_body_state(snapshot.hits.front().body),"Saved hit handle remained valid after body removal.");
    require(!take(f.scene->execute_query(query.id())).has_hit,"Removed target was still hittable.");
    w::World other{f.runtime,f.world_types};auto other_scene=take(p::PhysicsScene::create(other,f.physics_types));
    require(!other_scene->execute_query(query.id()) && !other_scene->read_query_result(query.id()),"Foreign scene exposed a component result.");
    committed(f.world.stop());require(!ready() && !f.scene->read_query_result(query.id()),"Stop retained component query state.");
    // A rotated child and a scaled ancestor use the actual World spatial chain.
    committed(f.world.set_enabled(target.body.id(),true));
    take(f.world.set_transform(emitter.root.id(),w::Trs{{-5,0,0},{0,0,0,1},{1,1,1}}));
    take(f.world.set_transform(parent.id(),w::Trs{{0,0,0},{0,.70710678f,0,.70710678f},{1,1,2}}));
    f.start();take(f.scene->update(0));auto transformed=take(f.scene->execute_query(query.id()));
    require(transformed.hits.front().body.actor==target.id() && near(transformed.start.x,-5) && near(transformed.end.x,15,.001f),"Nested rotation/scale was not applied to query endpoints.");
    committed(f.world.stop());
    // Stop also cancels a request made before this component's first reconcile.
    f.start();edit([](auto& q){q.request_query();});committed(f.world.stop());
    f.start();f.scene->set_paused(false);f.advance(1);
    require(!ready() && !f.scene->read_query_result(query.id()),"Unreconciled request survived deactivation and restart.");
    committed(f.world.stop());
}
