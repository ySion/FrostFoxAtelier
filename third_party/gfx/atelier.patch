+
+    GfxResult initKernelBuild(KernelBuild &build, GfxKernelBuildType type, GfxDrawState const &draw_state, char const *name, char const *entry_point)
+    {
+        DrawState const *gfx_draw_state = reinterpret_cast<DrawState *>(draw_state.handle);
+        if(!gfx_draw_state || !name || !entry_point)
+            return GFX_SET_ERROR(kGfxResult_InvalidParameter, "Cannot build a kernel without a draw state, name and entry point");
+        Kernel &kernel = build.kernel_;
+        switch(type)
+        {
+        case kGfxKernelBuildType_Compute:
+            kernel.type_ = Kernel::kType_Compute;
+            break;
+        case kGfxKernelBuildType_Graphics:
+            kernel.type_ = Kernel::kType_Graphics;
+            break;
+        case kGfxKernelBuildType_Mesh:
+            kernel.type_ = Kernel::kType_Mesh;
+            break;
+        default:
+            return GFX_SET_ERROR(kGfxResult_InvalidParameter, "Cannot build an unsupported kernel type");
+        }
+        build.gfx_ = this;
+        build.name_ = name;
+        kernel.entry_point_ = entry_point;
+        kernel.draw_state_ = gfx_draw_state->draw_state_;
+        kernel.owns_stages_ = true;
+        kernel.num_threads_ = (uint32_t *)gfxMalloc(3 * sizeof(uint32_t));
+        for(uint32_t i = 0; i < 3; ++i) kernel.num_threads_[i] = (kernel.isCompute() ? 1 : 0);
+        return kGfxResult_NoError;
+    }
+
+    static GfxResult setKernelBuildStage(KernelBuild &build, GfxShaderStage stage, IDxcBlob *bytecode, ID3D12ShaderReflection *reflection)
+    {
+        Kernel &kernel = build.kernel_;
+        IDxcBlob **target_bytecode = nullptr;
+        ID3D12ShaderReflection **target_reflection = nullptr;
+        switch(stage)
+        {
+        case kGfxShaderStage_CS: target_bytecode = &kernel.cs_bytecode_; target_reflection = &kernel.cs_reflection_; break;
+        case kGfxShaderStage_AS: target_bytecode = &kernel.as_bytecode_; target_reflection = &kernel.as_reflection_; break;
+        case kGfxShaderStage_MS: target_bytecode = &kernel.ms_bytecode_; target_reflection = &kernel.ms_reflection_; break;
+        case kGfxShaderStage_VS: target_bytecode = &kernel.vs_bytecode_; target_reflection = &kernel.vs_reflection_; break;
+        case kGfxShaderStage_GS: target_bytecode = &kernel.gs_bytecode_; target_reflection = &kernel.gs_reflection_; break;
+        case kGfxShaderStage_PS: target_bytecode = &kernel.ps_bytecode_; target_reflection = &kernel.ps_reflection_; break;
+        default: return kGfxResult_InvalidParameter;
+        }
+        if(!bytecode || !reflection || *target_bytecode || kernel.root_signature_) return kGfxResult_InvalidOperation;
+        bytecode->AddRef();
+        reflection->AddRef();
+        *target_bytecode = bytecode;
+        *target_reflection = reflection;
+        return kGfxResult_NoError;
+    }
+
+    GfxResult finishKernelBuild(KernelBuild &build)
+    {
+        if(build.kernel_.root_signature_ != nullptr) return kGfxResult_InvalidOperation;
+        return buildKernel(build.name_.c_str(), build.kernel_);
+    }
+
+    GfxKernel adoptKernelBuild(GfxProgram const &program, KernelBuild &build)
+    {
+        GfxKernel kernel = {};
+        if(build.gfx_ != this || !program_handles_.has_handle(program.handle) || build.kernel_.pipeline_state_ == nullptr)
+            return kernel;
+        kernel.type = (build.kernel_.isMesh() ? GfxKernel::kType_Mesh : build.kernel_.isCompute() ? GfxKernel::kType_Compute : GfxKernel::kType_Graphics);
+        GFX_SNPRINTF(kernel.name, sizeof(kernel.name), "%s", build.kernel_.entry_point_.c_str());
+        kernel.handle = kernel_handles_.allocate_handle();
+        Kernel &gfx_kernel = kernels_.insert(kernel);
+        gfx_kernel = std::move(build.kernel_);
+        gfx_kernel.program_ = program;
+        return kernel;
+    }
+
+    static void releaseKernelBuild(KernelBuild &build)
+    {
+        Kernel &kernel = build.kernel_;
+        gfxFree(kernel.num_threads_);
+        for(IDxcBlob *bytecode : {kernel.cs_bytecode_, kernel.as_bytecode_, kernel.ms_bytecode_, kernel.vs_bytecode_, kernel.gs_bytecode_, kernel.ps_bytecode_})
+            if(bytecode) bytecode->Release();
+        for(ID3D12ShaderReflection *reflection : {kernel.cs_reflection_, kernel.as_reflection_, kernel.ms_reflection_, kernel.vs_reflection_, kernel.gs_reflection_, kernel.ps_reflection_})
+            if(reflection) reflection->Release();
+        if(kernel.root_signature_) kernel.root_signature_->Release();
+        if(kernel.pipeline_state_) kernel.pipeline_state_->Release();
+        for(uint32_t i = 0; i < kernel.parameter_count_; ++i)
+        {
+            for(uint32_t j = 0; j < kernel.parameters_[i].variable_count_; ++j)
+                kernel.parameters_[i].variables_[j].~Variable();
+            gfxFree(kernel.parameters_[i].variables_);
+            kernel.parameters_[i].~Parameter();
+        }
+        gfxFree(kernel.parameters_);
     }

