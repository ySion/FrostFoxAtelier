if(NOT CMAKE_HOST_WIN32 OR "$ENV{ATELIER_LLVM_ROOT}" STREQUAL "")
    message(FATAL_ERROR "Run . ./tools/enter-dev.ps1 in a Windows PowerShell session first.")
endif()
file(TO_CMAKE_PATH "$ENV{ATELIER_LLVM_ROOT}" _atelier_llvm)
set(CMAKE_C_COMPILER "${_atelier_llvm}/bin/clang-cl.exe" CACHE FILEPATH "Pinned Clang")
set(CMAKE_CXX_COMPILER "${_atelier_llvm}/bin/clang-cl.exe" CACHE FILEPATH "Pinned Clang")
set(CMAKE_LINKER "${_atelier_llvm}/bin/lld-link.exe" CACHE FILEPATH "Pinned LLD")
set(CMAKE_AR "${_atelier_llvm}/bin/llvm-lib.exe" CACHE FILEPATH "Pinned librarian")
set(CMAKE_LINKER_TYPE LLD)
