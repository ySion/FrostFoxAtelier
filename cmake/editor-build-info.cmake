# Run at build time so switching commits does not leave a stale editor identity.
set(revision "unknown")
if(GIT_EXECUTABLE)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --verify HEAD
        RESULT_VARIABLE git_result OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(git_result EQUAL 0 AND commit MATCHES "^[0-9a-f]+$")
        set(revision "${commit}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=normal
            RESULT_VARIABLE git_result OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT git_result EQUAL 0)
            string(APPEND revision " + state unknown")
        elseif(NOT changes STREQUAL "")
            string(APPEND revision " + local changes")
        endif()
    endif()
endif()
set(content "#pragma once\nnamespace atelier::build_info {\ninline constexpr char revision[] = \"${revision}\";\ninline constexpr char configuration[] = \"${CONFIGURATION}\";\n}\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${OUTPUT}" "${content}")
