include_guard(GLOBAL)
include(FetchContent)
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies-lock.json" _json_lock)
string(JSON _yyjson_url GET "${_json_lock}" yyjson url)
string(JSON _yyjson_sha GET "${_json_lock}" yyjson sha256)
set(YYJSON_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(YYJSON_BUILD_MISC OFF CACHE BOOL "" FORCE)
set(YYJSON_BUILD_DOC OFF CACHE BOOL "" FORCE)
set(YYJSON_INSTALL OFF CACHE BOOL "" FORCE)
FetchContent_Declare(atelier_yyjson URL "${_yyjson_url}" URL_HASH "SHA256=${_yyjson_sha}"
    DOWNLOAD_DIR "${PROJECT_SOURCE_DIR}/.tools/downloads" EXCLUDE_FROM_ALL SYSTEM)
FetchContent_MakeAvailable(atelier_yyjson)
set_target_properties(yyjson PROPERTIES MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
configure_file("${atelier_yyjson_SOURCE_DIR}/LICENSE" "${CMAKE_BINARY_DIR}/LICENSE.yyjson.txt" COPYONLY)

add_library(atelier_core_json STATIC "${PROJECT_SOURCE_DIR}/modules/core/json/src/json.cpp")
atelier_target(atelier_core_json)
target_include_directories(atelier_core_json PUBLIC "${PROJECT_SOURCE_DIR}/modules/core/json/include")
target_link_libraries(atelier_core_json PUBLIC atelier_foundation_headers PRIVATE yyjson mimalloc)
